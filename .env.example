# Required — Resend API key for the contact form
RESEND_API_KEY=

# Optional — sender address on the Resend side.
# Must be from a verified domain in Resend. Defaults to onboarding@resend.dev
# (works only when the Resend account email matches CONTACT_TO_EMAIL).
CONTACT_FROM_EMAIL=

# Optional — where inbound messages are delivered.
# Defaults to mohittater.iiita@gmail.com if unset.
CONTACT_TO_EMAIL=

# Optional — PostHog analytics. Leave PUBLIC_POSTHOG_KEY empty to disable tracking.
# Find the project token (starts with "phc_") in PostHog → Settings → Project.
# PUBLIC_ prefix is required so Astro exposes it to the browser.
PUBLIC_POSTHOG_KEY=
# Region host. US default below; use https://eu.i.posthog.com for EU projects.
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# WebMCP takeaway storage. Local development defaults to the file driver.
# Preview and production must use the private Vercel Blob driver.
TAKEAWAY_STORAGE_DRIVER=file
BLOB_READ_WRITE_TOKEN=
# At least 32 random characters. Use a different value per environment.
TAKEAWAY_ID_SECRET=
# Optional override for the canonical URL returned after a save.
TAKEAWAY_BASE_URL=
