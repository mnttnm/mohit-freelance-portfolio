---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Load JetBrains Mono — only the pages that use --studio-mono need it. */
  mono?: boolean;
}

const {
  title,
  description = "Design Engineer and Product Partner. 10+ years building at the intersection of design, engineering, and product strategy.",
  ogImage = "/og-image.png",
  mono = false
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://mohittater.com');

// Only load the faces a page actually renders. DM Serif Display + Instrument
// Sans cover every page; JetBrains Mono is opt-in (projects, case studies).
const fontFamilies = [
  'family=DM+Serif+Display:ital@0;1',
  'family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500',
];
if (mono) fontFamilies.push('family=JetBrains+Mono:wght@400;500;600');
const fontHref = `https://fonts.googleapis.com/css2?${fontFamilies.join('&')}&display=swap`;
import '../styles/tokens.css';
import '../styles/global.css';
import AgentationWidget from '../components/dev/AgentationWidget';
import PostHog from '../components/PostHog.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content="@tatermohit" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <PostHog />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />
  </head>
  <body>
    <slot />

    <AgentationWidget client:only="react" />

    <script>
      // Engagement event tracking (section views, CTA + outbound clicks).
      import '../scripts/analytics';
    </script>

    <script>
      // Intersection Observer for reveal animations — respect reduced-motion.
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealEls = document.querySelectorAll('.reveal');

      if (prefersReduced) {
        revealEls.forEach((el) => el.classList.add('visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
              }
            });
          },
          {
            threshold: 0.1,
            rootMargin: '0px 0px -60px 0px',
          }
        );

        revealEls.forEach((el) => observer.observe(el));
      }

      // Smooth nav scroll
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', function (e) {
          const href = this.getAttribute('href');
          if (!href || href === '#') return;
          const target = document.querySelector(href);
          if (!target) return;
          e.preventDefault();
          const rect = target.getBoundingClientRect();
          const top = rect.top + window.scrollY;
          window.scrollTo({ top, behavior: 'smooth' });
          history.replaceState(null, '', href);
        });
      });
    </script>
  </body>
</html>
