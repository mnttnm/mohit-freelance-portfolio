---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  robots?: string;
  agentExperience?: boolean;
  /** Load JetBrains Mono — only the pages that use --studio-mono need it. */
  mono?: boolean;
}

const {
  title,
  description = "Design Engineer and Product Partner. 10+ years building at the intersection of design, engineering, and product strategy.",
  ogImage = "/og-image.png",
  robots = "index, follow",
  agentExperience = true,
  mono = false
} = Astro.props;
const siteOrigin = Astro.site ?? new URL('https://mohittater.in');
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
// og:image must be an absolute URL — relative paths break previews on
// LinkedIn, Slack, iMessage, etc.
const ogImageURL = new URL(ogImage, siteOrigin);

// Person / ProfilePage structured data — the machine-legible "who is this".
// Emitted site-wide so any crawler or agent lands on it. Values mirror the
// rendered HTML; no claims here that aren't on the page.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    '@id': 'https://mohittater.in/#mohit',
    name: 'Mohit Tater',
    alternateName: 'tatermohit',
    jobTitle: 'Design Engineer and Product Partner',
    description,
    url: 'https://mohittater.in/',
    image: new URL('/og-image.png', siteOrigin).href,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Bengaluru',
      addressRegion: 'Karnataka',
      addressCountry: 'IN',
    },
    knowsAbout: [
      'Product design', 'Frontend engineering', 'React', 'Next.js',
      'TypeScript', 'Astro', 'QA automation', 'AI workflows',
      'Design systems',
    ],
    sameAs: [
      'https://www.linkedin.com/in/tatermohit/',
      'https://twitter.com/tatermohit',
      'https://github.com/mnttnm',
      'https://mohit.stream',
    ],
    worksFor: { '@type': 'Organization', name: 'Independent (Freelance)' },
    potentialAction: {
      '@type': 'ReserveAction',
      name: 'Book a call with Mohit',
      target: 'https://cal.com/tatermohit/call-with-mohit-tater',
    },
  },
};

// Only load the faces a page actually renders. DM Serif Display + Instrument
// Sans cover every page; JetBrains Mono is opt-in (projects, case studies).
const fontFamilies = [
  'family=DM+Serif+Display:ital@0;1',
  'family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500',
];
if (mono) fontFamilies.push('family=JetBrains+Mono:wght@400;500;600');
const fontHref = `https://fonts.googleapis.com/css2?${fontFamilies.join('&')}&display=swap`;
import '../styles/tokens.css';
import '../styles/global.css';
import AgentationWidget from '../components/dev/AgentationWidget';
import AgentExperience from '../components/agent/AgentExperience';
import PostHog from '../components/PostHog.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Mohit Tater" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mohit Tater" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mohit Tater — Design Engineer and Product Partner" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content="Mohit Tater — Design Engineer and Product Partner" />
    <meta name="twitter:site" content="@tatermohit" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <PostHog />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />
  </head>
  <body data-webmcp-enabled={agentExperience ? "true" : "false"}>
    <slot />

    {agentExperience && <AgentExperience client:load />}
    <div class="dev-agentation-widget">
      <AgentationWidget client:only="react" />
    </div>

    <script>
      // Engagement event tracking (section views, CTA + outbound clicks).
      import '../scripts/analytics';
    </script>

    <script>
      // Progressive WebMCP registration. Unsupported browsers remain unchanged.
      import '../scripts/webmcp';
    </script>

    <script>
      // Intersection Observer for reveal animations — respect reduced-motion.
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealEls = document.querySelectorAll('.reveal');

      if (prefersReduced) {
        revealEls.forEach((el) => el.classList.add('visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
              }
            });
          },
          {
            threshold: 0.1,
            rootMargin: '0px 0px -60px 0px',
          }
        );

        revealEls.forEach((el) => observer.observe(el));
      }

      // Smooth nav scroll
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', function (e) {
          const href = this.getAttribute('href');
          if (!href || href === '#') return;
          const target = document.querySelector(href);
          if (!target) return;
          e.preventDefault();
          const rect = target.getBoundingClientRect();
          const top = rect.top + window.scrollY;
          window.scrollTo({ top, behavior: 'smooth' });
          history.replaceState(null, '', href);
        });
      });
    </script>
  </body>
</html>

<style is:global>
  @media print {
    .dev-agentation-widget,
    [data-agentation-root],
    [data-feedback-toolbar] {
      display: none !important;
    }
  }
</style>
