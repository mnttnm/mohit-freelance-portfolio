---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About — Mohit Tater">
  <div data-variation-content="studio">
    <!-- Header -->
    <header class="studio-header">
      <div class="studio-header-inner">
        <a href="/" class="studio-logo">Mohit Tater</a>
        <nav class="studio-nav">
          <a href="/#studio-services" class="studio-nav-link">Services</a>
          <a href="/projects" class="studio-nav-link">Work</a>
          <a href="/about" class="studio-nav-link studio-nav-link-active">About</a>
          <a
            href="https://cal.com/tatermohit/call-with-mohit-tater"
            class="studio-nav-link studio-nav-cta">Let's Talk</a
          >
        </nav>
        <button class="studio-menu-toggle" aria-label="Toggle menu">
          <span class="studio-menu-bar"></span>
          <span class="studio-menu-bar"></span>
        </button>
      </div>
    </header>

    <!-- About Content -->
    <section class="about-content">
      <div class="studio-container">
        <p class="studio-section-label studio-reveal">About</p>
        <h1 class="about-headline studio-reveal">Hey, I'm <em>Mohit.</em></h1>
        <p class="about-body studio-reveal">
          I've spent the last decade in tech — shipping products, designing interfaces, writing code, and figuring out what users actually need. These days I'm deep in the AI tooling world, constantly testing what's new and finding ways to make it useful. I help founders and businesses build better products, move faster with AI, and stop wasting time on things that should be automated. Based in Bengaluru, working with clients everywhere.
        </p>

        <div class="about-socials studio-reveal">
          <a href="https://www.linkedin.com/in/tatermohit/" class="about-social-link" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <span class="about-social-sep">/</span>
          <a href="https://twitter.com/tatermohit" class="about-social-link" target="_blank" rel="noopener noreferrer">X</a>
          <span class="about-social-sep">/</span>
          <a href="https://github.com/mnttnm" class="about-social-link" target="_blank" rel="noopener noreferrer">GitHub</a>
          <span class="about-social-sep">/</span>
          <a href="https://mohit.stream" class="about-social-link" target="_blank" rel="noopener noreferrer">mohit.stream</a>
        </div>

        <h4 class="about-subsection-heading studio-reveal">Experience</h4>
        <ul class="about-experience-list">
          <li class="studio-reveal">
            <strong>Freelance Consultant</strong>
            <span class="about-exp-detail">Product engineering & AI workflows for founders</span>
            <span class="about-exp-date">Dec 2023 &ndash; Present</span>
          </li>
          <li class="studio-reveal">
            <strong>UX Engineer, GoodCode</strong>
            <span class="about-exp-detail">Custom software & design studio for startups and enterprises</span>
            <span class="about-exp-date">Dec 2022 &ndash; Nov 2023</span>
          </li>
          <li class="studio-reveal">
            <strong>Senior Software Engineer, Query.ai</strong>
            <span class="about-exp-detail">Decentralized security investigations platform</span>
            <span class="about-exp-date">Sept 2020 &ndash; Nov 2022</span>
          </li>
          <li class="studio-reveal">
            <strong>Senior Software Developer, BlueJeans/Verizon</strong>
            <span class="about-exp-detail">Cloud-based video and web conferencing platform</span>
            <span class="about-exp-date">Nov 2016 &ndash; Sept 2020</span>
          </li>
        </ul>

        <h4 class="about-subsection-heading studio-reveal">Toolkit</h4>
        <div class="about-toolkit studio-reveal">
          <p>
            <strong>Design</strong> — Figma, Prototyping, User Research, Design Systems<br />
            <strong>Frontend</strong> — React, Next.js, TypeScript, Tailwind CSS, Astro<br />
            <strong>Backend & Infra</strong> — Node.js, Python, PostgreSQL, Supabase, Vercel<br />
            <strong>AI & Automation</strong> — Claude, OpenAI, Gemini, Codex, Manus, n8n, Zapier, Custom agents & workflows
          </p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="studio-cta">
      <div class="studio-container">
        <h2 class="studio-cta-headline studio-reveal">Got a project in mind?</h2>
        <p class="studio-cta-body studio-reveal">
          I'm taking on 1-2 new projects. No pitch decks needed — let's just
          talk about what you're building.
        </p>
        <div class="studio-cta-actions studio-reveal">
          <a
            href="https://cal.com/tatermohit/call-with-mohit-tater"
            class="studio-btn-primary">Book a call &rarr;</a
          >
          <a href="mailto:mohittater.iiita@gmail.com" class="studio-btn-text"
            >mohittater.iiita@gmail.com</a
          >
        </div>
        <div class="studio-social studio-reveal">
          <a href="https://twitter.com/tatermohit" class="studio-social-link" target="_blank" rel="noopener noreferrer">Twitter</a>
          <span class="studio-social-sep">/</span>
          <a href="https://www.linkedin.com/in/tatermohit/" class="studio-social-link" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <span class="studio-social-sep">/</span>
          <a href="https://github.com/mnttnm" class="studio-social-link" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="studio-footer">
      <div class="studio-container">
        <p class="studio-footer-text">
          &copy; 2026 Mohit Tater &middot; Bengaluru, India
        </p>
      </div>
    </footer>
  </div>
</Layout>

<style>
  /* ===== Studio Variation Palette (shared) ===== */
  [data-variation-content="studio"] {
    --studio-bg: #FAF8F5;
    --studio-bg-header: rgba(250, 248, 245, 0.95);
    --studio-text: #1A1A1A;
    --studio-text-body: #4A4A4A;
    --studio-text-muted: #8A8A8A;
    --studio-accent: #2D5A3D;
    --studio-accent-light: rgba(45, 90, 61, 0.08);
    --studio-border: #E5E0DA;
    --studio-serif: 'DM Serif Display', Georgia, serif;
    --studio-sans: 'Instrument Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  [data-variation-content="studio"] {
    background: var(--studio-bg);
    color: var(--studio-text);
    font-family: var(--studio-sans);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  /* ===== Container ===== */
  .studio-container {
    max-width: 920px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ===== Reveal Animation ===== */
  .studio-reveal {
    opacity: 0;
    transform: translateY(16px);
    animation: studioReveal 0.7s cubic-bezier(0.23, 1, 0.32, 1) forwards;
  }

  .studio-reveal:nth-child(1) { animation-delay: 0.05s; }
  .studio-reveal:nth-child(2) { animation-delay: 0.12s; }
  .studio-reveal:nth-child(3) { animation-delay: 0.19s; }
  .studio-reveal:nth-child(4) { animation-delay: 0.26s; }

  @keyframes studioReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ===== Section Label ===== */
  .studio-section-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--studio-text-muted);
    margin-bottom: 24px;
  }

  /* ===== Header ===== */
  .studio-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--studio-bg-header);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--studio-border);
  }

  .studio-header-inner {
    max-width: 920px;
    margin: 0 auto;
    padding: 0 24px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .studio-logo {
    font-family: var(--studio-serif);
    font-size: 1.15rem;
    color: var(--studio-text);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .studio-nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .studio-nav-link {
    font-size: 0.85rem;
    color: var(--studio-text-body);
    text-decoration: none;
    transition: color 0.2s;
  }

  .studio-nav-link:hover {
    color: var(--studio-text);
  }

  .studio-nav-link-active {
    color: var(--studio-text);
    font-weight: 600;
  }

  .studio-nav-cta {
    color: var(--studio-accent);
    font-weight: 600;
  }

  .studio-menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .studio-menu-bar {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--studio-text);
    transition: transform 0.3s;
  }

  /* ===== About Content ===== */
  .about-content {
    padding: 160px 0 120px;
  }

  .about-headline {
    font-family: var(--studio-serif);
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--studio-text);
    margin-bottom: 28px;
  }

  .about-headline em {
    font-style: italic;
    color: var(--studio-accent);
  }

  .about-body {
    font-size: 1.1rem;
    color: var(--studio-text-body);
    line-height: 1.8;
    max-width: 620px;
    margin-bottom: 32px;
  }

  .about-socials {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 56px;
  }

  .about-social-link {
    font-size: 0.88rem;
    color: var(--studio-text-body);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .about-social-link:hover {
    color: var(--studio-accent);
  }

  .about-social-sep {
    color: var(--studio-border);
    font-size: 0.85rem;
  }

  .about-subsection-heading {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--studio-text-muted);
    margin-bottom: 24px;
  }

  /* Experience */
  .about-experience-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .about-experience-list li {
    font-size: 0.92rem;
    color: var(--studio-text-body);
    padding: 14px 0;
    border-bottom: 1px solid var(--studio-border);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
  }

  .about-experience-list {
    margin-bottom: 56px;
  }

  .about-experience-list li strong {
    color: var(--studio-text);
    font-weight: 600;
  }

  .about-exp-detail {
    font-size: 0.82rem;
    color: var(--studio-text-muted);
    font-weight: 400;
  }

  .about-exp-date {
    font-size: 0.82rem;
    color: var(--studio-text-muted);
    white-space: nowrap;
    margin-left: auto;
  }

  /* Toolkit */
  .about-toolkit {
    font-size: 0.95rem;
    color: var(--studio-text-body);
    line-height: 1.9;
  }

  .about-toolkit strong {
    color: var(--studio-text);
    font-weight: 600;
  }

  /* ===== CTA ===== */
  .studio-cta {
    padding: 120px 0;
    border-top: 1px solid var(--studio-border);
    text-align: center;
  }

  .studio-cta-headline {
    font-family: var(--studio-serif);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--studio-text);
    margin-bottom: 16px;
    letter-spacing: -0.02em;
  }

  .studio-cta-body {
    font-size: 1.05rem;
    color: var(--studio-text-body);
    line-height: 1.7;
    max-width: 480px;
    margin: 0 auto 40px;
  }

  .studio-cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }

  .studio-btn-primary {
    display: inline-block;
    padding: 14px 32px;
    background: var(--studio-accent);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 6px;
    transition: background 0.25s, transform 0.2s;
  }

  .studio-btn-primary:hover {
    background: #234a31;
    transform: translateY(-1px);
  }

  .studio-btn-text {
    font-size: 0.9rem;
    color: var(--studio-text-body);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .studio-btn-text:hover {
    color: var(--studio-accent);
  }

  .studio-social {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .studio-social-link {
    font-size: 0.85rem;
    color: var(--studio-text-body);
    text-decoration: none;
    transition: color 0.2s;
  }

  .studio-social-link:hover {
    color: var(--studio-accent);
  }

  .studio-social-sep {
    color: var(--studio-border);
    font-size: 0.85rem;
  }

  /* ===== Footer ===== */
  .studio-footer {
    padding: 48px 0;
    text-align: center;
  }

  .studio-footer-text {
    font-size: 0.8rem;
    color: var(--studio-text-muted);
    letter-spacing: 0.02em;
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .studio-nav {
      display: none;
    }

    .studio-menu-toggle {
      display: flex;
    }

    .about-content {
      padding: 120px 0 80px;
    }

    .about-experience-list li {
      flex-direction: column;
      gap: 2px;
    }

    .studio-cta {
      padding: 80px 0;
    }

    .studio-cta-actions {
      flex-direction: column;
      gap: 16px;
    }
  }

  @media (max-width: 480px) {
    .about-content {
      padding: 100px 0 56px;
    }

    .about-headline {
      font-size: 2rem;
    }

    .studio-container {
      padding: 0 20px;
    }

    .studio-header-inner {
      padding: 0 20px;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const root = document.querySelector('[data-variation-content="studio"]');
    if (!root) return;

    const reveals = root.querySelectorAll(".studio-reveal");

    reveals.forEach((el) => {
      el.style.animationPlayState = "paused";
      el.style.opacity = "0";
      el.style.transform = "translateY(16px)";
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target;
            el.style.animationPlayState = "running";
            el.style.opacity = "";
            el.style.transform = "";
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
    );

    reveals.forEach((el) => observer.observe(el));

    // Mobile menu toggle
    const toggle = root.querySelector(".studio-menu-toggle");
    const nav = root.querySelector(".studio-nav");
    if (toggle && nav) {
      toggle.addEventListener("click", () => {
        const isOpen = nav.style.display === "flex";
        nav.style.display = isOpen ? "none" : "flex";
        nav.style.flexDirection = "column";
        nav.style.position = "absolute";
        nav.style.top = "64px";
        nav.style.left = "0";
        nav.style.right = "0";
        nav.style.background = "var(--studio-bg)";
        nav.style.padding = isOpen ? "0" : "24px";
        nav.style.borderBottom = isOpen
          ? "none"
          : "1px solid var(--studio-border)";
        nav.style.gap = "16px";
      });
    }
  });
</script>
