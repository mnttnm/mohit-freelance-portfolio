---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import WorkbenchHeader from '../components/WorkbenchHeader.astro';
import WorkbenchFooter from '../components/WorkbenchFooter.astro';

const experience = [
  {
    role: 'Freelance Consultant',
    detail: 'Product engineering and AI workflows for founders',
    period: 'Dec 2023 - Present',
  },
  {
    role: 'UX Engineer, GoodCode',
    detail: 'Custom software and design studio for startups and enterprises',
    period: 'Dec 2022 - Nov 2023',
  },
  {
    role: 'Senior Software Engineer, Query.ai',
    detail: 'Decentralized security investigations platform',
    period: 'Sept 2020 - Nov 2022',
  },
  {
    role: 'Senior Software Developer, BlueJeans/Verizon',
    detail: 'Cloud-based video and web conferencing platform',
    period: 'Nov 2016 - Sept 2020',
  },
];

const toolkit = [
  {
    title: 'Design',
    body: 'Figma, prototyping, user research, design systems',
  },
  {
    title: 'Frontend',
    body: 'React, Next.js, TypeScript, Tailwind CSS, Astro',
  },
  {
    title: 'Backend and infra',
    body: 'Node.js, Python, PostgreSQL, Supabase, Vercel',
  },
  {
    title: 'AI and automation',
    body: 'Claude, OpenAI, Gemini, Codex, Manus, n8n, Zapier, custom agents and workflows',
  },
];
---

<Layout title="About | Mohit Tater" description="A decade shipping products across design, engineering, and product strategy, from enterprise platforms to helping founders ship their first product.">
  <div data-variation-content="lab" class="lab-shell">
    <WorkbenchHeader active="about" />

    <main class="lab-page-main">
      <section class="lab-page-hero">
        <div class="lab-container lab-page-hero-grid">
          <div class="lab-reveal">
            <p class="lab-section-kicker">About</p>
            <h1 class="lab-page-title">Hey, I'm Mohit.</h1>
            <p class="lab-page-intro">
              I have spent the last decade shipping products, designing interfaces,
              writing code, and figuring out what users actually need.
            </p>
          </div>

          <aside class="lab-page-aside lab-reveal" aria-label="About summary">
            <dl>
              <div>
                <dt>Base</dt>
                <dd>Bengaluru</dd>
              </div>
              <div>
                <dt>Focus</dt>
                <dd>AI-native products</dd>
              </div>
              <div>
                <dt>Range</dt>
                <dd>Design to QA</dd>
              </div>
            </dl>
          </aside>
        </div>
      </section>

      <section class="lab-container lab-about-layout">
        <div class="lab-about-lede lab-reveal">
          <p class="lab-section-kicker">Working mode</p>
          <h2 class="lab-page-title">Design, code, and judgment in one loop.</h2>
          <p>
            These days I am deep in the AI tooling world, constantly testing what is new
            and finding ways to make it useful. I help founders and businesses build
            better products, move faster with AI, and stop wasting time on things that
            should be automated.
          </p>

          <div class="lab-social-strip">
            <a href="https://www.linkedin.com/in/tatermohit/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <a href="https://twitter.com/tatermohit" target="_blank" rel="noopener noreferrer">X</a>
            <a href="https://github.com/mnttnm" target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href="https://mohit.stream" target="_blank" rel="noopener noreferrer">mohit.stream</a>
          </div>
        </div>

        <div class="lab-about-stack">
          <section class="lab-timeline lab-reveal" aria-labelledby="experience-title">
            <h2 id="experience-title">Experience</h2>
            <ol>
              {experience.map((item) => (
                <li>
                  <strong>{item.role}</strong>
                  <span>{item.detail}</span>
                  <time>{item.period}</time>
                </li>
              ))}
            </ol>
          </section>

          <section class="lab-toolkit lab-reveal" aria-labelledby="toolkit-title">
            <h2 id="toolkit-title">Toolkit</h2>
            <div class="lab-toolkit-grid">
              {toolkit.map((group) => (
                <article class="lab-toolkit-group">
                  <h3>{group.title}</h3>
                  <p>{group.body}</p>
                </article>
              ))}
            </div>
          </section>
        </div>
      </section>
    </main>

    <WorkbenchFooter />
  </div>
</Layout>
