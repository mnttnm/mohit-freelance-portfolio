---
export const prerender = true;

import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import StudioFooter from "../components/StudioFooter.astro";
import portrait from "../assets/mohit-portrait.jpg";
---

<Layout title="About | Mohit Tater" description="A decade shipping products across design, engineering, and product strategy, from enterprise platforms to helping founders ship their first product.">
  <div data-variation-content="studio">
    <!-- Header -->
    <header class="studio-header" data-menu>
      <div class="studio-header-inner">
        <a href="/" class="studio-logo">Mohit Tater</a>
        <nav class="studio-nav" id="site-nav" data-menu-panel>
          <a href="/" class="studio-nav-link">Home</a>
          <a href="/projects" class="studio-nav-link">Work</a>
          <a href="/about" class="studio-nav-link studio-nav-link-active" aria-current="page">About</a>
          <a
            href="#studio-footer"
            class="studio-nav-link studio-nav-cta"
            data-ph-cta="lets_talk"
            data-ph-location="nav">Let's talk</a
          >
        </nav>
        <button class="studio-menu-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
          <span class="studio-menu-bar"></span>
          <span class="studio-menu-bar"></span>
        </button>
      </div>
    </header>

    <main id="main">
    <!-- About Content -->
    <section class="about-content" data-ph-section="about">
      <div class="studio-container">
        <div class="about-intro">
          <div class="about-intro-text">
            <h1 class="about-headline studio-reveal">Hey, I'm Mohit.</h1>
            <p class="about-body studio-reveal">
              I've spent the last decade in tech: shipping products, designing interfaces, writing code, and figuring out what users actually need. These days I'm deep in the AI tooling world, constantly testing what's new and finding ways to make it useful. I help founders and businesses build better products, move faster with AI, and stop wasting time on things that should be automated. Based in Bengaluru, working with clients everywhere.
            </p>

            <div class="about-socials studio-reveal">
              <a href="https://www.linkedin.com/in/tatermohit/" class="about-social-link" target="_blank" rel="noopener noreferrer">LinkedIn</a>
              <span class="about-social-sep">/</span>
              <a href="https://twitter.com/tatermohit" class="about-social-link" target="_blank" rel="noopener noreferrer">X</a>
              <span class="about-social-sep">/</span>
              <a href="https://github.com/mnttnm" class="about-social-link" target="_blank" rel="noopener noreferrer">GitHub</a>
              <span class="about-social-sep">/</span>
              <a href="https://mohit.stream" class="about-social-link" target="_blank" rel="noopener noreferrer">mohit.stream</a>
            </div>
          </div>

          <div class="about-portrait studio-reveal">
            <Image src={portrait} alt="Mohit Tater" width={720} class="about-portrait-img" />
          </div>
        </div>

        <h2 class="about-subsection-heading studio-reveal">Experience</h2>
        <ul class="about-experience-list">
          <li class="studio-reveal">
            <strong>Freelance Consultant</strong>
            <span class="about-exp-detail">Product engineering & AI workflows for founders</span>
            <span class="about-exp-date">Dec 2023 &ndash; Present</span>
          </li>
          <li class="studio-reveal">
            <strong>UX Engineer, GoodCode</strong>
            <span class="about-exp-detail">Custom software & design studio for startups and enterprises</span>
            <span class="about-exp-date">Dec 2022 &ndash; Nov 2023</span>
          </li>
          <li class="studio-reveal">
            <strong>Senior Software Engineer, Query.ai</strong>
            <span class="about-exp-detail">Decentralized security investigations platform</span>
            <span class="about-exp-date">Sept 2020 &ndash; Nov 2022</span>
          </li>
          <li class="studio-reveal">
            <strong>Senior Software Developer, BlueJeans/Verizon</strong>
            <span class="about-exp-detail">Cloud-based video and web conferencing platform</span>
            <span class="about-exp-date">Nov 2016 &ndash; Sept 2020</span>
          </li>
        </ul>

        <h2 class="about-subsection-heading studio-reveal">Toolkit</h2>
        <div class="about-toolkit studio-reveal">
          <p>
            <strong>Design:</strong> Figma, Prototyping, User Research, Design Systems<br />
            <strong>Frontend:</strong> React, Next.js, TypeScript, Tailwind CSS, Astro<br />
            <strong>Backend & Infra:</strong> Node.js, Python, PostgreSQL, Supabase, Vercel<br />
            <strong>AI & Automation:</strong> Claude, OpenAI, Gemini, Codex, Manus, n8n, Zapier, Custom agents & workflows
          </p>
        </div>
      </div>
    </section>
    </main>

    <StudioFooter />
  </div>
</Layout>

<style>
  /* Studio palette tokens now live in src/styles/tokens.css (--color-* / --studio-*). */

  [data-variation-content="studio"] {
    background: var(--studio-bg);
    color: var(--studio-text);
    font-family: var(--studio-sans);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  /* ===== Container ===== */
  .studio-container {
    max-width: var(--site-container-max);
    margin: 0 auto;
    padding: 0 var(--site-container-padding);
  }

  /* ===== Reveal Animation ===== */
  /* Only hide + animate when the visitor hasn't asked for reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .studio-reveal {
      opacity: 0;
      transform: translateY(16px);
      animation: studioReveal 0.7s var(--ease-out) forwards;
    }

    .studio-reveal:nth-child(1) { animation-delay: 0.05s; }
    .studio-reveal:nth-child(2) { animation-delay: 0.12s; }
    .studio-reveal:nth-child(3) { animation-delay: 0.19s; }
    .studio-reveal:nth-child(4) { animation-delay: 0.26s; }
  }

  @keyframes studioReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ===== Section Label ===== */
  .studio-section-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--studio-text-muted);
    margin-bottom: 24px;
  }

  /* ===== Header ===== */
  .studio-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--studio-bg-header);
    border-bottom: 1px solid var(--studio-border);
  }

  .studio-header-inner {
    max-width: var(--site-container-max);
    margin: 0 auto;
    padding: 0 var(--site-container-padding);
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .studio-logo {
    font-family: var(--studio-serif);
    font-weight: 700;
    font-size: var(--text-xl);
    color: var(--studio-text);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .studio-nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .studio-nav-link {
    font-size: var(--text-sm);
    color: var(--studio-text-body);
    text-decoration: none;
    transition: color 0.2s;
  }

  .studio-nav-link:hover {
    color: var(--studio-text);
  }

  .studio-nav-link-active {
    color: var(--studio-text);
    font-weight: 600;
  }

  .studio-nav-cta {
    color: var(--studio-accent);
    font-weight: 600;
  }

  .studio-menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .studio-menu-bar {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--studio-text);
    transition: transform 0.3s;
  }

  /* ===== About Content ===== */
  .about-content {
    padding: 160px 0 120px;
  }

  .about-headline {
    font-family: var(--studio-serif);
    font-weight: 800;
    font-size: var(--text-display-lg);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--studio-text);
    margin-bottom: 28px;
  }


  /* Intro: text + portrait side by side */
  .about-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(240px, 32%, 360px);
    gap: 56px;
    align-items: center;
    margin-bottom: 64px;
  }

  .about-intro-text {
    min-width: 0;
  }

  .about-portrait {
    position: relative;
  }

  .about-portrait-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius-xl);
    border: 1px solid var(--studio-border);
    box-shadow: 0 24px 48px -28px var(--ink-a40);
  }

  .about-body {
    font-size: var(--text-lg);
    color: var(--studio-text-body);
    line-height: 1.8;
    max-width: 620px;
    margin-bottom: 32px;
  }

  .about-socials {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 0;
  }

  .about-social-link {
    font-size: var(--text-md);
    color: var(--studio-text-body);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .about-social-link:hover {
    color: var(--studio-accent);
  }

  .about-social-sep {
    color: var(--studio-border);
    font-size: var(--text-sm);
  }

  /* Was an h4; now an h2 for a correct outline. Pin the box so the tag
     change can't pick up any heading defaults. */
  .about-subsection-heading {
    font-family: inherit;
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: inherit;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--studio-text-muted);
    margin: 0 0 24px;
  }

  /* Experience */
  .about-experience-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .about-experience-list li {
    font-size: var(--text-md);
    color: var(--studio-text-body);
    padding: 14px 0;
    border-bottom: 1px solid var(--studio-border);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
  }

  .about-experience-list {
    margin-bottom: 56px;
  }

  .about-experience-list li strong {
    color: var(--studio-text);
    font-weight: 600;
  }

  .about-exp-detail {
    font-size: var(--text-sm);
    color: var(--studio-text-muted);
    font-weight: 400;
  }

  .about-exp-date {
    font-size: var(--text-sm);
    color: var(--studio-text-muted);
    white-space: nowrap;
    margin-left: auto;
  }

  /* Toolkit */
  .about-toolkit {
    font-size: var(--text-md);
    color: var(--studio-text-body);
    line-height: 1.9;
    max-width: 760px;
  }

  .about-toolkit strong {
    color: var(--studio-text);
    font-weight: 600;
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .studio-nav {
      display: none;
    }

    .studio-menu-toggle {
      display: flex;
    }

    .about-content {
      padding: 120px 0 80px;
    }

    .about-intro {
      grid-template-columns: 1fr;
      gap: 28px;
      margin-bottom: 48px;
    }

    .about-portrait {
      order: -1;
      max-width: 260px;
    }

    .about-experience-list li {
      flex-direction: column;
      gap: 2px;
    }

  }

  @media (max-width: 480px) {
    .about-content {
      padding: 100px 0 56px;
    }

    .about-headline {
      font-size: var(--text-3xl);
    }

    .studio-container {
      padding: 0 var(--site-container-padding-mobile);
    }

    .studio-header-inner {
      padding: 0 var(--site-container-padding-mobile);
    }
  }
</style>

<script>
  import { initMobileMenu } from "../scripts/mobile-menu";
  document.addEventListener("DOMContentLoaded", () => {
    const root = document.querySelector('[data-variation-content="studio"]');
    if (!root) return;

    initMobileMenu(root.querySelector<HTMLElement>(".studio-header"));

    setupScrollReveal(root, 0.15);
  });

  // Scroll-triggered reveal. Skipped entirely for reduced motion (the CSS
  // doesn't hide anything then). A 4s safety net reveals whatever is still
  // hidden, so content can never stay invisible if the observer never fires.
  function setupScrollReveal(root: Element, threshold: number) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (!("IntersectionObserver" in window)) return;

    const reveals = Array.from(root.querySelectorAll<HTMLElement>(".studio-reveal"));
    const pending = new Set(reveals);
    let observerFired = false;

    const reveal = (el: HTMLElement) => {
      if (!pending.has(el)) return;
      pending.delete(el);
      el.style.animationPlayState = "running";
      el.style.opacity = "";
      el.style.transform = "";
      observer.unobserve(el);
    };

    reveals.forEach((el) => {
      el.style.animationPlayState = "paused";
      el.style.opacity = "0";
      el.style.transform = "translateY(16px)";
    });

    const observer = new IntersectionObserver(
      (entries) => {
        observerFired = true;
        entries.forEach((entry) => {
          if (entry.isIntersecting) reveal(entry.target as HTMLElement);
        });
      },
      { threshold, rootMargin: "0px 0px -40px 0px" },
    );

    reveals.forEach((el) => observer.observe(el));

    window.setTimeout(() => {
      // If the observer never reported, reveal everything; otherwise reveal
      // anything at or above the viewport the visitor has already passed.
      const viewportBottom = window.innerHeight;
      pending.forEach((el) => {
        if (!observerFired || el.getBoundingClientRect().top < viewportBottom) reveal(el);
      });
    }, 4000);
  }
</script>
