---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import StudioFooter from "../components/StudioFooter.astro";

const projects = [
  {
    id: "business-copilot",
    title: "Building a Business Co-Pilot with Claude Code",
    description:
      "An AI-powered business management system that handles daily planning, revenue tracking, and weekly reviews, built with Claude Code acting as an autonomous co-pilot across an Obsidian-based workspace.",
    tech: ["Claude Code", "Obsidian", "Markdown"],
    liveUrl:
      "https://medium.com/@tatermohit/i-built-a-business-co-pilot-using-claude-code-heres-the-exact-system-cfe32ee59558",
    liveLabel: "Read article",
    image: "/projects/business-copilot.png",
    type: "Article",
  },
  {
    id: "learning-log",
    title: "learning.log",
    description:
      "A capture-and-publish platform that turns quick notes into a public learning stream, with a Raycast-powered input pipeline, Redis-backed queue, and automated GitHub publishing.",
    tech: ["Astro", "Upstash Redis", "GitHub API", "Vercel", "Raycast"],
    liveUrl: "https://mohit.stream",
    liveLabel: "Live app",
    sourceUrl: "https://github.com/mnttnm/digital-garden",
    image: "/projects/learning-log.png",
    type: "Web App",
  },
  {
    id: "figma-variable-explorer",
    title: "Figma Variable Explorer",
    description:
      "Browse, inspect, and export Figma design variables in List, JSON, and CSS formats. Supports both design and development modes, making it easy to hand off tokens and keep design systems in sync.",
    tech: ["React", "Figma Plugin API"],
    liveUrl:
      "https://www.figma.com/community/plugin/1310888112326715990/figma-variable-explorer",
    liveLabel: "Open plugin",
    sourceUrl: "https://github.com/mnttnm/figma-variable-explorer",
    image: "/projects/figma-variable-explorer.png",
    type: "Figma Plugin",
    highlight: "8,000+ users",
  },
  {
    id: "career-guide",
    title: "Tech Career Guide for CS Students",
    description:
      "An interactive career exploration tool covering 45+ tech career paths with salary benchmarks, personality-based matching, and structured learning roadmaps, built for Indian CS students navigating their first career decisions.",
    tech: ["Next.js", "React", "Tailwind CSS", "Zustand", "Framer Motion"],
    liveUrl: "https://tech-career-guide.vercel.app/",
    liveLabel: "Live app",
    sourceUrl: "https://github.com/mnttnm/btech-cs-career-guide-india",
    image: "/projects/career-guide.png",
    type: "Web App",
  },
  {
    id: "notes-in-gdocs",
    title: "Notes in Google Docs",
    description:
      "Capture notes from anywhere on your Mac and store them directly in Google Docs. Create new documents, switch between them, and manage everything without leaving Raycast.",
    tech: ["Raycast", "Google Docs API"],
    liveUrl: "https://www.raycast.com/tatermohit/note-in-google-doc",
    liveLabel: "Install extension",
    sourceUrl: "https://github.com/mnttnm/raycast-note-in-doc",
    image: "/projects/notes-in-gdocs.png",
    type: "Raycast Extension",
    highlight: "1,000+ installs",
  },
  // {
  //   title: "GetItRight",
  //   description:
  //     "Marketing site for a UX audit and design consultancy — positioning the brand, communicating service offerings, and converting SaaS founders into consulting clients.",
  //   tech: ["Astro", "Vercel"],
  //   liveUrl: "https://getitright-mnttnms-projects.vercel.app/",
  //   sourceUrl: "https://github.com/mnttnm/getitright",
  //   image: "/projects/getitright.png",
  //   type: "Website",
  // },
  // {
  //   title: "Tab Triage",
  //   description:
  //     "A Chrome extension to quickly sort, close, and organize your browser tabs — triage your tab clutter in seconds.",
  //   tech: ["Chrome Extension API", "JavaScript"],
  //   liveUrl:
  //     "https://chromewebstore.google.com/detail/tab-triage/lldlagjikfofnnidnoegcmkolaibndof",
  //   image: "/projects/tab-triage.png",
  //   type: "Chrome Extension",
  // },
];

const projectTotalLabel = String(projects.length).padStart(2, "0");
---

<Layout title="Projects | Mohit Tater" description="Side projects, explorations, and open-source tools, from Figma plugins used by 8K+ designers to AI-powered business systems.">
  <div data-variation-content="studio">
    <!-- Header -->
    <header class="studio-header">
      <div class="studio-header-inner">
        <a href="/" class="studio-logo">Mohit Tater</a>
        <nav class="studio-nav">
          <a href="/projects" class="studio-nav-link studio-nav-link-active"
            >Work</a
          >
          <a href="/about" class="studio-nav-link">About</a>
          <a
            href="#studio-footer"
            class="studio-nav-link studio-nav-cta">Let's talk</a
          >
        </nav>
        <button class="studio-menu-toggle" aria-label="Toggle menu">
          <span class="studio-menu-bar"></span>
          <span class="studio-menu-bar"></span>
        </button>
      </div>
    </header>

    <!-- Page Hero -->
    <section class="projects-hero">
      <div class="studio-container">
        <p class="studio-section-label studio-reveal">Work</p>
        <h1 class="projects-headline studio-reveal">
          Things I've built <em>and shipped.</em>
        </h1>
        <p class="projects-subtext studio-reveal">
          Most of my client work is confidential. What you see here are side projects, explorations, and open-source tools I build in my own time. They reflect how I think and what I care about.
        </p>
      </div>
    </section>

    <!-- Selected Work Browser -->
    <section class="projects-browser-section" aria-labelledby="selected-work-heading">
      <div class="studio-container">
        <div class="work-browser studio-reveal" data-project-showcase>
          <div class="work-browser-topline">
            <p id="selected-work-heading" class="work-browser-kicker">
              Selected work
            </p>
            <div class="work-browser-count" aria-live="polite">
              <span data-project-current>01</span>
              <span class="work-browser-count-divider">/</span>
              <span>{projectTotalLabel}</span>
            </div>
          </div>

          <div class="work-browser-shell">
            <div class="work-visual-panel">
              <div class="work-visual-stage" aria-live="polite">
                {
                  projects.map((project, i) => (
                    <a
                      href={project.liveUrl}
                      target="_blank"
                      rel="noopener"
                      class={`work-visual ${i === 0 ? "is-active" : ""}`}
                      data-project-visual
                      data-project-index={i}
                      aria-label={`Open ${project.title}`}
                    >
                      <img
                        src={project.image}
                        alt={`Screenshot of ${project.title}`}
                        loading={i === 0 ? "eager" : "lazy"}
                      />
                    </a>
                  ))
                }
              </div>

              <div class="work-thumb-row" aria-label="Choose a project">
                {
                  projects.map((project, i) => (
                    <button
                      type="button"
                      class={`work-thumb ${i === 0 ? "is-active" : ""}`}
                      data-project-tab
                      data-project-index={i}
                      aria-pressed={i === 0 ? "true" : "false"}
                      aria-label={`Show ${project.title}`}
                    >
                      <span class="work-thumb-number">
                        {String(i + 1).padStart(2, "0")}
                      </span>
                      <span class="work-thumb-title">{project.title}</span>
                    </button>
                  ))
                }
              </div>
            </div>

            <div class="work-detail-panel">
              {
                projects.map((project, i) => (
                  <article
                    class={`work-project ${i === 0 ? "is-active" : ""}`}
                    data-project-detail
                    data-project-index={i}
                    aria-hidden={i === 0 ? "false" : "true"}
                  >
                    <div class="work-project-meta">
                      <span>{project.type}</span>
                      {project.highlight && (
                        <>
                          <span class="work-project-meta-separator">/</span>
                          <strong>{project.highlight}</strong>
                        </>
                      )}
                    </div>

                    <h2 class="work-project-title">{project.title}</h2>
                    <p class="work-project-description">
                      {project.description}
                    </p>

                    <div class="work-project-section">
                      <h3>Technology</h3>
                      <ul class="work-tech-list">
                        {project.tech.map((t) => (
                          <li>{t}</li>
                        ))}
                      </ul>
                    </div>

                    <div class="work-actions">
                      <a
                        href={project.liveUrl}
                        target="_blank"
                        rel="noopener"
                        class="work-action work-action-primary"
                      >
                        {project.liveLabel}
                        <span aria-hidden="true">&rarr;</span>
                      </a>
                      {project.sourceUrl && (
                        <a
                          href={project.sourceUrl}
                          target="_blank"
                          rel="noopener"
                          class="work-action"
                        >
                          GitHub
                          <span aria-hidden="true">&rarr;</span>
                        </a>
                      )}
                    </div>
                  </article>
                ))
              }

              <div class="work-controls" aria-label="Project navigation">
                <button type="button" class="work-control" data-project-prev aria-label="Previous project">
                  &larr;
                </button>
                <button type="button" class="work-control" data-project-next aria-label="Next project">
                  &rarr;
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <StudioFooter />
  </div>
</Layout>

<style>
  /* ===== Studio Variation Palette (shared) ===== */
  [data-variation-content="studio"] {
    --studio-bg: #faf8f5;
    --studio-bg-header: rgba(250, 248, 245, 0.95);
    --studio-text: #1a1a1a;
    --studio-text-body: #4a4a4a;
    --studio-text-muted: #8a8a8a;
    --studio-accent: #2d5a3d;
    --studio-accent-light: rgba(45, 90, 61, 0.08);
    --studio-border: #e5e0da;
    --studio-serif: "DM Serif Display", Georgia, serif;
    --studio-sans:
      "Instrument Sans", -apple-system, BlinkMacSystemFont, sans-serif;
  }

  [data-variation-content="studio"] {
    background: var(--studio-bg);
    color: var(--studio-text);
    font-family: var(--studio-sans);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  /* ===== Container ===== */
  .studio-container {
    max-width: var(--site-container-max);
    margin: 0 auto;
    padding: 0 var(--site-container-padding);
  }

  /* ===== Reveal Animation ===== */
  .studio-reveal {
    opacity: 0;
    transform: translateY(16px);
    animation: studioReveal 0.7s cubic-bezier(0.23, 1, 0.32, 1) forwards;
  }

  .studio-reveal:nth-child(1) {
    animation-delay: 0.05s;
  }
  .studio-reveal:nth-child(2) {
    animation-delay: 0.12s;
  }
  .studio-reveal:nth-child(3) {
    animation-delay: 0.19s;
  }
  .studio-reveal:nth-child(4) {
    animation-delay: 0.26s;
  }

  @keyframes studioReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ===== Section Label ===== */
  .studio-section-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--studio-text-muted);
    margin-bottom: 24px;
  }

  /* ===== Header ===== */
  .studio-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--studio-bg-header);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--studio-border);
  }

  .studio-header-inner {
    max-width: var(--site-container-max);
    margin: 0 auto;
    padding: 0 var(--site-container-padding);
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .studio-logo {
    font-family: var(--studio-serif);
    font-size: 1.15rem;
    color: var(--studio-text);
    text-decoration: none;
    letter-spacing: 0;
  }

  .studio-nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .studio-nav-link {
    font-size: 0.85rem;
    color: var(--studio-text-body);
    text-decoration: none;
    transition: color 0.2s;
  }

  .studio-nav-link:hover {
    color: var(--studio-text);
  }

  .studio-nav-link-active {
    color: var(--studio-text);
    font-weight: 600;
  }

  .studio-nav-cta {
    color: var(--studio-accent);
    font-weight: 600;
  }

  .studio-menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .studio-menu-bar {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--studio-text);
    transition: transform 0.3s;
  }

  /* ===== Projects Hero ===== */
  .projects-hero {
    padding: 144px 0 72px;
  }

  .projects-headline {
    font-family: var(--studio-serif);
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: 0;
    color: var(--studio-text);
    margin-bottom: 20px;
    max-width: 680px;
  }

  .projects-headline em {
    font-style: italic;
    color: var(--studio-accent);
  }

  .projects-subtext {
    font-size: 1.05rem;
    color: var(--studio-text-body);
    line-height: 1.7;
    max-width: 560px;
  }

  /* ===== Selected Work Browser ===== */
  .projects-browser-section {
    padding: 0 0 120px;
  }

  .work-browser {
    display: grid;
    gap: 18px;
  }

  .work-browser-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .work-browser-kicker {
    color: var(--studio-text-body);
    font-size: 0.92rem;
    font-weight: 600;
  }

  .work-browser-count {
    color: var(--studio-text-muted);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }

  .work-browser-count [data-project-current] {
    color: var(--studio-text);
    font-weight: 600;
  }

  .work-browser-count-divider {
    color: var(--studio-border);
    padding: 0 4px;
  }

  .work-browser-shell {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(320px, 0.88fr);
    min-height: 620px;
    overflow: hidden;
    background:
      radial-gradient(circle at 12% 10%, rgba(45, 90, 61, 0.08), transparent 30%),
      rgba(255, 255, 255, 0.55);
    border: 1px solid var(--studio-border);
    border-radius: 8px;
    box-shadow: 0 24px 70px rgba(30, 45, 36, 0.08);
  }

  .work-visual-panel {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 18px;
    padding: 38px;
    background: #eef1ed;
    border-right: 1px solid var(--studio-border);
  }

  .work-visual-stage {
    position: relative;
    min-height: 0;
    display: grid;
    place-items: center;
  }

  .work-visual {
    display: none;
    width: 100%;
    max-width: 720px;
    color: inherit;
    text-decoration: none;
    outline-offset: 8px;
  }

  .work-visual.is-active {
    display: block;
    animation: workImageReveal 0.45s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .work-visual img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid rgba(26, 26, 26, 0.1);
    border-radius: 6px;
    box-shadow: 0 22px 52px rgba(30, 45, 36, 0.18);
    transition: transform 0.35s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .work-visual:hover img {
    transform: translateY(-3px);
  }

  .work-thumb-row {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 8px;
  }

  .work-thumb {
    display: grid;
    gap: 6px;
    min-width: 0;
    padding: 10px;
    color: var(--studio-text-muted);
    background: rgba(250, 248, 245, 0.72);
    border: 1px solid rgba(26, 26, 26, 0.08);
    border-radius: 6px;
    font-family: var(--studio-sans);
    text-align: left;
    cursor: pointer;
    transition:
      background 0.2s,
      border-color 0.2s,
      color 0.2s,
      transform 0.2s;
  }

  .work-thumb:hover,
  .work-thumb.is-active {
    color: var(--studio-text);
    background: #fff;
    border-color: rgba(45, 90, 61, 0.32);
  }

  .work-thumb:active {
    transform: translateY(1px);
  }

  .work-thumb-number {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }

  .work-thumb-title {
    overflow: hidden;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .work-detail-panel {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: 64px 56px;
  }

  .work-project {
    display: none;
  }

  .work-project.is-active {
    display: block;
    animation: workCopyReveal 0.38s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .work-project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-bottom: 18px;
    color: var(--studio-text-muted);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .work-project-meta strong {
    color: var(--studio-accent);
    font: inherit;
  }

  .work-project-meta-separator {
    color: var(--studio-border);
  }

  .work-project-title {
    max-width: 460px;
    margin-bottom: 18px;
    color: var(--studio-text);
    font-family: var(--studio-serif);
    font-size: clamp(2rem, 4.1vw, 3.45rem);
    font-weight: 400;
    line-height: 0.98;
    text-wrap: balance;
  }

  .work-project-description {
    max-width: 470px;
    margin-bottom: 34px;
    color: var(--studio-text-body);
    font-size: 1rem;
    line-height: 1.75;
    text-wrap: pretty;
  }

  .work-project-section {
    margin-bottom: 34px;
  }

  .work-project-section h3 {
    margin-bottom: 12px;
    color: var(--studio-text);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .work-tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
  }

  .work-tech-list li {
    padding: 7px 10px;
    color: var(--studio-text-body);
    background: var(--studio-accent-light);
    border: 1px solid rgba(45, 90, 61, 0.13);
    border-radius: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1;
  }

  .work-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .work-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 12px 16px;
    color: var(--studio-text);
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid var(--studio-border);
    border-radius: 6px;
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition:
      background 0.2s,
      border-color 0.2s,
      color 0.2s,
      transform 0.2s;
  }

  .work-action:hover {
    color: var(--studio-accent);
    border-color: rgba(45, 90, 61, 0.35);
    transform: translateY(-1px);
  }

  .work-action:active {
    transform: translateY(0);
  }

  .work-action-primary {
    color: #fff;
    background: var(--studio-accent);
    border-color: var(--studio-accent);
  }

  .work-action-primary:hover {
    color: #fff;
    background: #234a31;
    border-color: #234a31;
  }

  .work-controls {
    position: absolute;
    right: 24px;
    bottom: 24px;
    display: flex;
    gap: 8px;
  }

  .work-control {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    color: var(--studio-text);
    background: #fff;
    border: 1px solid var(--studio-border);
    border-radius: 999px;
    cursor: pointer;
    font-family: var(--studio-sans);
    font-size: 1rem;
    transition:
      background 0.2s,
      border-color 0.2s,
      color 0.2s,
      transform 0.2s;
  }

  .work-control:hover {
    color: #fff;
    background: var(--studio-accent);
    border-color: var(--studio-accent);
  }

  .work-control:active {
    transform: translateY(1px);
  }

  .work-thumb:focus-visible,
  .work-control:focus-visible,
  .work-action:focus-visible,
  .work-visual:focus-visible {
    outline: 2px solid var(--studio-accent);
    outline-offset: 3px;
  }

  @keyframes workImageReveal {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes workCopyReveal {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ===== Responsive ===== */
  @media (max-width: 980px) {
    .work-browser-shell {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .work-visual-panel {
      min-height: 420px;
      padding: 28px;
      border-right: 0;
      border-bottom: 1px solid var(--studio-border);
    }

    .work-detail-panel {
      padding: 40px 32px 88px;
    }

    .work-project-title {
      max-width: 620px;
      font-size: clamp(2rem, 8vw, 3rem);
    }

    .work-project-description {
      max-width: 620px;
    }
  }

  @media (max-width: 768px) {
    .studio-nav {
      display: none;
    }

    .studio-menu-toggle {
      display: flex;
    }

    .projects-hero {
      padding: 120px 0 56px;
    }

    .projects-browser-section {
      padding: 0 0 80px;
    }

    .work-browser {
      gap: 14px;
    }

    .work-browser-topline {
      align-items: flex-start;
    }

    .work-visual-panel {
      min-height: 360px;
      padding: 18px;
    }

    .work-thumb-row {
      display: flex;
      gap: 8px;
      margin: 0 -18px;
      padding: 0 18px 2px;
      overflow-x: auto;
      scroll-snap-type: x proximity;
    }

    .work-thumb {
      min-width: 150px;
      scroll-snap-align: start;
    }

    .work-detail-panel {
      padding: 32px 24px 82px;
    }

    .work-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .work-action {
      width: 100%;
    }

    .work-controls {
      right: 24px;
      bottom: 24px;
    }
  }

  @media (max-width: 480px) {
    .projects-headline {
      font-size: 2rem;
    }

    .studio-container {
      padding: 0 var(--site-container-padding-mobile);
    }

    .studio-header-inner {
      padding: 0 var(--site-container-padding-mobile);
    }

    .work-browser-shell {
      border-radius: 8px;
    }

    .work-visual-panel {
      min-height: 300px;
      padding: 14px;
    }

    .work-thumb-row {
      margin: 0 -14px;
      padding: 0 14px 2px;
    }

    .work-detail-panel {
      padding: 28px 20px 78px;
    }

    .work-project-description {
      font-size: 0.95rem;
    }

    .work-tech-list li {
      font-size: 0.74rem;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const root = document.querySelector('[data-variation-content="studio"]');
    if (!root) return;

    const reveals = root.querySelectorAll(".studio-reveal");

    reveals.forEach((el) => {
      el.style.animationPlayState = "paused";
      el.style.opacity = "0";
      el.style.transform = "translateY(16px)";
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target;
            el.style.animationPlayState = "running";
            el.style.opacity = "";
            el.style.transform = "";
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
    );

    reveals.forEach((el) => observer.observe(el));

    const showcase = root.querySelector("[data-project-showcase]");
    if (showcase) {
      const visuals = Array.from(showcase.querySelectorAll("[data-project-visual]"));
      const details = Array.from(showcase.querySelectorAll("[data-project-detail]"));
      const tabs = Array.from(showcase.querySelectorAll("[data-project-tab]"));
      const current = showcase.querySelector("[data-project-current]");
      const previous = showcase.querySelector("[data-project-prev]");
      const next = showcase.querySelector("[data-project-next]");
      let activeIndex = 0;

      const updateProject = (nextIndex) => {
        activeIndex = (nextIndex + visuals.length) % visuals.length;
        const label = String(activeIndex + 1).padStart(2, "0");

        if (current) current.textContent = label;

        visuals.forEach((visual, index) => {
          visual.classList.toggle("is-active", index === activeIndex);
          visual.setAttribute("aria-hidden", index === activeIndex ? "false" : "true");
          visual.tabIndex = index === activeIndex ? 0 : -1;
        });

        details.forEach((detail, index) => {
          detail.classList.toggle("is-active", index === activeIndex);
          detail.setAttribute("aria-hidden", index === activeIndex ? "false" : "true");
        });

        tabs.forEach((tab, index) => {
          tab.classList.toggle("is-active", index === activeIndex);
          tab.setAttribute("aria-pressed", index === activeIndex ? "true" : "false");
        });
      };

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          updateProject(Number(tab.dataset.projectIndex || 0));
        });
      });

      previous?.addEventListener("click", () => updateProject(activeIndex - 1));
      next?.addEventListener("click", () => updateProject(activeIndex + 1));

      showcase.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") {
          event.preventDefault();
          updateProject(activeIndex - 1);
        }

        if (event.key === "ArrowRight") {
          event.preventDefault();
          updateProject(activeIndex + 1);
        }
      });

      updateProject(0);
    }

    // Mobile menu toggle
    const toggle = root.querySelector(".studio-menu-toggle");
    const nav = root.querySelector(".studio-nav");
    if (toggle && nav) {
      const openMenu = () => {
        nav.style.display = "flex";
        nav.style.flexDirection = "column";
        nav.style.position = "absolute";
        nav.style.top = "64px";
        nav.style.left = "0";
        nav.style.right = "0";
        nav.style.background = "var(--studio-bg)";
        nav.style.padding = "24px";
        nav.style.borderBottom = "1px solid var(--studio-border)";
        nav.style.gap = "16px";
      };
      const closeMenu = () => {
        nav.style.display = "";
        nav.style.flexDirection = "";
        nav.style.position = "";
        nav.style.top = "";
        nav.style.left = "";
        nav.style.right = "";
        nav.style.background = "";
        nav.style.padding = "";
        nav.style.borderBottom = "";
        nav.style.gap = "";
      };
      toggle.addEventListener("click", () => {
        const isOpen = nav.style.display === "flex";
        isOpen ? closeMenu() : openMenu();
      });
      nav.querySelectorAll(".studio-nav-link").forEach((link) => {
        link.addEventListener("click", closeMenu);
      });
    }
  });
</script>
