---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import StudioFooter from "../components/StudioFooter.astro";
import ProofSheet from "../components/work/ProofSheet.astro";
import LensBar from "../components/work/LensBar.astro";
import CaseRail from "../components/work/CaseRail.astro";
import CaseFile from "../components/work/CaseFile.astro";
import CaseQuote from "../components/work/CaseQuote.astro";
import ShippedLedger from "../components/work/ShippedLedger.astro";
import WorkLightbox from "../components/work/WorkLightbox.astro";
import StickyCta from "../components/work/StickyCta.astro";
import { caseFiles, caseQuotes } from "../content/work";
---

<Layout
  title="Work | Mohit Tater"
  description="Six in-depth case files and six smaller builds: enterprise tools, AI pipelines, agent skills, and open-source tools with 10K+ users. Each shows the disciplines involved, the stack, and where to verify it."
  mono
>
  <div class="wk" data-work-page>
    <a class="wk-skip" href="#case-files">Skip to case files</a>

    <header class="studio-header">
      <div class="studio-header-inner">
        <a href="/" class="studio-logo">Mohit Tater</a>
        <nav class="studio-nav" id="site-nav" aria-label="Primary">
          <a href="/" class="studio-nav-link">Home</a>
          <a href="/projects" class="studio-nav-link studio-nav-link-active" aria-current="page">Work</a>
          <a href="/about" class="studio-nav-link">About</a>
          <a
            href="#studio-footer"
            class="studio-nav-link studio-nav-cta"
            data-ph-cta="lets_talk"
            data-ph-location="nav">Let's talk</a
          >
        </nav>
        <button
          class="studio-menu-toggle"
          type="button"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="site-nav"
          data-menu-toggle
        >
          <span class="studio-menu-bar"></span>
          <span class="studio-menu-bar"></span>
        </button>
      </div>
    </header>

    <main>
      <ProofSheet />

      <section class="wk-work" id="work" aria-label="Projects" data-work>
        <LensBar />

        <div class="wk-container wk-work-grid">
          <CaseRail />

          <div class="wk-cases" id="case-files" data-ph-section="selected_work">
            <header class="wk-section-head">
              <p class="wk-eyebrow">Case files · 01–06</p>
              <h2 class="wk-h2">The selects, <em>in depth.</em></h2>
              <p class="wk-section-sub">
                Client engagements and my own products. Each one covers the
                brief, how it's built, the disciplines it took, and where you
                can check it.
              </p>
            </header>

            {
              caseFiles.map((file) => (
                <>
                  <CaseFile file={file} />
                  {caseQuotes[file.id] && (
                    <CaseQuote {...caseQuotes[file.id]} />
                  )}
                </>
              ))
            }
          </div>
        </div>

        <ShippedLedger />
      </section>
    </main>

    <StudioFooter />
    <WorkLightbox />
    <StickyCta />
  </div>
</Layout>

<style is:global>
  /* =========================================================================
     Work page primitives. Shared by the components in components/work/.
     Scoped under .wk so nothing leaks to other pages.
     ========================================================================= */

  html:has([data-work-page]) {
    scrollbar-gutter: stable;
  }
  html:has(.wk-lightbox[open]) {
    overflow: hidden;
  }

  .wk {
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-sans);
    line-height: 1.6;
  }

  .wk [id] {
    scroll-margin-top: calc(var(--header-h) + var(--space-5));
  }
  /* Targets inside the sticky lens area also clear the lens bar. */
  .wk .wk-work [id] {
    scroll-margin-top: calc(var(--header-h) + var(--space-10) + var(--space-4));
  }

  .wk-container {
    max-width: var(--site-container-max);
    margin: 0 auto;
    padding: 0 var(--site-container-padding);
  }

  .wk-skip {
    position: fixed;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 200;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--color-text);
    color: var(--color-surface);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-160%);
    transition: transform 0.2s var(--ease-out);
  }
  .wk-skip:focus-visible {
    transform: none;
  }

  .wk-eyebrow {
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .wk-h2 {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: var(--text-display-md);
    font-weight: 400;
    line-height: 1.1;
    text-wrap: balance;
  }
  .wk-h2 em {
    color: var(--color-accent);
  }

  .wk-section-head {
    max-width: 640px;
    margin-bottom: var(--space-8);
  }
  .wk-section-sub {
    margin: var(--space-4) 0 0;
    color: var(--color-text-body);
    font-size: var(--text-md);
    line-height: 1.65;
    text-wrap: pretty;
  }

  /* ---- Buttons ---------------------------------------------------------- */
  .wk-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 48px;
    padding: 0 var(--space-5);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: var(--text-md);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.2s var(--ease-out),
      color 0.2s var(--ease-out),
      transform 0.16s var(--ease-out);
  }
  .wk-btn:active {
    transform: scale(0.97);
  }
  .wk-btn-primary {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  .wk-btn-quiet {
    padding: 0 var(--space-2);
    color: var(--color-text);
  }
  .wk-btn .wk-arrow {
    transition: transform 0.25s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .wk-btn-primary:hover {
      background: var(--color-accent-pressed);
    }
    .wk-btn-quiet:hover {
      color: var(--color-accent);
    }
    .wk-btn:hover .wk-arrow {
      transform: translateX(3px);
    }
    .wk-btn-quiet:hover .wk-arrow-down {
      transform: translateY(3px);
    }
  }

  .wk :focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: 3px;
    border-radius: var(--radius-xs);
  }

  .wk .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---- Scroll reveal (progressive: CSS scroll-driven, no JS) -------------
     Content is always visible without support; where scroll timelines exist,
     blocks rise into place as they enter. */
  @keyframes wk-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .wk-rise {
        animation: wk-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 40%;
      }
    }
  }

  @media print {
    .wk-rise,
    .ps-in {
      animation: none !important;
    }
    .studio-header,
    .lens,
    .scta,
    .wk-skip {
      display: none !important;
    }
  }

  /* ---- Prefilled contact message: a brief, calm acknowledgement ---------- */
  @keyframes wk-field-flash {
    0%,
    60% {
      box-shadow: 0 0 0 4px var(--accent-soft);
      border-color: var(--accent-strong);
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  #studio-message.wk-prefilled {
    animation: wk-field-flash 1.6s var(--ease-out);
  }

  /* ---- Work area -------------------------------------------------------- */
  .wk-work {
    position: relative;
    padding-bottom: var(--space-10);
  }
  .wk-work-grid {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: var(--space-8);
    padding-top: var(--space-10);
  }
  .wk-cases {
    min-width: 0;
  }

  @media (max-width: 1099px) {
    .wk-work-grid {
      grid-template-columns: minmax(0, 1fr);
      padding-top: var(--space-10);
    }
  }

  /* ---- Header (same system as the other pages) --------------------------- */
  .studio-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    background: var(--color-bg-header);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }
  .studio-header-inner {
    max-width: var(--site-container-max);
    height: var(--header-h);
    margin: 0 auto;
    padding: 0 var(--site-container-padding);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .studio-logo {
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    text-decoration: none;
  }
  .studio-nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }
  .studio-nav-link {
    color: var(--color-text-body);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color 0.2s;
  }
  .studio-nav-link:hover,
  .studio-nav-link-active {
    color: var(--color-text);
  }
  .studio-nav-link-active {
    font-weight: 600;
  }
  .studio-nav-cta {
    color: var(--color-accent);
    font-weight: 600;
  }
  .studio-menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    margin-right: calc(var(--space-3) * -1);
    padding: var(--space-3);
    border: 0;
    background: none;
    cursor: pointer;
  }
  .studio-menu-bar {
    display: block;
    width: 20px;
    height: 1.5px;
    background: var(--color-text);
    transition: transform 0.3s var(--ease-out);
  }
  .studio-menu-toggle[aria-expanded="true"] .studio-menu-bar:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .studio-menu-toggle[aria-expanded="true"] .studio-menu-bar:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  @media (max-width: 768px) {
    .studio-menu-toggle {
      display: flex;
    }
    .studio-nav {
      position: absolute;
      top: var(--header-h);
      inset-inline: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--space-2) var(--site-container-padding-mobile) var(--space-4);
      border-bottom: 1px solid var(--color-border);
      background: var(--color-bg);
      box-shadow: var(--shadow-md);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition:
        opacity 0.2s var(--ease-out),
        transform 0.25s var(--ease-out),
        visibility 0s linear 0.25s;
    }
    .studio-nav.is-open {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition:
        opacity 0.2s var(--ease-out),
        transform 0.25s var(--ease-out);
    }
    .studio-nav-link {
      padding: var(--space-3) 0;
      font-size: var(--text-md);
    }
  }

  @media (max-width: 640px) {
    .wk-container,
    .studio-header-inner {
      padding: 0 var(--site-container-padding-mobile);
    }
    .wk-section-head {
      margin-bottom: var(--space-6);
    }
  }
</style>

<script>
  import "../scripts/work-page";
</script>
