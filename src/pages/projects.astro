<script>
  document.addEventListener("DOMContentLoaded", () => {
    const root = document.querySelector(
      '[data-variation-content="studio"]'
    );
    if (!root) return;

    // Reveal animations
    const reveals = root.querySelectorAll(".studio-reveal");

    reveals.forEach((el) => {
      (el as HTMLElement).style.animationPlayState = "paused";
      (el as HTMLElement).style.opacity = "0";
      (el as HTMLElement).style.transform = "translateY(16px)";
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            el.style.animationPlayState = "running";
            el.style.opacity = "";
            el.style.transform = "";
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
    );

    reveals.forEach((el) => observer.observe(el));

    // Project showcase
    const showcase = root.querySelector("[data-project-showcase]");
    if (showcase) {
      const visualSets = Array.from(
        showcase.querySelectorAll("[data-project-visual]")
      ) as HTMLElement[];
      const details = Array.from(
        showcase.querySelectorAll("[data-project-detail]")
      ) as HTMLElement[];
      const backs = Array.from(
        showcase.querySelectorAll("[data-project-back]")
      ) as HTMLElement[];
      const thumbSets = Array.from(
        showcase.querySelectorAll("[data-thumb-set]")
      ) as HTMLElement[];
      const dots = Array.from(
        showcase.querySelectorAll("[data-project-dot]")
      ) as HTMLButtonElement[];
      const current = showcase.querySelector(
        "[data-project-current]"
      );
      const previous = showcase.querySelector("[data-project-prev]");
      const next = showcase.querySelector("[data-project-next]");
      const detailPanel = showcase.querySelector(
        "[data-detail-panel]"
      ) as HTMLElement | null;
      const flipButtons = Array.from(
        showcase.querySelectorAll("[data-flip-button]")
      ) as HTMLButtonElement[];
      const titleEl = showcase.querySelector(
        "[data-project-title]"
      ) as HTMLElement | null;

      let activeIndex = 0;

      // ===== Analytics =====
      const phTrack = (
        event: string,
        props: Record<string, unknown> = {}
      ) =>
        (window as any).posthog?.capture?.(event, {
          page: location.pathname,
          ...props,
        });
      let lastViewed = -1;
      const trackProjectView = () => {
        if (activeIndex === lastViewed) return;
        lastViewed = activeIndex;
        const detail = details[activeIndex];
        phTrack("project_viewed", {
          project_id: detail?.dataset.projectId ?? null,
          title: detail?.dataset.projectTitle ?? null,
        });
      };

      const setFlipped = (flipped: boolean) => {
        detailPanel?.classList.toggle("is-flipped", flipped);
      };

      const swapTitle = (nextTitle: string) => {
        if (!titleEl || titleEl.textContent?.trim() === nextTitle)
          return;
        titleEl.classList.add("is-swapping");
        window.setTimeout(() => {
          titleEl.textContent = nextTitle;
          titleEl.classList.remove("is-swapping");
        }, 180);
      };

      const updateProject = (nextIndex: number) => {
        activeIndex =
          (nextIndex + visualSets.length) % visualSets.length;
        const label = String(activeIndex + 1).padStart(2, "0");

        if (current) current.textContent = label;

        const nextTitle = details[activeIndex]
          ?.querySelector(".work-project-title")
          ?.textContent?.trim();
        if (nextTitle) swapTitle(nextTitle);

        // Always reset to front when switching projects
        setFlipped(false);

        visualSets.forEach((set, index) => {
          const isActive = index === activeIndex;
          set.classList.toggle("is-active", isActive);
          set.setAttribute(
            "aria-hidden",
            isActive ? "false" : "true"
          );

          // Also reset to first screenshot when switching
          const imgs = set.querySelectorAll(".work-visual-img");
          imgs.forEach((img, j) =>
            img.classList.toggle("is-active", j === 0)
          );
        });

        thumbSets.forEach((set, index) => {
          set.classList.toggle("is-active", index === activeIndex);
          const thumbs = set.querySelectorAll(
            ".work-screenshot-thumb"
          );
          thumbs.forEach((t, j) =>
            t.classList.toggle("is-active", j === 0)
          );
        });

        details.forEach((detail, index) => {
          const isActive = index === activeIndex;
          detail.classList.toggle("is-active", isActive);
          detail.setAttribute(
            "aria-hidden",
            isActive ? "false" : "true"
          );
        });

        backs.forEach((back, index) => {
          const isActive = index === activeIndex;
          back.classList.toggle("is-active", isActive);
          back.setAttribute("aria-hidden", "true");
        });

        dots.forEach((dot, index) => {
          const isActive = index === activeIndex;
          dot.classList.toggle("is-active", isActive);
          dot.setAttribute(
            "aria-pressed",
            isActive ? "true" : "false"
          );
        });

        trackProjectView();
      };

      // Screenshot thumb clicks — switch the active screenshot AND open the lightbox
      thumbSets.forEach((set) => {
        const projectIndex = Number(set.dataset.projectIndex || 0);
        const thumbs = Array.from(
          set.querySelectorAll(".work-screenshot-thumb")
        ) as HTMLButtonElement[];
        thumbs.forEach((thumb) => {
          thumb.addEventListener("click", () => {
            const j = Number(thumb.dataset.screenshotIndex || 0);
            thumbs.forEach((t, k) =>
              t.classList.toggle("is-active", k === j)
            );
            const visualImgs = visualSets[
              projectIndex
            ]?.querySelectorAll(".work-visual-img");
            visualImgs?.forEach((img, k) =>
              img.classList.toggle("is-active", k === j)
            );
            openLightbox(projectIndex, j);
          });
        });
      });

      // Main visual click — open lightbox with the active screenshot for this project
      const visualButtons = Array.from(
        showcase.querySelectorAll("[data-lightbox-open]")
      ) as HTMLButtonElement[];
      visualButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const set = btn.closest(
            "[data-project-visual]"
          ) as HTMLElement | null;
          if (!set) return;
          const projectIndex = Number(set.dataset.projectIndex || 0);
          const screenshotIndex = Number(
            btn.dataset.screenshotIndex || 0
          );
          openLightbox(projectIndex, screenshotIndex);
        });
      });

      // Mobile card screenshots reuse the same lightbox. They carry explicit
      // project/screenshot indices, and openLightbox reads image sources from
      // the (display:none but still-in-DOM) desktop visual sets.
      const mobileLightboxButtons = Array.from(
        root.querySelectorAll("[data-mobile-lightbox]")
      ) as HTMLButtonElement[];
      mobileLightboxButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const projectIndex = Number(btn.dataset.projectIndex || 0);
          const screenshotIndex = Number(
            btn.dataset.screenshotIndex || 0
          );
          openLightbox(projectIndex, screenshotIndex);
        });
      });

      // ===== Lightbox controller =====
      const lightbox = document.querySelector(
        "[data-lightbox]"
      ) as HTMLElement | null;
      const lightboxImg = lightbox?.querySelector(
        "[data-lightbox-img]"
      ) as HTMLImageElement | null;
      const lightboxCaption = lightbox?.querySelector(
        "[data-lightbox-caption]"
      ) as HTMLElement | null;
      const lightboxClose = lightbox?.querySelector(
        "[data-lightbox-close]"
      ) as HTMLButtonElement | null;
      const lightboxPrev = lightbox?.querySelector(
        "[data-lightbox-prev]"
      ) as HTMLButtonElement | null;
      const lightboxNext = lightbox?.querySelector(
        "[data-lightbox-next]"
      ) as HTMLButtonElement | null;

      let lightboxProject = 0;
      let lightboxIdx = 0;

      const projectImages = (projectIndex: number): string[] => {
        const set = visualSets[projectIndex];
        if (!set) return [];
        return Array.from(
          set.querySelectorAll(".work-visual-img img")
        ).map((el) => (el as HTMLImageElement).src);
      };

      const renderLightbox = () => {
        if (!lightbox || !lightboxImg || !lightboxCaption) return;
        const images = projectImages(lightboxProject);
        if (images.length === 0) return;
        lightboxIdx =
          ((lightboxIdx % images.length) + images.length) %
          images.length;
        lightboxImg.src = images[lightboxIdx];
        lightboxImg.alt = `Screenshot ${lightboxIdx + 1}`;
        lightboxCaption.textContent =
          images.length > 1
            ? `${lightboxIdx + 1} / ${images.length}`
            : "";

        // Hide arrows when single image
        const showArrows = images.length > 1;
        if (lightboxPrev)
          lightboxPrev.style.visibility = showArrows
            ? "visible"
            : "hidden";
        if (lightboxNext)
          lightboxNext.style.visibility = showArrows
            ? "visible"
            : "hidden";
      };

      const openLightbox = (
        projectIndex: number,
        screenshotIndex: number
      ) => {
        if (!lightbox) return;
        lightboxProject = projectIndex;
        lightboxIdx = screenshotIndex;
        phTrack("project_engaged", {
          project_id:
            details[projectIndex]?.dataset.projectId ?? null,
          action: "screenshot_opened",
        });
        renderLightbox();
        lightbox.hidden = false;
        document.body.classList.add("lightbox-open");
        lightboxClose?.focus();
      };

      const closeLightbox = () => {
        if (!lightbox) return;
        lightbox.hidden = true;
        document.body.classList.remove("lightbox-open");
      };

      lightboxClose?.addEventListener("click", closeLightbox);
      lightboxPrev?.addEventListener("click", () => {
        lightboxIdx -= 1;
        renderLightbox();
      });
      lightboxNext?.addEventListener("click", () => {
        lightboxIdx += 1;
        renderLightbox();
      });

      // Click backdrop to close
      lightbox?.addEventListener("click", (e) => {
        if (e.target === lightbox) closeLightbox();
      });

      // Dot clicks
      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          updateProject(Number(dot.dataset.projectIndex || 0));
        });
      });

      previous?.addEventListener("click", () =>
        updateProject(activeIndex - 1)
      );
      next?.addEventListener("click", () =>
        updateProject(activeIndex + 1)
      );

      // Flip buttons
      flipButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const target = btn.dataset.flipTarget;
          // Update aria-hidden on backs to reflect flipped state
          if (target === "back") {
            backs.forEach((back, index) => {
              back.setAttribute(
                "aria-hidden",
                index === activeIndex ? "false" : "true"
              );
            });
            setFlipped(true);
            phTrack("project_engaged", {
              project_id:
                details[activeIndex]?.dataset.projectId ?? null,
              action: "details_expanded",
            });
          } else {
            backs.forEach((back) =>
              back.setAttribute("aria-hidden", "true")
            );
            setFlipped(false);
          }
        });
      });

      // Global keyboard nav — arrow keys switch projects (or screenshots when lightbox is open)
      document.addEventListener("keydown", (event: KeyboardEvent) => {
        // Skip when typing in a form field or contenteditable
        const target = event.target as HTMLElement | null;
        if (target) {
          const tag = target.tagName;
          if (
            tag === "INPUT" ||
            tag === "TEXTAREA" ||
            tag === "SELECT" ||
            target.isContentEditable
          )
            return;
        }

        const isLightboxOpen = lightbox && !lightbox.hidden;

        if (event.key === "Escape") {
          if (isLightboxOpen) {
            event.preventDefault();
            closeLightbox();
          } else if (detailPanel?.classList.contains("is-flipped")) {
            event.preventDefault();
            setFlipped(false);
          }
          return;
        }

        if (event.key === "ArrowLeft") {
          event.preventDefault();
          if (isLightboxOpen) {
            lightboxIdx -= 1;
            renderLightbox();
          } else {
            updateProject(activeIndex - 1);
          }
        } else if (event.key === "ArrowRight") {
          event.preventDefault();
          if (isLightboxOpen) {
            lightboxIdx += 1;
            renderLightbox();
          } else {
            updateProject(activeIndex + 1);
          }
        }
      });

      updateProject(0);

      // Auto-scroll into the spotlight after a longer peek at the hero so the
      // headline is read before motion. Bails if the user already scrolled,
      // has a hash deep-link, or starts interacting.
      // Sequence: 0ms land → 1800ms spotlight lifts (anticipation) → 2700ms page scrolls →
      // 3300ms panel settles. The "More details" button has its own CSS-driven
      // late entry tied to .is-active, so it animates in on every project switch.
      (() => {
        if (window.location.hash) return;
        if (window.scrollY > 4) return;
        if (
          window.matchMedia("(prefers-reduced-motion: reduce)")
            .matches
        )
          return;
        // On mobile the desktop browser is hidden and replaced by the scrollable
        // card list, so there's nothing to lift/anticipate — skip the auto-scroll.
        if (window.matchMedia("(max-width: 900px)").matches) return;

        const section = document.querySelector(
          ".projects-browser-section"
        ) as HTMLElement | null;
        const browser = document.querySelector(
          ".work-browser"
        ) as HTMLElement | null;
        if (!section || !browser) return;

        let cancelled = false;
        const timeouts: number[] = [];

        const cancel = () => {
          if (cancelled) return;
          cancelled = true;
          timeouts.forEach((id) => window.clearTimeout(id));
          browser.classList.remove("is-anticipating");
          window.removeEventListener("wheel", cancel);
          window.removeEventListener("touchstart", cancel);
          window.removeEventListener("keydown", cancel);
          window.removeEventListener("mousedown", cancel);
        };

        window.addEventListener("wheel", cancel, { passive: true });
        window.addEventListener("touchstart", cancel, {
          passive: true,
        });
        window.addEventListener("mousedown", cancel);
        window.addEventListener("keydown", cancel);

        // Anticipation lift — the whole spotlight unit (topline + shell) rises,
        // shadow deepens, green hint on the border. Held longer so the hero gets read.
        timeouts.push(
          window.setTimeout(() => {
            if (cancelled) return;
            browser.classList.add("is-anticipating");
          }, 1800)
        );

        // Begin the scroll. The lift is still in effect, so the scroll reads as
        // the same motion continuing — the panel that just rose now meets you.
        timeouts.push(
          window.setTimeout(() => {
            if (cancelled) return;
            const HEADER_OFFSET = 64;
            const target =
              section.getBoundingClientRect().top +
              window.scrollY -
              HEADER_OFFSET -
              12;
            if (target > window.scrollY + 4) {
              window.scrollTo({ top: target, behavior: "smooth" });
            }
          }, 2700)
        );

        // Release the lift as the panel reaches its resting position in view.
        timeouts.push(
          window.setTimeout(() => {
            browser.classList.remove("is-anticipating");
          }, 3300)
        );
      })();
    }

    // Mobile menu toggle
    const toggle = root.querySelector(".studio-menu-toggle");
    const nav = root.querySelector(
      ".studio-nav"
    ) as HTMLElement | null;
    if (toggle && nav) {
      const openMenu = () => {
        nav.style.display = "flex";
        nav.style.flexDirection = "column";
        nav.style.position = "absolute";
        nav.style.top = "64px";
        nav.style.left = "0";
        nav.style.right = "0";
        nav.style.background = "var(--studio-bg)";
        nav.style.padding = "24px";
        nav.style.borderBottom = "1px solid var(--studio-border)";
        nav.style.gap = "16px";
      };
      const closeMenu = () => {
        nav.style.display = "";
        nav.style.flexDirection = "";
        nav.style.position = "";
        nav.style.top = "";
        nav.style.left = "";
        nav.style.right = "";
        nav.style.background = "";
        nav.style.padding = "";
        nav.style.borderBottom = "";
        nav.style.gap = "";
      };
      toggle.addEventListener("click", () => {
        const isOpen = nav.style.display === "flex";
        isOpen ? closeMenu() : openMenu();
      });
      nav.querySelectorAll(".studio-nav-link").forEach((link) => {
        link.addEventListener("click", closeMenu);
      });
    }
  });
</script>

<!-- Mobile spotlight deck: focus tracking, detail sheet, lightbox (≤900px) -->
<script define:vars={{ MSPOT: spotlightProjects }}>
  (function () {
    function init() {
      var root = document.querySelector("[data-mspot]");
      if (!root) return;

      var TOTAL = String(MSPOT.length).padStart(2, "0");
      var esc = function (s) {
        return String(s)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;");
      };
      var ph = function (event, props) {
        try {
          window.posthog &&
            window.posthog.capture &&
            window.posthog.capture(
              event,
              Object.assign({ page: location.pathname }, props || {})
            );
        } catch (e) {}
      };

      var deck = root.querySelector("[data-mspot-deck]");
      var cards = Array.prototype.slice.call(
        deck.querySelectorAll("[data-mspot-card]")
      );
      var dots = Array.prototype.slice.call(
        root.querySelectorAll("[data-mspot-dot]")
      );
      var posEl = root.querySelector("[data-mspot-pos]");
      var typeEl = root.querySelector("[data-mspot-curtype]");
      var focus = 0;

      function updateFocus() {
        if (!deck.clientWidth) return;
        var center = deck.scrollLeft + deck.clientWidth / 2;
        var best = 0;
        var bestD = Infinity;
        cards.forEach(function (c, i) {
          var cc = c.offsetLeft + c.clientWidth / 2;
          var d = Math.abs(cc - center);
          if (d < bestD) {
            bestD = d;
            best = i;
          }
        });
        if (best !== focus) {
          focus = best;
          typeEl.textContent = MSPOT[best].type;
          typeEl.classList.remove("is-swap");
          void typeEl.offsetWidth;
          typeEl.classList.add("is-swap");
        }
        posEl.textContent = String(best + 1).padStart(2, "0");
        cards.forEach(function (c, i) {
          c.classList.toggle("is-focus", i === best);
        });
        dots.forEach(function (d, i) {
          d.classList.toggle("is-active", i === best);
        });
      }
      var raf = null;
      deck.addEventListener(
        "scroll",
        function () {
          if (!raf)
            raf = requestAnimationFrame(function () {
              raf = null;
              updateFocus();
            });
        },
        { passive: true }
      );
      window.addEventListener("resize", updateFocus);

      function scrollToCard(i) {
        var c = cards[i];
        deck.scrollTo({
          left: c.offsetLeft - (deck.clientWidth - c.clientWidth) / 2,
          behavior: "smooth",
        });
      }
      dots.forEach(function (d, i) {
        d.addEventListener("click", function () {
          scrollToCard(i);
        });
      });

      // tap a side card → center it; tap the focal card → open its detail sheet
      var downX = 0;
      var downY = 0;
      cards.forEach(function (c, i) {
        c.addEventListener("pointerdown", function (e) {
          downX = e.clientX;
          downY = e.clientY;
        });
        c.addEventListener("click", function (e) {
          if (
            Math.abs(e.clientX - downX) > 8 ||
            Math.abs(e.clientY - downY) > 8
          )
            return;
          if (i === focus) openSheet(i);
          else scrollToCard(i);
        });
      });

      // ===== detail sheet =====
      var sheet = document.querySelector("[data-mspot-sheet]");
      var scrim = document.querySelector("[data-mspot-scrim]");
      var sheetBody = sheet.querySelector("[data-mspot-sheet-body]");
      var curP = 0;

      function tagsHtml(tech) {
        var max = 4;
        var shown = tech.slice(0, max).join("  ·  ");
        var extra = tech.length > max ? "  ·  +" + (tech.length - max) : "";
        return '<div class="mspot-s-tags">' + esc(shown + extra) + "</div>";
      }
      function actionsHtml(p) {
        var hasCase = !!p.caseStudyUrl;
        var hasLive = !!p.liveUrl && p.liveUrl !== p.sourceUrl;
        var out = [];
        if (hasCase)
          out.push(
            '<a class="mspot-act mspot-act-primary" href="' +
              p.caseStudyUrl +
              '" data-ph-action="case_study" data-ph-project="' +
              p.id +
              '">' +
              esc(p.caseStudyLabel || "Read the case study") +
              " &rarr;</a>"
          );
        if (hasLive)
          out.push(
            '<a class="mspot-act ' +
              (hasCase ? "" : "mspot-act-primary") +
              '" href="' +
              p.liveUrl +
              '" target="_blank" rel="noopener" data-ph-action="demo" data-ph-project="' +
              p.id +
              '">' +
              esc(p.liveLabel || "Live") +
              " &rarr;</a>"
          );
        if (p.sourceUrl)
          out.push(
            '<a class="mspot-act ' +
              (hasCase || hasLive ? "" : "mspot-act-primary") +
              '" href="' +
              p.sourceUrl +
              '" target="_blank" rel="noopener" data-ph-action="github" data-ph-project="' +
              p.id +
              '">' +
              (hasCase || hasLive ? "GitHub" : "View on GitHub") +
              " &rarr;</a>"
          );
        if (!hasCase && !hasLive && !p.sourceUrl && p.note)
          out.push('<span class="mspot-act-note">🔒 ' + esc(p.note) + "</span>");
        return '<div class="mspot-s-actions">' + out.join("") + "</div>";
      }
      function shotsHtml(p) {
        if (!p.images || !p.images.length) return "";
        var zoom =
          '<span class="mspot-shot-zoom"><svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M2 5V2h3M10 7v3H7" stroke="#fff" stroke-width="1.4" stroke-linecap="round"/></svg></span>';
        var inner = p.images
          .map(function (img, j) {
            return (
              '<button type="button" class="mspot-shot" data-mspot-shot="' +
              j +
              '" aria-label="Enlarge screenshot ' +
              (j + 1) +
              '"><img src="' +
              img +
              '" alt="" loading="lazy">' +
              zoom +
              "</button>"
            );
          })
          .join("");
        return '<div class="mspot-s-shots">' + inner + "</div>";
      }
      function discHtml(p) {
        if (!p.back) return "";
        var chev =
          '<span class="mspot-disc-chev"><svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>';
        var sections = p.back.sections
          .map(function (s) {
            return "<div><h4>" + esc(s.heading) + "</h4><p>" + esc(s.body) + "</p></div>";
          })
          .join("");
        return (
          '<details class="mspot-disc"><summary><span>' +
          esc(p.back.title) +
          "</span>" +
          chev +
          '</summary><div class="mspot-disc-body">' +
          sections +
          "</div></details>"
        );
      }

      function openSheet(i) {
        var p = MSPOT[i];
        curP = i;
        sheetBody.innerHTML =
          '<div class="mspot-s-eyebrow">' +
          esc(p.type) +
          " &middot; " +
          String(i + 1).padStart(2, "0") +
          " / " +
          TOTAL +
          "</div>" +
          '<h2 class="mspot-s-title">' +
          esc(p.title) +
          "</h2>" +
          '<div class="mspot-s-outcome">' +
          esc(p.outcome) +
          "</div>" +
          '<p class="mspot-s-desc">' +
          esc(p.description) +
          "</p>" +
          tagsHtml(p.tech) +
          shotsHtml(p) +
          actionsHtml(p) +
          discHtml(p);
        sheetBody.scrollTop = 0;
        sheet.classList.add("is-open");
        scrim.classList.add("is-open");
        document.body.classList.add("lightbox-open");
        wireShots(i);
        ph("project_viewed", { project_id: p.id, title: p.title });
      }
      function closeSheet() {
        sheet.classList.remove("is-open");
        scrim.classList.remove("is-open");
        if (!lb.classList.contains("is-open"))
          document.body.classList.remove("lightbox-open");
      }
      sheet
        .querySelector("[data-mspot-close]")
        .addEventListener("click", closeSheet);
      scrim.addEventListener("click", closeSheet);

      // ===== lightbox =====
      var lb = document.querySelector("[data-mspot-lb]");
      var lbImg = lb.querySelector("[data-mspot-lb-img]");
      var lbCap = lb.querySelector("[data-mspot-lb-cap]");
      var lbIdx = 0;
      function showLb() {
        var pr = MSPOT[curP];
        lbImg.src = pr.images[lbIdx];
        lbCap.textContent =
          pr.title + " — " + (lbIdx + 1) + "/" + pr.images.length;
      }
      function wireShots(i) {
        sheetBody
          .querySelectorAll(".mspot-shot")
          .forEach(function (s) {
            s.addEventListener("click", function () {
              lbIdx = parseInt(s.getAttribute("data-mspot-shot"), 10);
              showLb();
              lb.classList.add("is-open");
              document.body.classList.add("lightbox-open");
            });
          });
      }
      lb.querySelector("[data-mspot-lb-close]").addEventListener(
        "click",
        function () {
          lb.classList.remove("is-open");
          if (!sheet.classList.contains("is-open"))
            document.body.classList.remove("lightbox-open");
        }
      );
      lb.querySelector("[data-mspot-lb-prev]").addEventListener(
        "click",
        function () {
          var n = MSPOT[curP].images.length;
          lbIdx = (lbIdx - 1 + n) % n;
          showLb();
        }
      );
      lb.querySelector("[data-mspot-lb-next]").addEventListener(
        "click",
        function () {
          var n = MSPOT[curP].images.length;
          lbIdx = (lbIdx + 1) % n;
          showLb();
        }
      );

      updateFocus();
    }

    if (document.readyState === "loading")
      document.addEventListener("DOMContentLoaded", init);
    else init();
  })();
</script>
