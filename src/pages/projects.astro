---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import StudioFooter from "../components/StudioFooter.astro";

const spotlightProjects = [
  {
    id: "ops-workspace",
    type: "Enterprise App",
    title: "Enterprise Ops Workspace",
    outcome: "Complex internal tool, delivered end-to-end",
    description:
      "An internal web app that supports a sales team's day-to-day operations. It includes multi-step onboarding forms, filterable tables and grids, template detail views, and an in-app help system, with a UI designed to keep complex enterprise workflows easy to navigate.",
    tech: [
      "Next.js 16",
      "Tailwind v4",
      "shadcn/ui",
      "Supabase",
      "NextAuth",
    ],
    images: [
      "/images/SCR-20260526-posx.webp",
      "/images/SCR-20260526-porc.webp",
      "/images/SCR-20260526-povd.webp",
    ],
    gradient: "ops-workspace",
    // Source repo is private (client work) — link intentionally hidden.
    // Live demo also hidden: it's a client app behind a login wall, so it's
    // showcased via screenshots instead. To add more, drop files in
    // public/images/ and append their paths to the `images` array above.
    note: "Private client engagement — shown via screenshots",
    back: {
      title: "How the app is put together",
      sections: [
        {
          heading: "Three connected modules",
          body: "Client capture wizard, template library admin, and reporting. Each module has its own role but shares a common data model, so a change to a template ripples cleanly into how it's used in onboarding and how it shows up in reports.",
        },
        {
          heading: "Data model",
          body: "Clients, templates, submissions, and audit records. Designed so historical onboarding records stay intact and readable even as templates evolve over time — the kind of detail that only matters once you're months into using it.",
        },
        {
          heading: "Auth and deployment",
          body: "NextAuth v5 against the company's OIDC server for SSO, Supabase service-role on the server side for trusted operations, and a CodeBuild → ECS pipeline for deploys.",
        },
      ],
    },
  },
  {
    id: "ai-resizing-studio",
    type: "AI Image Pipeline",
    title: "AI Resizing Studio",
    outcome: "AI handles first-pass QA; humans review only what matters",
    description:
      "A bulk image-resizing tool for a marketing team that reformats thousands of event posters into every ad ratio they need. It's built around three interfaces — batch processing, side-by-side review, and an evaluation dashboard — with an AI judge running first-pass QA on every output, so reviewers spend their attention only where it's actually needed.",
    tech: [
      "Gemini 3 Image",
      "OpenAI GPT Image",
      "Next.js",
      "Supabase",
      "AI-as-judge",
    ],
    images: [
      "/images/image-resizing/input-interface.webp",
      "/images/image-resizing/review-interface.webp",
      "/images/image-resizing/eval.webp",
    ],
    gradient: "image-resizing",
    // Source repo is private (client work) — link intentionally hidden.
    // Live app is behind the client's environment, so it's shown via
    // screenshots instead.
    note: "Private client engagement — shown via screenshots",
    back: {
      title: "How the three interfaces work together",
      sections: [
        {
          heading: "Processing — generate at scale",
          body: "Drop in images or a CSV and the pipeline fans each asset out into all of its target ratios at once. Every output gets a risk score (none → high) computed from crop loss, aspect-ratio mismatch, and the strategy used — so problem outputs are flagged before a human ever opens them. Smart / AI-only / Force-AI modes trade speed against cost per run.",
        },
        {
          heading: "Review — a keyboard-fast human pass",
          body: "Source and generated sit side by side with the AI's verdict and score already attached. Reviewers rate Good / Okay / Bad entirely from the keyboard and move through the whole queue without reaching for the mouse — filters rebuild the queue on the fly, so you can burn down just the unreviewed, or just the high-risk outputs.",
        },
        {
          heading: "Evaluation — AI in the loop",
          body: "An AI visual judge grades every output against the same rubric a human would. Deterministic checks and a retry/escalation policy then decide what to auto-accept, retry with a stronger safe-area prompt, reroute to another model, or send up for manual design work. The dashboard tracks good-rate, bad-rate on high-risk outputs, and cost per good output — and surfaces where the AI and humans disagree, so the rubric keeps sharpening over time.",
        },
      ],
    },
  },
  {
    id: "dashboard-skill",
    type: "Design Case Study",
    title: "Designing Dashboards",
    outcome: "Generic chart-dumps → actionable launchpads",
    description:
      "An agent skill that turns the everyday “wall of charts” dashboard into something a person can actually act on. The case study isolates what the skill adds — V1 (Claude with no skill) vs V7 (with it) — and the six grounding principles behind it that hold for any dashboard, any stack, any domain.",
    tech: [
      "UI/UX",
      "Data Viz",
      "Agent Skill",
      "Recharts",
      "Design System",
    ],
    images: [
      "/images/dashboard-skill-project/original.webp",
      "/images/dashboard-skill-project/v7-light.webp",
      "/images/dashboard-skill-project/v7-dark.webp",
    ],
    gradient: "dashboard-skill",
    caseStudyUrl: "/work/dashboard-skill",
    caseStudyLabel: "Read the case study",
    sourceUrl:
      "https://github.com/mnttnm/mohit-ai-toolkit/tree/main/skills/designing-dashboards",
    back: {
      title: "What's inside the case study",
      sections: [
        {
          heading: "Six grounding principles",
          body: "Start from the decision not the data, lead with one thing, earn every element, show the insight not just the data, end in a next step, and spend emphasis sparingly — the questions I designed against from the first pass, transferable to any dashboard.",
        },
        {
          heading: "A real redesign, including the wrong turns",
          body: "Original → V1 → V4 → V7, shown honestly. It overshoots into decoration before settling — the V4 frame is kept in on purpose, because an iteration that mistook richness for clarity is the clearest lesson of the lot.",
        },
        {
          heading: "Validated, not just asserted",
          body: "To keep it honest, a fresh agent with no memory of the previous version rebuilds the dashboard blind from the same brief. If it lands in the same place, the principles are doing the work — not attachment to a layout.",
        },
      ],
    },
  },
  {
    id: "slicely",
    type: "SaaS Product",
    title: "Slicely",
    outcome: "Turn any PDF into structured data",
    description:
      "A web app for extracting structured data from PDFs using reusable recipes. Users annotate the relevant pages of a PDF, define their extraction rules once, and view results rendered as a number, table, chart, or plain text — no per-document configuration needed.",
    tech: ["Next.js", "Supabase", "Tailwind CSS", "LLM Integration"],
    images: [
      "/images/SCR-20260526-poif.webp",
      "/images/SCR-20260526-pokt.webp",
    ],
    gradient: "slicely",
    // Source repo is private — link intentionally hidden.
    liveUrl: "https://slicely-ai.vercel.app/",
    liveLabel: "Live demo",
    back: {
      title: "What's inside",
      sections: [
        {
          heading: "Annotation module",
          body: "A focused interface for marking up source PDFs — the part you spend the most time in if you're configuring a new slicer. Designed so the heavy work of pointing at the right regions of a PDF feels lightweight.",
        },
        {
          heading: "Dynamic response renderer",
          body: "Each slicer can return very different shapes of data. The renderer picks the right view automatically — a single number, a chart, a table, or a formatted text block — so the dashboard reads cleanly across slicers without per-slicer UI work.",
        },
        {
          heading: "Bulk processing & webhooks",
          body: "Designed to chew through batches and notify other systems when results are ready, so it fits into a larger pipeline rather than being a standalone tool.",
        },
      ],
    },
  },
  {
    id: "ai-toolkit",
    type: "Developer Tool",
    title: "AI Toolkit",
    outcome: "AI workflows I actually use daily",
    description:
      "A collection of reusable agent skills and Codex automation templates for Claude Code and Codex. Skills cover product UI, dashboards, interface grading, UX patterns, interaction design, and workflow automation, and can be installed with a single command. I use it to keep my agentic-engineering practice current.",
    tech: ["Claude Code", "Codex", "Agent Skills", "Automations"],
    images: ["/images/mohit-ai-toolkit.webp"],
    gradient: "ai-toolkit",
    sourceUrl: "https://github.com/mnttnm/mohit-ai-toolkit",
    back: {
      title: "Skills in the toolkit",
      sections: [
        {
          heading: "product-ui",
          body: "Production-grade product interface work — the invisible craft that makes software feel premium.",
        },
        {
          heading: "dashboard",
          body: "Modern, actionable dashboards through a structured requirements → strategy → design workflow.",
        },
        {
          heading: "interface-grader",
          body: "Quantitative grading of any frontend interface against a craft rubric, with iteration-over-iteration deltas.",
        },
        {
          heading: "ux-patterns & interaction-design",
          body: "Frictionless UX patterns and the microinteractions, motion, and state-handling that go on top.",
        },
        {
          heading: "ui-design-system",
          body: "React + Tailwind + Radix + shadcn/ui systems — accessible components, theming, dark mode.",
        },
        {
          heading: "harvest-feed",
          body: "Mine a working session for publishable posts and turn quiet wins into content.",
        },
        {
          heading: "Codex automations",
          body: "Templates for daily digests, weekly journals, content mining, and session-log backups.",
        },
      ],
    },
  },
  {
    id: "reviewhub",
    type: "Agentic Workflow",
    title: "ReviewHub",
    outcome: "Agent-powered feedback loop, end-to-end",
    description:
      "A feedback pipeline that connects three tools: in-browser annotations on a live prototype, a communication channel (Slack or Confluence), and a coding agent. Feedback captured in the browser flows to the chosen channel, gets picked up by an agent, and the task status is updated automatically once the work is done.",
    tech: ["Agentation", "Slack", "Confluence", "Devin", "Next.js"],
    images: [
      "/images/SCR-20260526-ppcv.webp",
      "/images/SCR-20260526-ppfp.webp",
    ],
    gradient: "reviewhub",
    sourceUrl: "https://github.com/mnttnm/reviewhub",
    liveUrl: "https://reviewhub-weld.vercel.app/",
    liveLabel: "Live demo",
    back: {
      title: "How the loop closes",
      sections: [
        {
          heading: "Live prototype review",
          body: "An Agentation widget overlays the running app so anyone — PM, designer, client — can drop pixel-accurate annotations without leaving the browser. Feedback is captured against what the reviewer is actually seeing, not a static screenshot.",
        },
        {
          heading: "Feedback, where your team already lives",
          body: "Slack is the default destination, but Confluence is now wired in for teams that work out of Atlassian. Pick the destination per project; the rest of the pipeline doesn't change.",
        },
        {
          heading: "Agent handoff and status sync",
          body: "Coding agents pick tasks up from the feed and execute. Once a fix lands, the Confluence page or Slack thread updates itself — the loop closes without anyone playing telephone between QA, design, and engineering.",
        },
      ],
    },
  },
];

const moreProjects = [
  {
    title: "Greetwood",
    description:
      "A Shopify store for a D2C furniture brand, built entirely through code — theme, content, and store configuration — using AI agents (Claude Code and Codex Cloud) and the Shopify CLI instead of Shopify's web admin.",
    image: "/images/SCR-20260526-poxa.webp",
    liveUrl: "https://greetwood.myshopify.com",
    liveLabel: "Visit store",
    type: "Shopify Store",
  },
  {
    title: "Building a Business Co-Pilot with Claude Code",
    description:
      "An AI-powered business management system that handles daily planning, revenue tracking, and weekly reviews, built with Claude Code acting as an autonomous co-pilot across an Obsidian-based workspace.",
    image: "/projects/business-copilot.webp",
    liveUrl:
      "https://medium.com/@tatermohit/i-built-a-business-co-pilot-using-claude-code-heres-the-exact-system-cfe32ee59558",
    liveLabel: "Read article",
    type: "Article",
  },
  {
    title: "learning.log",
    description:
      "A capture-and-publish platform that turns quick notes into a public learning stream, with a Raycast-powered input pipeline, Redis-backed queue, and automated GitHub publishing.",
    image: "/projects/learning-log.webp",
    liveUrl: "https://mohit.stream",
    liveLabel: "Live app",
    type: "Web App",
  },
  {
    title: "Figma Variable Explorer",
    description:
      "Browse, inspect, and export Figma design variables in List, JSON, and CSS formats. Supports both design and development modes, used by 8,000+ designers.",
    image: "/projects/figma-variable-explorer.webp",
    liveUrl:
      "https://www.figma.com/community/plugin/1310888112326715990/figma-variable-explorer",
    liveLabel: "Open plugin",
    sourceUrl: "https://github.com/mnttnm/figma-variable-explorer",
    type: "Figma Plugin",
    highlight: "8,000+ users",
  },
  {
    title: "Tech Career Guide for CS Students",
    description:
      "An interactive career exploration tool covering 45+ tech career paths with salary benchmarks, personality-based matching, and structured learning roadmaps for Indian CS students.",
    image: "/projects/career-guide.webp",
    liveUrl: "https://tech-career-guide.vercel.app/",
    liveLabel: "Live app",
    sourceUrl:
      "https://github.com/mnttnm/btech-cs-career-guide-india",
    type: "Web App",
  },
  {
    title: "Notes in Google Docs",
    description:
      "Capture notes from anywhere on your Mac and store them directly in Google Docs. Create new documents, switch between them, and manage everything without leaving Raycast.",
    image: "/projects/notes-in-gdocs.webp",
    liveUrl: "https://www.raycast.com/tatermohit/note-in-google-doc",
    liveLabel: "Install extension",
    sourceUrl: "https://github.com/mnttnm/raycast-note-in-doc",
    type: "Raycast Extension",
    highlight: "1,000+ installs",
  },
];

const projectTotalLabel = String(spotlightProjects.length).padStart(
  2,
  "0"
);
---

<Layout
  title="Projects | Mohit Tater"
  description="Client work, side projects, and tools I've shipped — from AI-powered SaaS and enterprise apps to Shopify migrations and agent skills."
  mono
>
  <div data-variation-content="studio">
    <!-- Header -->
    <header class="studio-header">
      <div class="studio-header-inner">
        <a href="/" class="studio-logo">Mohit Tater</a>
        <nav class="studio-nav">
          <a href="/" class="studio-nav-link">Home</a>
          <a
            href="/projects"
            class="studio-nav-link studio-nav-link-active">Work</a
          >
          <a href="/about" class="studio-nav-link">About</a>
          <a
            href="#studio-footer"
            class="studio-nav-link studio-nav-cta"
            data-ph-cta="lets_talk"
            data-ph-location="nav">Let's talk</a
          >
        </nav>
        <button class="studio-menu-toggle" aria-label="Toggle menu">
          <span class="studio-menu-bar"></span>
          <span class="studio-menu-bar"></span>
        </button>
      </div>
    </header>

    <!-- Page Hero -->
    <section class="projects-hero" data-ph-section="projects_hero">
      <div class="studio-container">
        <h1 class="projects-headline studio-reveal">
          Selected <em>work.</em>
        </h1>
      </div>
    </section>

    <!-- Selected Work Browser -->
    <section
      class="projects-browser-section"
      aria-labelledby="selected-work-heading"
      data-ph-section="selected_work"
    >
      <div class="studio-container">
        <div class="work-browser studio-reveal" data-project-showcase>
          <div class="work-browser-topline">
            <p
              id="selected-work-heading"
              class="work-browser-kicker"
              data-project-title
              aria-live="polite"
            >
              {spotlightProjects[0].title}
            </p>
            <div class="work-browser-count" aria-live="polite">
              <span data-project-current>01</span>
              <span class="work-browser-count-divider">/</span>
              <span>{projectTotalLabel}</span>
            </div>
          </div>

          <div class="work-browser-shell">
            <!-- Visual panel -->
            <div class="work-visual-panel">
              <div class="work-visual-stage" aria-live="polite">
                {
                  spotlightProjects.map((project, i) => {
                    const hasImages =
                      project.images && project.images.length > 0;
                    return (
                      <div
                        class={`work-visual-set ${i === 0 ? "is-active" : ""}`}
                        data-project-visual
                        data-project-index={i}
                        aria-hidden={i === 0 ? "false" : "true"}
                      >
                        {hasImages ? (
                          project.images.map((img, j) => (
                            <button
                              type="button"
                              class={`work-visual-img ${j === 0 ? "is-active" : ""}`}
                              data-screenshot-index={j}
                              data-lightbox-open
                              aria-label={`View screenshot ${j + 1} of ${project.title} full-size`}
                            >
                              <img
                                src={img}
                                alt={`Screenshot ${j + 1} of ${project.title}`}
                                loading={
                                  i === 0 && j === 0
                                    ? "eager"
                                    : "lazy"
                                }
                              />
                            </button>
                          ))
                        ) : (
                          <div
                            class={`work-visual-img work-visual-placeholder grad-${project.gradient} is-active`}
                            data-screenshot-index="0"
                          >
                            <span class="work-visual-placeholder-label">
                              {project.title}
                            </span>
                          </div>
                        )}
                      </div>
                    );
                  })
                }
              </div>

              <!-- Screenshot thumbs (only show when project has 2+ images) -->
              <div
                class="work-screenshot-thumbs"
                data-screenshot-thumbs
                aria-label="Choose a screenshot"
              >
                {
                  spotlightProjects.map((project, i) => {
                    const imageCount = project.images?.length || 0;
                    return (
                      <div
                        class={`work-thumb-set ${i === 0 ? "is-active" : ""}`}
                        data-thumb-set
                        data-project-index={i}
                        data-image-count={imageCount}
                      >
                        {imageCount >= 2 &&
                          project.images.map((img, j) => (
                            <button
                              type="button"
                              class={`work-screenshot-thumb ${j === 0 ? "is-active" : ""}`}
                              data-screenshot-thumb
                              data-screenshot-index={j}
                              aria-label={`Screenshot ${j + 1}`}
                            >
                              <img src={img} alt="" loading="lazy" />
                            </button>
                          ))}
                      </div>
                    );
                  })
                }
              </div>
            </div>

            <!-- Detail panel (with flip card) -->
            <div class="work-detail-panel" data-detail-panel>
              <div class="work-detail-flipper" data-flipper>
                <!-- FRONT -->
                <div class="work-detail-face work-detail-face-front">
                  {
                    spotlightProjects.map((project, i) => {
                      const hasCaseStudy = !!project.caseStudyUrl;
                      const hasLive =
                        !!project.liveUrl &&
                        project.liveUrl !== project.sourceUrl;
                      return (
                        <article
                          class={`work-project ${i === 0 ? "is-active" : ""}`}
                          data-project-detail
                          data-project-index={i}
                          data-project-id={project.id}
                          data-project-title={project.title}
                          aria-hidden={i === 0 ? "false" : "true"}
                        >
                          <div class="work-project-header">
                            <span class="work-project-type">
                              {project.type}
                            </span>
                            <button
                              type="button"
                              class="work-flip-top"
                              data-flip-button
                              data-flip-target="back"
                              aria-label={`See more details about ${project.title}`}
                            >
                              <svg
                                width="13"
                                height="13"
                                viewBox="0 0 14 14"
                                fill="none"
                                aria-hidden="true"
                              >
                                <path
                                  d="M3 5h6M3 9h4M11 3v8"
                                  stroke="currentColor"
                                  stroke-width="1.4"
                                  stroke-linecap="round"
                                />
                              </svg>
                              <span>More details</span>
                            </button>
                          </div>

                          <h2 class="work-project-title">
                            {project.title}
                          </h2>

                          <div class="work-outcome">
                            <span
                              class="work-outcome-icon"
                              aria-hidden="true"
                            >
                              <svg
                                width="14"
                                height="14"
                                viewBox="0 0 14 14"
                                fill="none"
                              >
                                <path
                                  d="M3 7L6 10L11 4"
                                  stroke="currentColor"
                                  stroke-width="2"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                />
                              </svg>
                            </span>
                            <span>{project.outcome}</span>
                          </div>

                          <p class="work-project-description">
                            {project.description}
                          </p>

                          <div class="work-tech-list">
                            {project.tech.map((t) => (
                              <span class="work-tech-pill">{t}</span>
                            ))}
                          </div>

                          <div class="work-actions">
                            {hasCaseStudy && (
                              <a
                                href={project.caseStudyUrl}
                                class="work-action work-action-primary"
                                data-ph-action="case_study"
                                data-ph-project={project.id}
                              >
                                {project.caseStudyLabel ||
                                  "Read the case study"}
                                <span aria-hidden="true">&rarr;</span>
                              </a>
                            )}
                            {hasLive && (
                              <a
                                href={project.liveUrl}
                                target="_blank"
                                rel="noopener"
                                class={`work-action ${hasCaseStudy ? "" : "work-action-primary"}`}
                                data-ph-action="demo"
                                data-ph-project={project.id}
                              >
                                {project.liveLabel}
                                <span aria-hidden="true">&rarr;</span>
                              </a>
                            )}
                            {project.sourceUrl && (
                              <a
                                href={project.sourceUrl}
                                target="_blank"
                                rel="noopener"
                                class={`work-action ${hasCaseStudy || hasLive ? "" : "work-action-primary"}`}
                                data-ph-action="github"
                                data-ph-project={project.id}
                              >
                                {hasCaseStudy || hasLive
                                  ? "GitHub"
                                  : "View on GitHub"}
                                <span aria-hidden="true">&rarr;</span>
                              </a>
                            )}
                            {!hasCaseStudy &&
                              !hasLive &&
                              !project.sourceUrl &&
                              project.note && (
                                <p class="work-action-note">
                                  <span
                                    class="work-action-note-icon"
                                    aria-hidden="true"
                                  >
                                    <svg
                                      width="13"
                                      height="13"
                                      viewBox="0 0 14 14"
                                      fill="none"
                                    >
                                      <path
                                        d="M7 1.5a3 3 0 0 1 3 3v1.5H4V4.5a3 3 0 0 1 3-3Z"
                                        stroke="currentColor"
                                        stroke-width="1.2"
                                        stroke-linejoin="round"
                                      />
                                      <rect
                                        x="2.75"
                                        y="6"
                                        width="8.5"
                                        height="6"
                                        rx="1.2"
                                        stroke="currentColor"
                                        stroke-width="1.2"
                                      />
                                    </svg>
                                  </span>
                                  {project.note}
                                </p>
                              )}
                          </div>
                        </article>
                      );
                    })
                  }
                </div>

                <!-- BACK -->
                <div class="work-detail-face work-detail-face-back">
                  {
                    spotlightProjects.map((project, i) => (
                      <article
                        class={`work-project-back ${i === 0 ? "is-active" : ""}`}
                        data-project-back
                        data-project-index={i}
                        aria-hidden="true"
                      >
                        <div class="work-back-header">
                          <span class="work-back-eyebrow">
                            {project.title}
                          </span>
                          <button
                            type="button"
                            class="work-back-close"
                            data-flip-button
                            data-flip-target="front"
                            aria-label="Back to project overview"
                          >
                            <svg
                              width="14"
                              height="14"
                              viewBox="0 0 14 14"
                              fill="none"
                            >
                              <path
                                d="M10 7H2M6 3L2 7l4 4"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                            <span>Back</span>
                          </button>
                        </div>

                        <h3 class="work-back-title">
                          {project.back.title}
                        </h3>

                        <div class="work-back-sections">
                          {project.back.sections.map((section) => (
                            <div class="work-back-section">
                              <h4>{section.heading}</h4>
                              <p>{section.body}</p>
                            </div>
                          ))}
                        </div>
                      </article>
                    ))
                  }
                </div>
              </div>

              <!-- Project navigation (bottom of detail panel) -->
              <div
                class="work-project-nav"
                aria-label="Project navigation"
              >
                <div class="work-dots" data-dots>
                  {
                    spotlightProjects.map((project, i) => (
                      <button
                        type="button"
                        class={`work-dot ${i === 0 ? "is-active" : ""}`}
                        data-project-dot
                        data-project-index={i}
                        aria-pressed={i === 0 ? "true" : "false"}
                        aria-label={`Show ${project.title}`}
                      >
                        <span class="visually-hidden">{i + 1}</span>
                      </button>
                    ))
                  }
                </div>
                <div class="work-arrows">
                  <button
                    type="button"
                    class="work-arrow"
                    data-project-prev
                    aria-label="Previous project">&larr;</button
                  >
                  <button
                    type="button"
                    class="work-arrow"
                    data-project-next
                    aria-label="Next project">&rarr;</button
                  >
                </div>
              </div>
            </div>
          </div>

          <!-- ===== Mobile stacked list (shown ≤900px) =====
               The desktop "browser" above is a one-at-a-time carousel that's
               easy to skip on a phone — the arrows go unnoticed and only one
               project is ever visible. On mobile we hide it and render every
               spotlight project as a self-contained, scrollable card instead,
               so the whole set is discoverable by scrolling. -->
          <!-- ===== Mobile spotlight deck (shown ≤900px) =====
               On phones the desktop carousel is hidden; spotlight projects live
               in a swipeable deck. Tapping the focal card opens a bottom-sheet
               with the full detail (markup near the footer below). -->
          <div class="mspot" data-mspot>
            <div class="mspot-head">
              <div class="mspot-status">
                <span class="mspot-pos"
                  ><span data-mspot-pos>01</span><span class="mspot-sep"
                    >/</span
                  ><span class="mspot-tot">{projectTotalLabel}</span></span
                >
                <span class="mspot-cur-type" data-mspot-curtype
                  >{spotlightProjects[0].type}</span
                >
              </div>
            </div>

            <div class="mspot-deck" data-mspot-deck>
              {
                spotlightProjects.map((project, i) => {
                  const hasImages =
                    project.images && project.images.length > 0;
                  return (
                    <article
                      class={`mspot-card ${i === 0 ? "is-focus" : ""}`}
                      data-mspot-card
                      data-mspot-index={i}
                    >
                      <div class="mspot-media">
                        {hasImages ? (
                          <img
                            src={project.images[0]}
                            alt={`${project.title} screenshot`}
                            loading={i < 2 ? "eager" : "lazy"}
                          />
                        ) : (
                          <span
                            class={`mspot-media-ph grad-${project.gradient}`}
                          >
                            {project.title}
                          </span>
                        )}
                      </div>
                      <div class="mspot-foot">
                        <div class="mspot-foot-top">
                          <span class="mspot-card-eyebrow">
                            {project.type}
                          </span>
                          <span class="mspot-open" aria-hidden="true">
                            <svg
                              width="15"
                              height="15"
                              viewBox="0 0 16 16"
                              fill="none"
                            >
                              <path
                                d="M5 11L11 5M5 5h6v6"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                          </span>
                        </div>
                        <h3 class="mspot-card-title">{project.title}</h3>
                        <p class="mspot-card-outcome">{project.outcome}</p>
                      </div>
                    </article>
                  );
                })
              }
            </div>

            <div class="mspot-dots" data-mspot-dots>
              {
                spotlightProjects.map((project, i) => (
                  <button
                    type="button"
                    class={`mspot-dot ${i === 0 ? "is-active" : ""}`}
                    data-mspot-dot
                    data-mspot-index={i}
                    aria-label={`Show ${project.title}`}
                  />
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- More projects -->
    <section
      class="more-projects-section"
      aria-labelledby="more-projects-heading"
      data-ph-section="more_projects"
    >
      <div class="studio-container">
        <div class="more-projects-header studio-reveal">
          <h2
            id="more-projects-heading"
            class="more-projects-heading"
          >
            More projects
          </h2>
          <p class="more-projects-subtext">
            Side projects, explorations, and open-source tools built
            in my own time.
          </p>
        </div>

        <div class="more-projects-grid">
          {
            moreProjects.map((project) => (
              <a
                href={project.liveUrl}
                target="_blank"
                rel="noopener"
                class="more-project studio-reveal"
              >
                <div class="more-project-image">
                  <img
                    src={project.image}
                    alt={`${project.title} screenshot`}
                    loading="lazy"
                  />
                </div>
                <div class="more-project-body">
                  <div class="more-project-meta">
                    <span>{project.type}</span>
                    {project.highlight && (
                      <>
                        <span class="more-project-meta-separator">
                          /
                        </span>
                        <strong>{project.highlight}</strong>
                      </>
                    )}
                  </div>
                  <h3 class="more-project-title">{project.title}</h3>
                  <p class="more-project-description">
                    {project.description}
                  </p>
                  <span class="more-project-cta">
                    {project.liveLabel}
                    <span aria-hidden="true">&rarr;</span>
                  </span>
                </div>
              </a>
            ))
          }
        </div>

        <!-- Mobile More-projects card list (shown ≤900px) -->
        <div class="mmore">
          <div class="mmore-card">
            {
              moreProjects.map((project) => (
                <a
                  class="mmore-row"
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener"
                  data-ph-action="more_project"
                  data-ph-project={project.title}
                >
                  <span class="mmore-thumb">
                    <img src={project.image} alt="" loading="lazy" />
                  </span>
                  <span class="mmore-mid">
                    <span class="mmore-title">{project.title}</span>
                    <span class="mmore-blurb">{project.description}</span>
                    <span class="mmore-meta">
                      <span class="mmore-type">{project.type}</span>
                      {project.highlight && (
                        <span class="mmore-badge">{project.highlight}</span>
                      )}
                    </span>
                  </span>
                  <span class="mmore-cta">
                    {project.liveLabel.split(" ")[0]}
                    <svg
                      width="13"
                      height="13"
                      viewBox="0 0 14 14"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M3 7h8M7 3l4 4-4 4"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Lightbox -->
    <div
      class="lightbox"
      data-lightbox
      hidden
      role="dialog"
      aria-modal="true"
      aria-label="Screenshot viewer"
    >
      <button
        type="button"
        class="lightbox-close"
        data-lightbox-close
        aria-label="Close viewer"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M5 5l10 10M15 5L5 15"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"></path>
        </svg>
      </button>
      <button
        type="button"
        class="lightbox-arrow lightbox-arrow-prev"
        data-lightbox-prev
        aria-label="Previous screenshot"
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 22 22"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M14 4L7 11l7 7"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
      <div class="lightbox-stage">
        <img data-lightbox-img alt="" />
        <p class="lightbox-caption" data-lightbox-caption></p>
      </div>
      <button
        type="button"
        class="lightbox-arrow lightbox-arrow-next"
        data-lightbox-next
        aria-label="Next screenshot"
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 22 22"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M8 4l7 7-7 7"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile spotlight: detail bottom-sheet + lightbox (≤900px) -->
    <div class="mspot-scrim" data-mspot-scrim></div>
    <div class="mspot-sheet" data-mspot-sheet>
      <button
        type="button"
        class="mspot-close"
        data-mspot-close
        aria-label="Close details"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 14 14"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M4 4l6 6M10 4l-6 6"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
      </button>
      <div class="mspot-grab"><span></span></div>
      <div class="mspot-sheet-body" data-mspot-sheet-body></div>
    </div>
    <div class="mspot-lb" data-mspot-lb>
      <button
        type="button"
        class="mspot-lb-btn mspot-lb-close"
        data-mspot-lb-close
        aria-label="Close"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 20 20"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M5 5l10 10M15 5L5 15"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"></path>
        </svg>
      </button>
      <img data-mspot-lb-img alt="" />
      <p class="mspot-lb-cap" data-mspot-lb-cap></p>
      <div class="mspot-lb-ctrls">
        <button
          type="button"
          class="mspot-lb-btn"
          data-mspot-lb-prev
          aria-label="Previous screenshot"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 22 22"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M14 4L7 11l7 7"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
        <button
          type="button"
          class="mspot-lb-btn"
          data-mspot-lb-next
          aria-label="Next screenshot"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 22 22"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M8 4l7 7-7 7"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>

    <StudioFooter />
  </div>
</Layout>

<style>
  /* ===== Studio Variation Palette (shared) ===== */
  [data-variation-content="studio"] {
    --studio-bg: #faf8f5;
    --studio-bg-header: rgba(250, 248, 245, 0.95);
    --studio-text: #1a1a1a;
    --studio-text-body: #4a4a4a;
    --studio-text-muted: #8a8a8a;
    --studio-accent: #2d5a3d;
    --studio-accent-light: rgba(45, 90, 61, 0.08);
    --studio-border: #e5e0da;
    --studio-serif: "DM Serif Display", Georgia, serif;
    --studio-sans: "Instrument Sans", -apple-system,
      BlinkMacSystemFont, sans-serif;
  }

  [data-variation-content="studio"] {
    background: var(--studio-bg);
    color: var(--studio-text);
    font-family: var(--studio-sans);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  /* ===== Container ===== */
  .studio-container {
    max-width: var(--site-container-max);
    margin: 0 auto;
    padding: 0 var(--site-container-padding);
  }

  /* ===== Visually hidden ===== */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ===== Reveal Animation ===== */
  .studio-reveal {
    opacity: 0;
    transform: translateY(16px);
    animation: studioReveal 0.7s cubic-bezier(0.23, 1, 0.32, 1)
      forwards;
  }

  .studio-reveal:nth-child(1) {
    animation-delay: 0.05s;
  }
  .studio-reveal:nth-child(2) {
    animation-delay: 0.12s;
  }
  .studio-reveal:nth-child(3) {
    animation-delay: 0.19s;
  }
  .studio-reveal:nth-child(4) {
    animation-delay: 0.26s;
  }

  @keyframes studioReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ===== Section Label ===== */
  .studio-section-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--studio-text-muted);
    margin-bottom: 24px;
  }

  /* ===== Header ===== */
  .studio-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--studio-bg-header);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--studio-border);
  }

  .studio-header-inner {
    max-width: var(--site-container-max);
    margin: 0 auto;
    padding: 0 var(--site-container-padding);
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .studio-logo {
    font-family: var(--studio-serif);
    font-size: 1.15rem;
    color: var(--studio-text);
    text-decoration: none;
    letter-spacing: 0;
  }

  .studio-nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .studio-nav-link {
    font-size: 0.85rem;
    color: var(--studio-text-body);
    text-decoration: none;
    transition: color 0.2s;
  }

  .studio-nav-link:hover {
    color: var(--studio-text);
  }
  .studio-nav-link-active {
    color: var(--studio-text);
    font-weight: 600;
  }
  .studio-nav-cta {
    color: var(--studio-accent);
    font-weight: 600;
  }

  .studio-menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .studio-menu-bar {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--studio-text);
    transition: transform 0.3s;
  }

  /* ===== Projects Hero ===== */
  .projects-hero {
    padding: 132px 0 28px;
  }

  .projects-headline {
    font-family: var(--studio-serif);
    font-size: clamp(2.2rem, 4.6vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: 0;
    color: var(--studio-text);
    margin-bottom: 20px;
    max-width: 920px;
    text-wrap: balance;
  }

  .projects-headline em {
    font-style: italic;
    color: var(--studio-accent);
  }

  .projects-subtext {
    font-size: 1.05rem;
    color: var(--studio-text-body);
    line-height: 1.7;
    max-width: 600px;
  }

  /* ===== Selected Work Browser ===== */
  .projects-browser-section {
    padding: 4px 0 96px;
  }

  .work-browser {
    display: grid;
    gap: 16px;
    transform-origin: center top;
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Anticipation: the whole unit lifts AND slightly scales — combining spatial
     and depth cues so the motion reads even without a relative reference. */
  .work-browser.is-anticipating {
    transform: translateY(-12px) scale(1.008);
  }

  .work-browser-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .work-browser-kicker {
    color: var(--studio-text);
    font-family: var(--studio-serif);
    font-size: 1.05rem;
    font-weight: 400;
    letter-spacing: 0;
    transition: opacity 0.18s ease;
  }

  .work-browser-kicker.is-swapping {
    opacity: 0;
  }

  .work-browser-count {
    color: var(--studio-text-muted);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }

  .work-browser-count [data-project-current] {
    color: var(--studio-text);
    font-weight: 600;
  }

  .work-browser-count-divider {
    color: var(--studio-border);
    padding: 0 4px;
  }

  /* Fixed-dimension shell — no layout shift on switch */
  .work-browser-shell {
    display: grid;
    grid-template-columns: 58fr 42fr;
    min-height: clamp(620px, 82vh, 860px);
    overflow: hidden;
    background: radial-gradient(
        circle at 12% 10%,
        rgba(45, 90, 61, 0.08),
        transparent 30%
      ),
      rgba(255, 255, 255, 0.55);
    border: 1px solid var(--studio-border);
    border-radius: 0;
    box-shadow: 0 24px 70px rgba(30, 45, 36, 0.08);
    transition:
      box-shadow 0.45s cubic-bezier(0.34, 1.2, 0.64, 1),
      border-color 0.45s ease,
      background 0.45s ease;
  }

  /* Non-spatial cues during anticipation:
     - shadow grows dramatically (high-contrast, very readable)
     - border gains an accent green hint
     - the inner radial gradient brightens — the panel "warms up" */
  .work-browser.is-anticipating .work-browser-shell {
    box-shadow: 0 54px 130px rgba(45, 90, 61, 0.26);
    border-color: rgba(45, 90, 61, 0.4);
    background: radial-gradient(
        circle at 12% 10%,
        rgba(45, 90, 61, 0.22),
        transparent 38%
      ),
      rgba(255, 255, 255, 0.6);
  }

  /* The active project dot pulses — gives the eye a small, contained
     reference point of motion inside the panel itself. */
  @keyframes dotPulse {
    0% {
      box-shadow: 0 0 0 0 rgba(45, 90, 61, 0.45);
    }
    100% {
      box-shadow: 0 0 0 10px rgba(45, 90, 61, 0);
    }
  }

  .work-browser.is-anticipating .work-dot.is-active {
    animation: dotPulse 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* ===== Visual panel (left) ===== */
  .work-visual-panel {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 18px;
    padding: 48px;
    background: #eef1ed;
    border-right: 1px solid var(--studio-border);
    min-height: 0;
  }

  .work-visual-stage {
    position: relative;
    min-height: 0;
    display: grid;
    place-items: center;
  }

  .work-visual-set {
    display: none;
    width: 100%;
    height: 100%;
  }
  .work-visual-set.is-active {
    display: grid;
    place-items: center;
    animation: workReveal 0.45s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .work-visual-img {
    display: none;
    width: 100%;
    max-width: 720px;
    aspect-ratio: 16 / 10;
    padding: 0;
    color: inherit;
    text-decoration: none;
    background: #f6f7f4;
    border: 1px solid rgba(26, 26, 26, 0.1);
    border-radius: 4px;
    box-shadow: 0 22px 52px rgba(30, 45, 36, 0.18);
    overflow: hidden;
    outline-offset: 8px;
    cursor: zoom-in;
    font-family: inherit;
    transition: transform 0.35s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .work-visual-img.is-active {
    display: block;
  }

  .work-visual-img img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .work-visual-img:hover {
    transform: translateY(-3px);
  }

  /* Placeholder when project has no images yet */
  .work-visual-placeholder {
    display: none;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 720px;
    aspect-ratio: 16 / 10;
    border: 1px solid rgba(26, 26, 26, 0.1);
    border-radius: 4px;
    box-shadow: 0 22px 52px rgba(30, 45, 36, 0.18);
    color: rgba(26, 26, 26, 0.35);
    font-family: var(--studio-serif);
    font-size: clamp(1.4rem, 3vw, 2rem);
    letter-spacing: 0.02em;
  }

  .work-visual-placeholder.is-active {
    display: flex;
  }

  .grad-slicely {
    background: linear-gradient(
      135deg,
      #c8d6c1 0%,
      #a8bfa0 50%,
      #8aab7e 100%
    );
  }
  .grad-ops-workspace {
    background: linear-gradient(
      135deg,
      #d4c5b0 0%,
      #bfad96 50%,
      #a89578 100%
    );
  }
  .grad-greetwood {
    background: linear-gradient(
      135deg,
      #c2cfd4 0%,
      #9fb3bc 50%,
      #7d9aa6 100%
    );
  }
  .grad-ai-toolkit {
    background: linear-gradient(
      135deg,
      #d1c4d8 0%,
      #b5a3bf 50%,
      #9a83a8 100%
    );
  }
  .grad-reviewhub {
    background: linear-gradient(
      135deg,
      #d6c0c1 0%,
      #c09a9d 50%,
      #a87478 100%
    );
  }
  .grad-image-resizing {
    background: linear-gradient(
      135deg,
      #c3cee0 0%,
      #9fb0d4 50%,
      #7e92c2 100%
    );
  }

  /* Screenshot thumbs — only shown when 2+ images per project */
  .work-screenshot-thumbs {
    min-height: 0;
  }

  .work-thumb-set {
    display: none;
    gap: 8px;
  }
  .work-thumb-set.is-active {
    display: flex;
  }
  .work-thumb-set[data-image-count="0"],
  .work-thumb-set[data-image-count="1"] {
    display: none !important;
  }

  .work-screenshot-thumb {
    flex: 1;
    max-width: 180px;
    aspect-ratio: 16 / 10;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 6px;
    background: rgba(250, 248, 245, 0.6);
    cursor: zoom-in;
    overflow: hidden;
    opacity: 0.7;
    transition:
      opacity 0.2s,
      border-color 0.2s,
      transform 0.2s;
  }

  .work-screenshot-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .work-screenshot-thumb:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .work-screenshot-thumb.is-active {
    opacity: 1;
    border-color: var(--studio-accent);
  }

  /* ===== Detail panel (right) with flip ===== */
  .work-detail-panel {
    position: relative;
    perspective: 1600px;
    min-width: 0;
    padding: 0;
    background: rgba(255, 255, 255, 0.6);
  }

  .work-detail-flipper {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.65s cubic-bezier(0.6, 0.05, 0.25, 1);
  }

  .work-detail-panel.is-flipped .work-detail-flipper {
    transform: rotateY(180deg);
  }

  .work-detail-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    padding: 64px 60px 96px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow-y: auto;
  }

  .work-detail-face-back {
    transform: rotateY(180deg);
    justify-content: flex-start;
    padding-top: 52px;
  }

  /* Front face content */
  .work-project {
    display: none;
  }
  .work-project.is-active {
    display: block;
    animation: workReveal 0.38s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .work-project-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }

  .work-project-type {
    color: var(--studio-text-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .work-flip-top {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    color: var(--studio-text-body);
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid var(--studio-border);
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      color 0.2s,
      border-color 0.2s,
      background 0.2s,
      transform 0.2s;
    font-family: inherit;
  }

  .work-flip-top:hover {
    color: var(--studio-accent);
    border-color: rgba(45, 90, 61, 0.32);
    transform: translateY(-1px);
  }

  .work-flip-top svg {
    opacity: 0.7;
  }

  /* Late entry — the button fades in slightly after the rest of the project
     content has revealed, on initial load and on every project switch. */
  @keyframes flipReveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .work-project.is-active .work-flip-top {
    animation: flipReveal 0.45s cubic-bezier(0.23, 1, 0.32, 1) 0.55s
      both;
  }

  .work-project-title {
    margin-bottom: 16px;
    color: var(--studio-text);
    font-family: var(--studio-serif);
    font-size: 31px;
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.005em;
    text-wrap: balance;
  }

  .work-outcome {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
    padding: 7px 12px;
    background: var(--studio-accent-light);
    border: 1px solid rgba(45, 90, 61, 0.15);
    border-radius: 999px;
    color: var(--studio-accent);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .work-outcome-icon {
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    color: var(--studio-accent);
  }

  .work-project-description {
    max-width: 460px;
    margin-bottom: 22px;
    color: var(--studio-text-body);
    font-size: 0.95rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .work-tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 26px;
    list-style: none;
  }

  .work-tech-pill {
    padding: 5px 9px;
    color: var(--studio-text-body);
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid var(--studio-border);
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1;
  }

  .work-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .work-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 40px;
    padding: 10px 16px;
    color: var(--studio-text);
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid var(--studio-border);
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    transition:
      background 0.2s,
      border-color 0.2s,
      color 0.2s,
      transform 0.2s;
    font-family: inherit;
  }

  .work-action:hover {
    color: var(--studio-accent);
    border-color: rgba(45, 90, 61, 0.35);
    transform: translateY(-1px);
  }

  .work-action-primary {
    color: #fff;
    background: var(--studio-accent);
    border-color: var(--studio-accent);
  }

  .work-action-primary:hover {
    color: #fff;
    background: #234a31;
    border-color: #234a31;
  }

  .work-action-flip svg {
    transition: transform 0.2s;
  }
  .work-action-flip:hover svg {
    transform: translateX(2px);
  }

  /* Shown in place of action buttons when a project has no public links */
  .work-action-note {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 10px 14px;
    color: var(--studio-text-muted);
    background: rgba(0, 0, 0, 0.025);
    border: 1px dashed var(--studio-border);
    border-radius: 4px;
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .work-action-note-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    color: var(--studio-text-muted);
    opacity: 0.75;
  }

  /* Back face content */
  .work-project-back {
    display: none;
  }
  .work-project-back.is-active {
    display: block;
    animation: workReveal 0.38s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .work-back-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .work-back-eyebrow {
    color: var(--studio-text-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .work-back-close {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    color: var(--studio-text-body);
    background: transparent;
    border: 1px solid var(--studio-border);
    border-radius: 4px;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s,
      border-color 0.2s;
    font-family: inherit;
  }

  .work-back-close:hover {
    color: var(--studio-accent);
    border-color: rgba(45, 90, 61, 0.35);
  }

  .work-back-title {
    margin-bottom: 22px;
    color: var(--studio-text);
    font-family: var(--studio-serif);
    font-size: 1.4rem;
    font-weight: 400;
    line-height: 1.15;
  }

  .work-back-sections {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .work-back-section h4 {
    margin-bottom: 6px;
    color: var(--studio-text);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0;
  }

  .work-back-section p {
    color: var(--studio-text-body);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  /* Project nav (dots + arrows) */
  .work-project-nav {
    position: absolute;
    left: 60px;
    right: 60px;
    bottom: 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 5;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
  }

  /* Hide project nav when viewing back face — back face has its own "Back" button */
  .work-detail-panel.is-flipped .work-project-nav {
    opacity: 0;
    visibility: hidden;
  }

  .work-dots {
    display: flex;
    gap: 8px;
  }

  .work-dot {
    width: 8px;
    height: 8px;
    padding: 0;
    background: var(--studio-border);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    transition:
      width 0.25s,
      background 0.25s,
      border-radius 0.25s;
  }

  .work-dot.is-active {
    width: 22px;
    background: var(--studio-accent);
    border-radius: 4px;
  }

  .work-arrows {
    display: flex;
    gap: 6px;
  }

  .work-arrow {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    color: var(--studio-text);
    background: #fff;
    border: 1px solid var(--studio-border);
    border-radius: 999px;
    cursor: pointer;
    font-family: var(--studio-sans);
    font-size: 0.95rem;
    transition:
      background 0.2s,
      border-color 0.2s,
      color 0.2s,
      transform 0.2s;
  }

  .work-arrow:hover {
    color: #fff;
    background: var(--studio-accent);
    border-color: var(--studio-accent);
  }

  .work-arrow:active {
    transform: translateY(1px);
  }

  /* Focus styles */
  .work-screenshot-thumb:focus-visible,
  .work-arrow:focus-visible,
  .work-action:focus-visible,
  .work-visual-img:focus-visible,
  .work-back-close:focus-visible,
  .work-dot:focus-visible {
    outline: 2px solid var(--studio-accent);
    outline-offset: 3px;
  }

  @keyframes workReveal {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ===== More Projects ===== */
  .more-projects-section {
    padding: 24px 0 120px;
  }

  .more-projects-header {
    margin-bottom: 36px;
    max-width: 580px;
  }

  .more-projects-heading {
    margin-bottom: 10px;
    color: var(--studio-text);
    font-family: var(--studio-serif);
    font-size: clamp(1.6rem, 3vw, 2rem);
    font-weight: 400;
    line-height: 1.15;
  }

  .more-projects-subtext {
    color: var(--studio-text-body);
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .more-projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }

  .more-project {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid var(--studio-border);
    border-radius: 6px;
    transition:
      transform 0.25s cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 0.25s cubic-bezier(0.23, 1, 0.32, 1),
      border-color 0.25s;
  }

  .more-project:hover {
    transform: translateY(-3px);
    border-color: rgba(45, 90, 61, 0.32);
    box-shadow: 0 18px 40px rgba(30, 45, 36, 0.1);
  }

  .more-project-image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #eef1ed;
    border-bottom: 1px solid var(--studio-border);
  }

  .more-project-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .more-project:hover .more-project-image img {
    transform: scale(1.03);
  }

  .more-project-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 22px 22px;
  }

  .more-project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    color: var(--studio-text-muted);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .more-project-meta strong {
    color: var(--studio-accent);
    font: inherit;
  }

  .more-project-meta-separator {
    color: var(--studio-border);
  }

  .more-project-title {
    color: var(--studio-text);
    font-family: var(--studio-serif);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.2;
  }

  .more-project-description {
    color: var(--studio-text-body);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .more-project-cta {
    margin-top: 8px;
    color: var(--studio-accent);
    font-size: 0.82rem;
    font-weight: 600;
  }

  /* ===== Lightbox ===== */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 48px;
    background: rgba(15, 20, 18, 0.88);
    backdrop-filter: blur(6px);
    animation: lightboxFadeIn 0.2s ease;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox-stage {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .lightbox-stage img {
    display: block;
    max-width: 100%;
    max-height: 86vh;
    object-fit: contain;
    border-radius: 6px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
    animation: lightboxImgIn 0.25s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .lightbox-caption {
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.82rem;
    font-family: ui-monospace, monospace;
    font-variant-numeric: tabular-nums;
  }

  .lightbox-close,
  .lightbox-arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    cursor: pointer;
    transition:
      background 0.2s,
      transform 0.2s;
  }

  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 20px;
  }

  .lightbox-arrow {
    flex-shrink: 0;
  }

  .lightbox-close:hover,
  .lightbox-arrow:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  .lightbox-arrow:active {
    transform: scale(0.94);
  }

  .lightbox-close:focus-visible,
  .lightbox-arrow:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  @keyframes lightboxFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes lightboxImgIn {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Hide page scroll when lightbox open */
  body.lightbox-open {
    overflow: hidden;
  }

  /* ===== Mobile spotlight list =====
     Rendered into the DOM always, but only displayed at <=900px (see the
     responsive block below). Each spotlight project becomes a full, scrollable
     card so the whole set is browsable by scrolling — no carousel, no arrows. */
  .work-mobile-intro {
    display: none;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 22px;
  }

  .work-mobile-intro-label {
    color: var(--studio-accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .work-mobile-intro-count {
    color: var(--studio-text-muted);
    font-size: 0.85rem;
  }

  .work-mobile-list {
    display: none;
    grid-template-columns: 1fr;
    gap: 28px;
  }

  .m-project {
    overflow: hidden;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid var(--studio-border);
    border-radius: 10px;
    box-shadow: 0 12px 34px rgba(30, 45, 36, 0.06);
  }

  /* Horizontal, swipeable screenshot gallery. The 86% basis lets the next
     screenshot peek in, signalling "there's more — swipe". */
  .m-project-gallery {
    display: flex;
    gap: 10px;
    padding: 14px 14px 4px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .m-project-gallery::-webkit-scrollbar {
    display: none;
  }
  .m-project-gallery.is-single {
    padding-bottom: 14px;
  }

  .m-project-shot {
    flex: 0 0 86%;
    scroll-snap-align: center;
    aspect-ratio: 16 / 10;
    margin: 0;
    padding: 0;
    background: #eef1ed;
    border: 1px solid rgba(26, 26, 26, 0.1);
    border-radius: 6px;
    overflow: hidden;
    cursor: zoom-in;
    font-family: inherit;
  }
  .m-project-gallery.is-single .m-project-shot {
    flex-basis: 100%;
  }

  .m-project-shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .m-project-shot-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    color: rgba(26, 26, 26, 0.4);
    font-family: var(--studio-serif);
    font-size: 1.3rem;
    text-align: center;
    cursor: default;
  }

  .m-project-gallery-hint {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px 0;
    color: var(--studio-text-muted);
    font-size: 0.74rem;
    letter-spacing: 0.01em;
  }
  .m-project-gallery-hint span {
    font-size: 0.95rem;
    line-height: 1;
  }

  .m-project-body {
    padding: 18px 18px 20px;
  }

  .m-project-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  .m-project-type {
    color: var(--studio-text-muted);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .m-project-count {
    color: var(--studio-text-muted);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .m-project-title {
    margin-bottom: 14px;
    color: var(--studio-text);
    font-family: var(--studio-serif);
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.005em;
    text-wrap: balance;
  }

  .m-project-outcome {
    margin-bottom: 16px;
  }

  .m-project-description {
    margin-bottom: 18px;
    color: var(--studio-text-body);
    font-size: 0.95rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .m-project-tech {
    margin-bottom: 18px;
  }

  .m-project-actions {
    margin-bottom: 4px;
  }
  .m-project-actions .work-action {
    flex: 1 1 auto;
  }

  /* "More details" disclosure — replaces the desktop 3D flip with a tap-to-
     expand panel so the deeper write-up is surfaced on demand, not in the way. */
  .m-project-more {
    margin-top: 16px;
    border-top: 1px solid var(--studio-border);
  }

  .m-project-more-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 2px 2px;
    color: var(--studio-text);
    font-size: 0.9rem;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }
  .m-project-more-summary::-webkit-details-marker {
    display: none;
  }

  .m-project-more-chevron {
    flex-shrink: 0;
    color: var(--studio-text-muted);
    transition: transform 0.25s ease;
  }
  .m-project-more[open] .m-project-more-chevron {
    transform: rotate(180deg);
  }

  .m-project-more-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 14px 2px 4px;
  }

  .m-project-more-section h4 {
    margin-bottom: 5px;
    color: var(--studio-text);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .m-project-more-section p {
    color: var(--studio-text-body);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  /* ===== Responsive ===== */
  @media (max-width: 1080px) {
    .work-browser-shell {
      grid-template-columns: 60fr 40fr;
    }

    .work-visual-panel {
      padding: 36px;
    }

    .work-detail-face {
      padding: 56px 44px 88px;
    }

    .work-project-nav {
      left: 44px;
      right: 44px;
    }
  }

  @media (max-width: 900px) {
    /* Swap the desktop carousel for the scrollable mobile card list.
       Hide the desktop-only pieces individually — NOT the .work-browser
       wrapper, which also contains the mobile list. (display:none on the
       wrapper would take the mobile cards down with it.) */
    .work-browser-topline,
    .work-browser-shell {
      display: none;
    }
    /* Swap desktop carousel → mobile deck, and desktop grid → mobile list */
    .mspot {
      display: block;
    }
    .mspot-scrim {
      display: block;
    }
