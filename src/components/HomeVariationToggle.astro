---
// Floating preview toggle to compare the new home page (Concept A / V3)
// against the current one (V2). Switches which [data-home-pane] is shown.
---
<div class="home-vtoggle" id="home-vtoggle" role="group" aria-label="Preview: switch home page design">
  <span class="home-vtoggle-tag">Preview</span>
  <div class="home-vtoggle-inner">
    <button class="home-vtoggle-btn" data-home-variation="v3" type="button">New</button>
    <button class="home-vtoggle-btn" data-home-variation="v2" type="button">Current</button>
    <span class="home-vtoggle-indicator" id="home-vtoggle-indicator"></span>
  </div>
</div>

<style>
  .home-vtoggle {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9998;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 6px 5px 12px;
    background: rgba(26, 26, 26, 0.9);
    backdrop-filter: blur(16px) saturate(1.4);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 100px;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.32);
  }
  .home-vtoggle-tag {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }
  .home-vtoggle-inner { display: flex; position: relative; gap: 2px; }
  .home-vtoggle-btn {
    position: relative;
    z-index: 2;
    padding: 7px 18px;
    border: none;
    background: none;
    color: rgba(255, 255, 255, 0.55);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    border-radius: 100px;
    transition: color 0.3s;
    white-space: nowrap;
  }
  .home-vtoggle-btn:hover { color: rgba(255, 255, 255, 0.85); }
  .home-vtoggle-btn.active { color: #1a1a1a; }
  .home-vtoggle-indicator {
    position: absolute;
    top: 0; left: 0;
    height: 100%;
    background: #C8F56E;
    border-radius: 100px;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), width 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1;
  }

  @media (max-width: 480px) {
    .home-vtoggle { bottom: 14px; padding: 4px 5px 4px 10px; }
    .home-vtoggle-btn { padding: 6px 14px; font-size: 0.76rem; }
  }
</style>

<script>
  const toggle = document.getElementById('home-vtoggle');
  const indicator = document.getElementById('home-vtoggle-indicator');
  const buttons = toggle?.querySelectorAll('.home-vtoggle-btn') as NodeListOf<HTMLButtonElement>;
  const panes = document.querySelectorAll('[data-home-pane]') as NodeListOf<HTMLElement>;

  function moveIndicator(btn: HTMLButtonElement) {
    if (!indicator) return;
    indicator.style.width = `${btn.offsetWidth}px`;
    indicator.style.transform = `translateX(${btn.offsetLeft}px)`;
  }

  function setVariation(name: string) {
    buttons?.forEach((b) => b.classList.remove('active'));
    const activeBtn = toggle?.querySelector(`[data-home-variation="${name}"]`) as HTMLButtonElement | null;
    activeBtn?.classList.add('active');
    if (activeBtn) moveIndicator(activeBtn);

    panes.forEach((pane) => {
      pane.style.display = pane.dataset.homePane === name ? 'block' : 'none';
    });

    localStorage.setItem('home-variation', name);
  }

  const saved = localStorage.getItem('home-variation') || 'v3';
  // Set without animating the indicator on first paint.
  if (indicator) indicator.style.transition = 'none';
  setVariation(saved);
  requestAnimationFrame(() => { if (indicator) indicator.style.transition = ''; });

  buttons?.forEach((btn) => {
    btn.addEventListener('click', () => {
      setVariation(btn.dataset.homeVariation || 'v3');
      window.scrollTo({ top: 0, behavior: 'instant' });
    });
  });

  // Keep the indicator aligned if the viewport changes.
  window.addEventListener('resize', () => {
    const active = toggle?.querySelector('.home-vtoggle-btn.active') as HTMLButtonElement | null;
    if (active) moveIndicator(active);
  });
</script>
