---
/* Screenshot viewer. A native <dialog> gives us the top layer, focus
   containment, Esc-to-close, and inertness of the page for free. The image
   opens instantly on the rendition already on screen and upgrades to the
   sharp one once it has loaded, so there's never a blank frame. */
---

<dialog class="wk-lightbox" data-lightbox aria-labelledby="lb-title">
  <div class="lb-shell" data-lb-shell>
    <div class="lb-top">
      <p class="lb-title" id="lb-title">
        <span data-lb-project></span>
        <span class="lb-caption" data-lb-caption></span>
      </p>
      <span class="lb-count" data-lb-count aria-live="polite"></span>
      <button type="button" class="lb-btn lb-close" data-lb-close aria-label="Close viewer">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <path d="M5 5l10 10M15 5L5 15"></path>
        </svg>
      </button>
    </div>

    <div class="lb-stage" data-lb-stage>
      <img class="lb-img" data-lb-img alt="" />
      <span class="lb-loading" aria-hidden="true"></span>
    </div>

    <div class="lb-nav" data-lb-nav>
      <button type="button" class="lb-btn" data-lb-prev aria-label="Previous screenshot">
        <svg viewBox="0 0 22 22" width="20" height="20" aria-hidden="true"><path d="M14 4L7 11l7 7"></path></svg>
      </button>
      <span class="lb-hint" aria-hidden="true">← → to browse · Esc to close</span>
      <button type="button" class="lb-btn" data-lb-next aria-label="Next screenshot">
        <svg viewBox="0 0 22 22" width="20" height="20" aria-hidden="true"><path d="M8 4l7 7-7 7"></path></svg>
      </button>
    </div>
  </div>
</dialog>

<style>
  .wk-lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-surface);
    overscroll-behavior: contain;
  }
  .wk-lightbox::backdrop {
    background: var(--scrim-a80);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .lb-shell {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-4) var(--space-5) var(--space-5);
  }

  .lb-top {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
  }
  .lb-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    min-width: 0;
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
  }
  .lb-caption {
    color: var(--white-a60);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }
  .lb-count {
    margin-left: auto;
    color: var(--white-a60);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .lb-stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 0;
    container-type: size;
    touch-action: pan-y;
  }
  /* Percent heights don't resolve reliably inside a 1fr track; container
     units always do, so the image is contained whatever its aspect ratio. */
  .lb-img {
    display: block;
    max-width: min(100cqw, 1400px);
    max-height: 100cqh;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    box-shadow: 0 30px 80px var(--scrim-a60);
    user-select: none;
    -webkit-user-drag: none;
    transition:
      opacity 0.25s var(--ease-out),
      translate 0.3s var(--ease-out);
  }
  .lb-img.is-leaving-next {
    opacity: 0;
    translate: -16px 0;
    transition-duration: 0.12s;
  }
  .lb-img.is-leaving-prev {
    opacity: 0;
    translate: 16px 0;
    transition-duration: 0.12s;
  }

  .lb-loading {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    width: 16px;
    height: 16px;
    border: 2px solid var(--white-a24);
    border-top-color: var(--color-surface);
    border-radius: var(--radius-circle);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .lb-stage.is-loading .lb-loading {
    opacity: 1;
    animation: lb-spin 0.8s linear infinite;
  }
  @keyframes lb-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .lb-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
  }
  .lb-nav[hidden] {
    display: none;
  }
  .lb-hint {
    color: var(--white-a40);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
  }

  .lb-btn {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--white-a16);
    border-radius: var(--radius-circle);
    background: var(--white-a08);
    color: var(--color-surface);
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease-out),
      transform 0.16s var(--ease-out);
  }
  .lb-btn:hover {
    background: var(--white-a16);
  }
  .lb-btn:active {
    transform: scale(0.94);
  }
  .lb-btn:focus-visible {
    outline: 2px solid var(--white-a80);
    outline-offset: 2px;
  }
  .lb-btn svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Open / close: fade + settle, with @starting-style where supported. */
  @media (prefers-reduced-motion: no-preference) {
    .wk-lightbox,
    .wk-lightbox::backdrop {
      transition:
        opacity 0.25s var(--ease-out),
        overlay 0.25s allow-discrete,
        display 0.25s allow-discrete;
      opacity: 0;
    }
    .wk-lightbox[open],
    .wk-lightbox[open]::backdrop {
      opacity: 1;
    }
    .wk-lightbox .lb-stage {
      transition: scale 0.35s var(--ease-out);
    }
    .wk-lightbox:not([open]) .lb-stage {
      scale: 0.97;
    }
    @starting-style {
      .wk-lightbox[open],
      .wk-lightbox[open]::backdrop {
        opacity: 0;
      }
      .wk-lightbox[open] .lb-stage {
        scale: 0.97;
      }
    }
  }

  @media (max-width: 640px) {
    .lb-shell {
      padding: var(--space-3) var(--space-3) calc(var(--space-4) + env(safe-area-inset-bottom));
    }
    .lb-hint {
      display: none;
    }
    .lb-nav {
      justify-content: space-between;
    }
  }
</style>
