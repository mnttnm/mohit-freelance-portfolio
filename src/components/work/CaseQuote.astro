---
/* A client's words, set between case files so proof sits beside the work it
   vouches for instead of on another page. */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  person: string;
  role: string;
  href: string;
  avatar: ImageMetadata;
  quote: string;
}

const { person, role, href, avatar, quote } = Astro.props;
---

<figure class="cq wk-rise" data-quote>
  <svg class="cq-mark" viewBox="0 0 32 24" aria-hidden="true">
    <path
      d="M0 24V14.4C0 6.2 4.4 1.4 12 0l1.4 3.4C9 4.8 6.9 7.6 6.6 11.2H12V24H0Zm19 0V14.4C19 6.2 23.4 1.4 31 0l1 3.4c-4.4 1.4-6.4 4.2-6.8 7.8H31V24H19Z"
    ></path>
  </svg>
  <blockquote class="cq-quote">
    <p>{quote}</p>
  </blockquote>
  <figcaption class="cq-by">
    <Image src={avatar} alt="" width={44} height={44} densities={[1, 2]} class="cq-avatar" />
    <span class="cq-who">
      <a href={href} target="_blank" rel="noopener noreferrer" class="cq-name">
        {person}<span aria-hidden="true"> ↗</span>
        <span class="visually-hidden"> (profile, opens in a new tab)</span>
      </a>
      <span class="cq-role">{role}</span>
    </span>
  </figcaption>
</figure>

<style>
  .cq {
    position: relative;
    margin: 0;
    padding: var(--space-8) 0 var(--space-10) var(--space-10);
    border-top: 1px solid var(--color-border);
  }
  .cq-mark {
    position: absolute;
    top: var(--space-8);
    left: 0;
    width: 32px;
    height: 24px;
    fill: var(--accent-soft);
  }
  .cq-quote {
    margin: 0;
  }
  .cq-quote p {
    max-width: 36ch;
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: var(--text-display-xs);
    line-height: 1.4;
    text-wrap: pretty;
  }
  .cq-by {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .cq-by :global(.cq-avatar) {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-circle);
    object-fit: cover;
    box-shadow: 0 0 0 1px var(--ink-a08);
  }
  .cq-who {
    display: grid;
    line-height: 1.35;
  }
  .cq-name {
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }
  .cq-name:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cq-role {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  @media (max-width: 640px) {
    .cq {
      padding: var(--space-6) 0 var(--space-8);
    }
    .cq-mark {
      position: static;
      display: block;
      margin-bottom: var(--space-4);
    }
  }
</style>
