<script>
  // Fade-in on scroll using IntersectionObserver
  function initConversationalAnimations() {
    const targets = document.querySelectorAll('[data-variation-content="conversational"] .conv-fade-in');
    if (!targets.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('conv-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
    );

    targets.forEach((el) => observer.observe(el));
  }

  // Run on load and re-run if variation is toggled
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initConversationalAnimations);
  } else {
    initConversationalAnimations();
  }

  // Also observe for when the variation becomes visible (toggled on)
  const convWrapper = document.querySelector('[data-variation-content="conversational"]');
  if (convWrapper) {
    const displayObserver = new MutationObserver(() => {
      const style = window.getComputedStyle(convWrapper);
      if (style.display !== 'none') {
        initConversationalAnimations();
      }
    });
    displayObserver.observe(convWrapper, { attributes: true, attributeFilter: ['style'] });
  }
</script>
