  .v2-tcard-preview {
    display: none;
    font-family: var(--v2-serif);
    font-size: 0.85rem;
    font-weight: 300;
    color: var(--v2-text-muted);
    font-style: italic;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0;
    flex: 1;
    min-width: 0;
  }

  .v2-tcard:not(.v2-tcard-active) {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto;
    align-items: center;
    gap: 0 16px;
  }

  .v2-tcard:not(.v2-tcard-active) .v2-tcard-header {
    grid-column: 1;
    grid-row: 1;
  }

  .v2-tcard:not(.v2-tcard-active) .v2-tcard-preview {
    display: block;
    grid-column: 1 / -1;
    grid-row: 2;
    padding-left: 58px;
    margin-top: 4px;
  }

  .v2-tcard:not(.v2-tcard-active) .v2-author-role {
    display: none;
  }

  .v2-tcard:not(.v2-tcard-active):hover {
    background: rgba(255, 255, 255, 0.7);
  }

  /* ===== About ===== */
  .v2-about {
    padding: 120px 0;
  }

  .v2-about-headline {
    font-family: var(--v2-serif);
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    color: var(--v2-text);
    margin-bottom: 20px;
    letter-spacing: -0.02em;
    line-height: 1.2;
    max-width: 560px;
  }

  .v2-about-headline em {
    font-style: italic;
    color: var(--v2-accent);
  }

  .v2-about-body {
    font-size: 1.1rem;
    color: var(--v2-text-body);
    line-height: 1.8;
    max-width: 560px;
    margin-bottom: 36px;
  }

  .v2-about-actions {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  /* ===== Work ===== */
  .v2-projects {
    padding: 120px 0;
  }

  .v2-work-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 64px;
    align-items: center;
  }

  .v2-work-text {
    max-width: 440px;
  }

  .v2-work-headline {
    font-family: var(--v2-serif);
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    color: var(--v2-text);
    margin-bottom: 20px;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .v2-work-headline em {
    font-style: italic;
    color: var(--v2-accent);
  }

  .v2-work-body {
    font-size: 1.1rem;
    color: var(--v2-text-body);
    line-height: 1.8;
    margin-bottom: 0;
  }

  /* ===== Project cards — real screenshots in a labelled container so each
     tile reads as a product, not a flat image. No tint. ===== */
  .v2-work-mosaic {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 28px;
    border-radius: 18px;
    /* Accent-green panel with a soft top highlight; the inset shadow below
       supplies the vignette so card edges stay crisp. */
    background:
      radial-gradient(120% 100% at 50% 28%, rgba(255, 255, 255, 0.07), transparent 64%),
      var(--v2-accent);
    box-shadow:
      inset 0 0 72px rgba(0, 0, 0, 0.34),
      0 24px 60px -22px rgba(45, 90, 61, 0.5);
  }

  .v2-work-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .v2-thumb {
    display: flex;
    flex-direction: column;
    margin: 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--v2-border);
    background: #FFFFFF;
    box-shadow: 0 1px 2px rgba(26, 26, 26, 0.04);
    transition:
      box-shadow 0.4s ease,
      transform 0.45s cubic-bezier(0.23, 1, 0.32, 1),
      border-color 0.3s ease;
  }

  .v2-thumb-shot {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--v2-accent-light);
    border-bottom: 1px solid var(--v2-border);
  }

  .v2-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform 0.55s cubic-bezier(0.23, 1, 0.32, 1);
  }

  /* Label bar — project name + category, the bit that kills the "barren" feel */
  .v2-thumb-cap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 11px 13px 12px;
  }

  .v2-thumb-name {
    max-width: 100%;
    font-family: var(--v2-sans);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--v2-text);
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .v2-thumb-type {
    font-family: var(--v2-sans);
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--v2-accent);
    background: var(--v2-accent-light);
    padding: 3px 8px;
    border-radius: 999px;
  }

  .v2-thumb:hover {
    transform: translateY(-3px);
    border-color: rgba(45, 90, 61, 0.35);
    box-shadow: 0 12px 30px rgba(26, 26, 26, 0.1);
  }

  .v2-thumb:hover .v2-thumb-img {
    transform: scale(1.04);
  }

  /* CTA sits cleanly inside the green panel, under the grid */
  .v2-work-cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 2px;
    font-family: var(--v2-sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: rgba(250, 248, 245, 0.92);
    text-decoration: none;
    transition: gap 0.22s ease, color 0.22s ease;
  }

  .v2-work-cta:hover {
    gap: 13px;
    color: #FFFFFF;
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .v2-nav {
      display: none;
    }

    .v2-menu-toggle {
      display: flex;
    }

    .v2-hero {
      padding: 120px 0 80px;
    }

    .v2-audience,
    .v2-services,
    .v2-process,
    .v2-work,
    .v2-projects,
    .v2-about {
      padding: 60px 0 80px;
    }

    .v2-audience-item {
      padding-left: 48px;
      font-size: 1rem;
    }

    .v2-services-list {
      padding: 0 24px;
    }

    .v2-audience-item::before {
      top: 28px;
    }

    .v2-audience-item:first-child::before {
      top: 8px;
    }

    .v2-process-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .v2-service {
      flex-direction: column;
      gap: 10px;
      padding: 28px 0;
    }

    .v2-service-meta {
      flex-direction: row;
      align-items: center;
      gap: 14px;
    }

    .v2-work-layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .v2-work-text {
      max-width: none;
    }

    .v2-work-mosaic {
      padding: 18px;
      border-radius: 14px;
    }

    /* Larger tiles on phones so they stay legible */
    .v2-work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .v2-headline {
      font-size: 2rem;
    }

    .v2-container {
      padding: 0 var(--site-container-padding-mobile);
    }

    .v2-header-inner {
      padding: 0 var(--site-container-padding-mobile);
    }

    .v2-trust-bar {
      font-size: 0.78rem;
      gap: 8px;
    }
  }
</style>

<script>
  // Intersection Observer for scroll-triggered reveals + testimonial stack interaction
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.querySelector('[data-variation-content="v2"]');
    if (!root) return;

    // Gate the hidden reveal state on JS being present — without this class the
    // CSS leaves every .v2-reveal visible, so no-JS users still see content.
    root.classList.add('v2-js');

    const reveals = root.querySelectorAll('.v2-reveal');
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Hero two-act sequence: the weave draws + converges first, then the copy
    // resolves in. Reduced-motion users get the finished hero immediately; the
    // CSS never hides the copy for them, so this just keeps state consistent.
    const heroAnim = root.querySelector('.v2-hero[data-hero-anim]');
    if (heroAnim) {
      // Play the full overture only on the first arrival of a session. Returning
      // visitors (and reduced-motion users) get the resolved hero instantly — a
      // fresh session still earns the wow.
      let heroSeen = false;
      try {
        heroSeen = sessionStorage.getItem('v2HeroSeen') === '1';
      } catch (e) {
        /* storage blocked (private mode) — just play it */
      }

      if (prefersReduced || heroSeen) {
        heroAnim.classList.add('is-art-instant', 'is-art-done');
      } else {
        try {
          sessionStorage.setItem('v2HeroSeen', '1');
        } catch (e) {
          /* no-op */
        }
        // Act 2 begins the moment the last discipline thread actually lands on
        // the knot — the copy resolves *out of* the convergence. The timer is a
        // genuine fallback only, set past the choreography's natural end.
        let started = false;
        const startCopy = () => {
          if (started) return;
          started = true;
          heroAnim.classList.add('is-art-done');
        };
        // Both the desktop and mobile SVGs carry a last thread; only the visible
        // one runs its animation, so whichever fires is the real convergence.
        heroAnim
          .querySelectorAll('.v2-art-thread-last')
          .forEach((p) => p.addEventListener('animationend', startCopy, { once: true }));
        window.setTimeout(startCopy, 1900);
      }
    }

    if (prefersReduced) {
      // No motion: the CSS never hid them, but mark them in for consistency.
      reveals.forEach((el) => el.classList.add('is-in'));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement;
              // Cascade siblings within the same group (list, grid, container)
              // so a section resolves in reading order instead of all at once.
              const group = el.parentElement;
              if (group) {
                const sibs = Array.from(
                  group.querySelectorAll(':scope > .v2-reveal')
                );
                const idx = sibs.indexOf(el);
                if (idx > 0) {
                  el.style.setProperty('--reveal-delay', `${Math.min(idx, 6) * 70}ms`);
                }
              }
              el.classList.add('is-in');
              observer.unobserve(el);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
      );

      reveals.forEach((el) => observer.observe(el));
    }

    // Mobile menu toggle
    const toggle = root.querySelector('.v2-menu-toggle');
    const nav = root.querySelector('.v2-nav') as HTMLElement | null;
    if (toggle && nav) {
      const openMenu = () => {
        nav.style.display = 'flex';
        nav.style.flexDirection = 'column';
        nav.style.position = 'absolute';
        nav.style.top = '64px';
        nav.style.left = '0';
        nav.style.right = '0';
        nav.style.background = 'var(--v2-bg)';
        nav.style.padding = '24px';
        nav.style.borderBottom = '1px solid var(--v2-border)';
        nav.style.gap = '16px';
      };
      const closeMenu = () => {
        nav.style.display = '';
        nav.style.flexDirection = '';
        nav.style.position = '';
        nav.style.top = '';
        nav.style.left = '';
        nav.style.right = '';
        nav.style.background = '';
        nav.style.padding = '';
        nav.style.borderBottom = '';
        nav.style.gap = '';
      };
      toggle.addEventListener('click', () => {
        const isOpen = nav.style.display === 'flex';
        isOpen ? closeMenu() : openMenu();
      });
      nav.querySelectorAll('.v2-nav-link').forEach((link) => {
        link.addEventListener('click', closeMenu);
      });
    }

    // Testimonial stacked cards — click to expand
    const tcards = root.querySelectorAll('.v2-tcard');
    tcards.forEach((card) => {
      card.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) return;
        if (card.classList.contains('v2-tcard-active')) return;

        tcards.forEach((c) => c.classList.remove('v2-tcard-active'));
        card.classList.add('v2-tcard-active');
      });
    });
  });
</script>
