    opacity: 0.9;
  }

  .v2-rating {
    display: flex;
    align-items: center;
  }
  .v2-stars {
    color: var(--v2-accent);
    font-size: var(--text-xs);
    letter-spacing: 2px;
    line-height: 1;
  }

  /* Maker's byline — the payoff that lands last. A quiet, right-aligned footer
     signature rather than a badge competing for attention. */
  .v2-byline {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 5px 14px;
    border-top: 1px solid var(--v2-border);
    background: var(--v2-accent-light);
    font-family: var(--v2-sans);
    font-size: var(--text-2xs);
    color: var(--v2-text-muted);
  }
  .v2-byline strong {
    color: var(--v2-text);
    font-weight: 600;
  }

  @media (min-width: 961px) {
    /* Two columns: the eyebrow + copy stack on the left, the art on the right
       spanning both rows and vertically centered. align-content centers the
       left-column block as a unit within the tall wrap. */
    .v2-hero-wrap {
      min-height: 520px;
      display: grid;
      grid-template-columns: minmax(0, 1.04fr) minmax(0, 0.96fr);
      grid-template-areas:
        "eyebrow art"
        "copy    art";
      grid-template-rows: auto auto;
      column-gap: 56px;
      align-content: center;
    }
    .v2-hero-wrap > .v2-eyebrow { grid-area: eyebrow; }
    .v2-hero-wrap > .v2-hero-copy { grid-area: copy; }
    .v2-hero-wrap > .v2-hero-art { grid-area: art; align-self: center; }

    /* On a fine pointer, hovering the stack fans the cascade open a touch — a
       peek at the layers under the finished product. */
    .v2-stack:hover .v2-layer,
    .v2-stack:hover .v2-product {
      transform: translate3d(
        calc(var(--layer) * (var(--step-x) + 8px)),
        calc(var(--layer) * (var(--step-y) + 9px)),
        calc(var(--layer) * 22px)
      );
    }
  }

  @media (max-width: 960px) {
    /* The deck slots between the eyebrow and the headline as a compact cascade,
       so it reads as part of the hero rather than a separate block below it. */
    .v2-hero-wrap {
      display: grid;
      grid-template-columns: 1fr;
      grid-template-areas:
        "eyebrow"
        "art"
        "copy";
    }
    .v2-hero-wrap > .v2-eyebrow { grid-area: eyebrow; }
    .v2-hero-wrap > .v2-hero-art { grid-area: art; }
    .v2-hero-wrap > .v2-hero-copy { grid-area: copy; }

    /* The deck is its own band: generous space above and below sets it apart
       from the copy, while the copy below is tightened into one group. Without
       this the visual's margins matched the copy's internal rhythm and the whole
       hero read as one evenly-spaced stack.
       Centered so the overture (which centers + scales the deck) docks straight
       down into place with no sideways drift or clipping. */
    .v2-hero-art {
      margin: 36px 0 52px;
      justify-content: center;
      align-items: flex-start;
    }

    /* The eyebrow's own bottom margin would stack with the deck's top margin;
       zero it so the band gap above the deck is exactly the value set above. */
    .v2-hero-wrap > .v2-eyebrow {
      margin-bottom: 0;
    }

    /* Tighten the copy group so its internal gaps stay clearly smaller than the
       band gaps around the deck. */
    .v2-hero-copy .v2-headline {
      margin-bottom: 18px;
    }
    .v2-hero-copy .v2-subtext {
      margin-bottom: 24px;
    }
    .v2-hero-copy .v2-hero-actions {
      margin-bottom: 24px;
    }

    /* A tidy cascade that fits the mobile width with readable tabs. The product
       card is taller than the layers (which are absolutely positioned, so they
       don't grow the box), hence an explicit height that contains the whole
       deck — otherwise the product would overflow onto the headline below. */
    .v2-stack {
      --card-w: 232px;
      --card-h: 146px;
      --step-x: 22px;
      --step-y: 36px;
      height: 336px;
    }
  }

  /* Delight: hovering the fanned-open stack brings the tiles to life — the
     discipline icons spring, the AI spark turns, and the usage bars re-grow. */
  @media (min-width: 961px) and (prefers-reduced-motion: no-preference) {
    .v2-layer-icon {
      transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .v2-stack:hover .v2-layer-icon {
      transform: scale(1.16);
    }
    .v2-stack:hover .v2-layer-ai .v2-layer-icon {
      transform: rotate(90deg) scale(1.12);
    }

    .v2-stack:hover .v2-pv-chart span {
      animation: v2-bar-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .v2-stack:hover .v2-pv-chart span:nth-child(2) { animation-delay: 60ms; }
    .v2-stack:hover .v2-pv-chart span:nth-child(3) { animation-delay: 120ms; }
    .v2-stack:hover .v2-pv-chart span:nth-child(4) { animation-delay: 180ms; }
    .v2-stack:hover .v2-pv-chart span:nth-child(5) { animation-delay: 240ms; }
  }

  @keyframes v2-bar-rise {
    from { transform: scaleY(0.35); }
  }

  @keyframes v2-live-pulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(63, 155, 84, 0.18); }
    50% { box-shadow: 0 0 0 5px rgba(63, 155, 84, 0.05); }
  }

  /* Two entrances, chosen by JS. `.is-loading` (first visit this session) plays
     the full deck-load: sheets stack in one at a time, the product lands, the
     byline resolves — which cues the copy in (Act 2). `.is-spring` (every later
     visit) is the light return: the deck springs from a fanned-open start back
     to its resting stack — the hover, reversed. Reduced-motion gets neither. */
  @media (prefers-reduced-motion: no-preference) {
    /* Heavy entrance — each sheet rises the SAME short distance into its own
       resting slot, X held at its rest value so cards never cross paths. Uniform
       vector + a clear stagger = an orderly stack assembling. Clean ease-out (no
       overshoot). `backwards` (not `both`) so the entrance only fills the
       pre-delay state — it does NOT pin the transform afterward, which would
       otherwise block the hover spring. */
    .v2-hero.is-loading .v2-layer,
    .v2-hero.is-loading .v2-product {
      animation: v2-layer-in 0.58s cubic-bezier(0.22, 1, 0.36, 1) backwards;
      animation-delay: calc(var(--layer) * 150ms);
    }
    .v2-hero.is-loading .v2-byline {
      animation: v2-byline-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) backwards;
      animation-delay: 1080ms;
    }

    /* Light entrance — the deck springs from its fanned-open (hover) position
       back into the resting stack with a gentle overshoot. Quick, all cards near
       together, no center-stage overture. */
    .v2-hero.is-spring .v2-layer,
    .v2-hero.is-spring .v2-product {
      animation: v2-spring-in 0.66s var(--ease-spring) backwards;
      animation-delay: calc(var(--layer) * 40ms);
    }
    .v2-hero.is-spring .v2-byline {
      animation: v2-byline-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) backwards;
      animation-delay: 340ms;
    }

    /* The live dot quietly breathes — a sign the product is running. */
    .v2-live {
      animation: v2-live-pulse 2.4s ease-in-out infinite;
    }
  }

  @keyframes v2-layer-in {
    from {
      opacity: 0;
      /* Start at the card's own resting X (no horizontal drift) but a short hop
         below and behind it, so every sheet travels the same small distance
         up-and-forward into place. Uses the same --step vars as the rest
         position, so the entrance auto-matches both desktop and mobile. */
      transform: translate3d(
        calc(var(--layer) * var(--step-x)),
        calc(var(--layer) * var(--step-y) + 30px),
        calc(var(--layer) * 16px - 36px)
      );
    }
    60% {
      opacity: 1;
    }
  }

  @keyframes v2-spring-in {
    from {
      opacity: 0;
      /* Fanned-open start (the hover position), settling back to rest. */
      transform: translate3d(
        calc(var(--layer) * (var(--step-x) + 12px)),
        calc(var(--layer) * (var(--step-y) + 13px)),
        calc(var(--layer) * 26px)
      );
    }
    45% {
      opacity: 1;
    }
  }

  @keyframes v2-byline-in {
    from {
      opacity: 0;
      transform: translateY(7px);
    }
  }

  .v2-eyebrow {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--v2-accent);
    margin-bottom: 20px;
  }

  .v2-headline {
    font-family: var(--v2-serif);
    font-size: var(--text-display-xl);
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--v2-text);
    margin-bottom: 28px;
    max-width: 720px;
  }

  .v2-headline em {
    font-style: italic;
    color: var(--v2-accent);
  }

  .v2-subtext {
    font-size: var(--text-xl);
    color: var(--v2-text-body);
    line-height: 1.7;
    max-width: 600px;
    margin-bottom: 40px;
  }

  .v2-hero-actions {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .v2-trust-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    font-size: var(--text-sm);
    color: var(--v2-text-muted);
  }

  .v2-trust-item {
    letter-spacing: 0.01em;
  }

  .v2-trust-sep {
    color: var(--v2-border);
  }

  /* ===== Buttons ===== */
  .v2-btn-primary {
    display: inline-block;
    padding: 14px 32px;
    background: var(--v2-accent);
    color: #fff;
    font-size: var(--text-md);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background 0.25s, transform 0.16s var(--ease-out);
  }

  .v2-btn-primary:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .v2-btn-primary:hover {
      background: var(--studio-accent-pressed);
      transform: translateY(-1px);
    }
  }

  .v2-btn-text {
    font-size: var(--text-md);
    color: var(--v2-text-body);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .v2-btn-text:hover {
    color: var(--v2-accent);
  }

  /* ===== Audience ===== */
  .v2-audience {
    padding: 40px 0 120px;
  }

  .v2-audience-headline {
    font-family: var(--v2-serif);
    font-size: var(--text-display-sm);
    color: var(--v2-text);
    margin-bottom: 48px;
    letter-spacing: -0.02em;
    line-height: 1.25;
    max-width: 640px;
  }

  .v2-audience-headline em {
    font-style: italic;
    color: var(--v2-accent);
  }

  .v2-audience-list {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 920px;
    counter-reset: audience;
  }

  .v2-audience-item {
    counter-increment: audience;
    position: relative;
    padding: 28px 0 28px 64px;
    font-family: var(--v2-sans);
    font-size: var(--text-lg);
    color: var(--v2-text-body);
    line-height: 1.65;
    letter-spacing: 0;
    border-bottom: 1px solid var(--v2-border);
  }

  /* Bold lead carries the scan; the clause after it sits lighter. */
  .v2-audience-lead {
    display: block;
    font-weight: 600;
    color: var(--v2-text);
    margin-bottom: 4px;
  }

  .v2-audience-item:first-child {
    padding-top: 8px;
  }

  .v2-audience-item:last-child {
    border-bottom: none;
    padding-bottom: 8px;
  }

  .v2-audience-item::before {
    content: counter(audience, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 32px;
    font-family: var(--v2-sans);
    font-size: var(--text-xs);
    color: var(--v2-accent);
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums;
  }

  .v2-audience-item:first-child::before {
    top: 12px;
  }

  /* Headline row: the "you" serif line on the left, the service tag
     pinned to the right edge like a ledger entry. */
  .v2-team-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    margin-bottom: 12px;
  }

  /* Service tag — a quiet pill that categorises each pair without
     competing with the serif headline beside it. */
  .v2-team-badge {
    flex-shrink: 0;
    margin-top: 6px;
    padding: 4px 11px;
    border-radius: var(--radius-pill);
    background: var(--v2-accent-light);
    border: 1px solid var(--v2-border);
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--v2-accent);
    white-space: nowrap;
  }

  /* The "you" line reads as a proper headline: serif, lighter weight,
     not the heavy sans bold it was before. */
  .v2-team-lead {
    flex: 1;
    font-family: var(--v2-serif);
    font-weight: 400;
    font-size: var(--text-display-xs);
    color: var(--v2-text);
    letter-spacing: -0.01em;
    line-height: 1.25;
    margin-bottom: 0;
  }

  /* ===== Process / How I Work ===== */
  .v2-process {
    padding: 40px 0 120px;
  }

  .v2-process-headline {
    font-family: var(--v2-serif);
    font-size: var(--text-display-md);
    color: var(--v2-text);
    margin-bottom: 48px;
    letter-spacing: -0.02em;
    line-height: 1.2;
    max-width: 640px;
  }

  .v2-process-headline em {
    font-style: italic;
    color: var(--v2-accent);
  }

  .v2-process-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px 48px;
  }

  .v2-process-item {
    padding-top: 4px;
    border-top: 1px solid var(--v2-border);
    padding-top: 20px;
  }

  .v2-process-title {
    font-family: var(--v2-serif);
    font-size: var(--text-lg);
    color: var(--v2-text);
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }

  .v2-process-desc {
    font-size: var(--text-md);
    color: var(--v2-text-body);
    line-height: 1.7;
    margin: 0;
  }

  /* ===== Testimonials (stacked cards — same pattern as Studio) ===== */
  .v2-work {
    padding: 120px 0;
  }

  .v2-testimonials-section {
    position: relative;
    overflow: clip;
  }

  .v2-testimonials-section::before {
    content: '';
    position: absolute;
    top: -40px;
    left: -200px;
    right: -200px;
    bottom: -40px;
    background: radial-gradient(ellipse at center, var(--v2-accent-light) 0%, transparent 70%);
    pointer-events: none;
    z-index: -1;
  }

  .v2-testimonials-headline {
    font-family: var(--v2-serif);
    font-size: var(--text-display-sm);
    color: var(--v2-text);
    margin-bottom: 48px;
    letter-spacing: -0.02em;
    line-height: 1.25;
    max-width: 640px;
    text-wrap: balance;
  }

  .v2-testimonials-headline em {
    font-style: italic;
    color: var(--v2-accent);
  }

  .v2-testimonial-stack {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .v2-tcard {
    background: var(--white-a40);
    border: 1px solid var(--v2-border);
    border-bottom: none;
    padding: 20px 28px;
    cursor: pointer;
    transition: background 0.25s var(--ease-out);
    position: relative;
    overflow: hidden;
  }

  .v2-tcard:first-child {
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }

  .v2-tcard:last-child {
    border-bottom: 1px solid var(--v2-border);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }

  .v2-tcard:only-child {
    border-radius: var(--radius-lg);
    border-bottom: 1px solid var(--v2-border);
  }

  .v2-tcard-header {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .v2-avatar {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-circle);
    overflow: hidden;
    flex-shrink: 0;
    border: 2px solid var(--v2-border);
    transition: transform 0.3s var(--ease-out);
  }

  .v2-tcard-active .v2-avatar {
    /* 48/44 — scale instead of animating width/height (GPU, no relayout) */
    transform: scale(1.0909);
  }

  .v2-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-circle);
  }

  .v2-tcard-author {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .v2-author-name {
    font-weight: 600;
    font-size: var(--text-md);
    color: var(--v2-text);
  }

  .v2-author-role {
    font-size: var(--text-sm);
    color: var(--v2-text-muted);
  }

  .v2-profile-link {
    color: var(--v2-text);
    text-decoration: none;
    transition: color 0.2s;
  }

  .v2-profile-link:hover {
    color: var(--v2-accent);
  }

  .v2-link-arrow {
    font-size: var(--text-xs);
    opacity: 0.5;
    transition: opacity 0.2s;
  }

  .v2-profile-link:hover .v2-link-arrow {
    opacity: 1;
  }

  .v2-tcard-body {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, opacity 0.3s ease, margin 0.3s ease;
    margin-top: 0;
  }

  .v2-tcard-active .v2-tcard-body {
    max-height: 300px;
    opacity: 1;
    margin-top: 20px;
  }

  .v2-tcard-active {
    background: var(--white-a80);
    padding: 28px 28px;
    border-left: 3px solid var(--v2-accent);
    cursor: default;
  }

  .v2-quote {
    font-family: var(--v2-serif);
    font-size: var(--text-lg);
    /* DM Serif Display only ships at 400 — anything lighter triggers faux-thin. */
    font-weight: 400;
    color: var(--v2-text-body);
    line-height: 1.8;
    font-style: italic;
    opacity: 0.85;
  }

  .v2-tcard-preview {
    display: none;
    font-family: var(--v2-serif);
    font-size: var(--text-sm);
    font-weight: 300;
    color: var(--v2-text-muted);
    font-style: italic;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0;
    flex: 1;
    min-width: 0;
  }

  .v2-tcard:not(.v2-tcard-active) {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto;
    align-items: center;
    gap: 0 16px;
  }

  .v2-tcard:not(.v2-tcard-active) .v2-tcard-header {
    grid-column: 1;
    grid-row: 1;
  }

  .v2-tcard:not(.v2-tcard-active) .v2-tcard-preview {
    display: block;
    grid-column: 1 / -1;
    grid-row: 2;
    padding-left: 58px;
    margin-top: 4px;
  }

  .v2-tcard:not(.v2-tcard-active) .v2-author-role {
    display: none;
  }

  .v2-tcard:not(.v2-tcard-active):hover {
    background: var(--white-a60);
  }

  /* ===== About ===== */
  .v2-about {
    padding: 120px 0;
  }

  .v2-about-headline {
    font-family: var(--v2-serif);
    font-size: var(--text-display-md);
    color: var(--v2-text);
    margin-bottom: 20px;
    letter-spacing: -0.02em;
    line-height: 1.2;
    max-width: 560px;
  }

  .v2-about-headline em {
    font-style: italic;
    color: var(--v2-accent);
  }

  .v2-about-body {
    font-size: var(--text-lg);
    color: var(--v2-text-body);
    line-height: 1.8;
    max-width: 560px;
    margin-bottom: 36px;
  }

  .v2-about-actions {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: auto;            /* pin the CTA to the bottom of the cream card */
  }

  /* Two-pane split: cream copy card | green portrait panel, separated by a gap
     so they read as two distinct surfaces. */
  .v2-about-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(320px, 30%, 380px);
    gap: 24px;
    align-items: stretch;
    min-height: 520px;           /* keeps both columns proportional even if copy is short */
  }

  /* Left — cream copy card */
  .v2-about-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--v2-accent-light);
    border: 1px solid var(--v2-border);
    border-radius: var(--radius-xl);
    padding: 48px;
  }

  /* Right — the whole column is the green panel; portrait floats inside it and
     name + socials sit beneath on the same green field. */
  .v2-about-media {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background:
      radial-gradient(120% 80% at 50% 18%, var(--white-a08), transparent 60%),
      var(--v2-accent);
  }

  .v2-about-imgwrap {
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 24px 8px;       /* green breathes around the portrait */
  }

  .v2-about-img {
    display: block;
    width: 100%;
    max-width: 320px;             /* compact portrait */
    height: auto;                 /* full portrait, nothing clipped */
    border-radius: 0;             /* sharp edges */
  }

  .v2-about-meta {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    padding: 28px 32px;
    margin-top: auto;            /* pin metadata to the bottom of the green column */
  }

  .v2-about-name {
    font-family: var(--v2-serif);
    font-size: var(--text-2xl);
    line-height: 1.1;
    color: var(--v2-bg);
    letter-spacing: -0.01em;
  }

  /* Socials stack one per row beneath the name — avoids the awkward wrap where
     a single link drops to its own line. */
  .v2-about-socials {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    margin-top: 14px;
  }

  .v2-about-social {
    font-size: var(--text-sm);
    font-weight: 500;
    color: rgba(250, 248, 245, 0.62);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .v2-about-social:hover {
    color: var(--v2-bg);
  }

  .v2-about-social-sep {
    display: none;
  }

  @media (max-width: 860px) {
    /* Stack the copy above the green panel, but turn the panel into a horizontal
       profile card (portrait | info) so it stays composed at every width. */
    .v2-about-layout {
      grid-template-columns: 1fr;
      min-height: 0;
      gap: 16px;
    }

    .v2-about-text {
      padding: 32px;
    }

    .v2-about-actions {
      margin-top: 24px;
    }

    .v2-about-media {
      flex-direction: row;
      align-items: stretch;
    }

    .v2-about-imgwrap {
      flex: 0 0 44%;               /* portrait scales with the card, never sparse */
      padding: 20px;
    }

    .v2-about-img {
      max-width: none;
    }

    .v2-about-meta {
      flex: 1 1 auto;
      min-width: 0;
      justify-content: center;
      margin-top: 0;
      padding: 24px 28px 24px 8px;
    }
  }

  /* Small phones: tighten the two panes so the portrait still reads. */
  @media (max-width: 480px) {
    .v2-about-imgwrap {
      flex-basis: 42%;
      padding: 14px;
    }

    .v2-about-meta {
      padding: 20px 18px 20px 6px;
    }

    .v2-about-name {
      font-size: var(--text-xl);
    }

    .v2-about-socials {
      gap: 10px;
    }

    .v2-about-social {
      font-size: var(--text-sm);
    }
  }

  /* ===== Work ===== */
  .v2-projects {
    padding: 120px 0;
  }

  .v2-work-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 64px;
    align-items: center;
  }

  .v2-work-text {
    max-width: 440px;
  }

  .v2-work-headline {
    font-family: var(--v2-serif);
    font-size: var(--text-display-md);
    color: var(--v2-text);
    margin-bottom: 20px;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .v2-work-headline em {
    font-style: italic;
    color: var(--v2-accent);
  }

  .v2-work-body {
    font-size: var(--text-lg);
    color: var(--v2-text-body);
    line-height: 1.8;
    margin-bottom: 0;
  }

  /* ===== Project cards — real screenshots in a labelled container so each
     tile reads as a product, not a flat image. No tint. ===== */
  .v2-work-mosaic {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 28px;
    border-radius: var(--radius-xl);
    /* Accent-green panel with a soft top highlight; the inset shadow below
       supplies the vignette so card edges stay crisp. */
    background:
      radial-gradient(120% 100% at 50% 28%, var(--white-a08), transparent 64%),
      var(--v2-accent);
    box-shadow:
      inset 0 0 72px var(--scrim-a40),
      0 24px 60px -22px var(--accent-strong);
  }

  .v2-work-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .v2-thumb {
    display: flex;
    flex-direction: column;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--v2-border);
    background: #FFFFFF;
    box-shadow: 0 1px 2px var(--ink-a08);
    transition:
      box-shadow 0.25s ease,
      transform 0.25s var(--ease-out),
      border-color 0.25s ease;
  }

  /* Whole tile is a link to its project on /projects — fills the figure so the
     hover/lift on .v2-thumb still reads as one clickable surface. */
  .v2-thumb-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .v2-thumb-link:focus-visible {
    outline: 2px solid var(--v2-accent);
    outline-offset: 2px;
  }

  .v2-thumb-shot {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--v2-accent-light);
    border-bottom: 1px solid var(--v2-border);
  }

  .v2-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform 0.3s var(--ease-out);
  }

  /* Label bar — project name + category, the bit that kills the "barren" feel */
  .v2-thumb-cap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 11px 13px 12px;
  }

  .v2-thumb-name {
    max-width: 100%;
    font-family: var(--v2-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--v2-text);
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .v2-thumb-type {
    font-family: var(--v2-sans);
    font-size: var(--text-2xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--v2-accent);
    background: var(--v2-accent-light);
    padding: 3px 8px;
    border-radius: var(--radius-pill);
  }

  @media (hover: hover) and (pointer: fine) {
    .v2-thumb:hover {
      transform: translateY(-3px);
      border-color: var(--accent-line);
      box-shadow: 0 12px 30px var(--ink-a08);
    }

    .v2-thumb:hover .v2-thumb-img {
      transform: scale(1.04);
    }
  }

  /* CTA sits cleanly inside the green panel, under the grid */
  .v2-work-cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 2px;
    font-family: var(--v2-sans);
    font-size: var(--text-md);
    font-weight: 600;
    color: rgba(250, 248, 245, 0.92);
    text-decoration: none;
    transition: color 0.22s ease;
  }

  .v2-cta-arrow {
    display: inline-block;
    /* nudge the arrow on hover with transform (GPU) instead of animating gap */
    transition: transform 0.22s var(--ease-out);
  }

  .v2-work-cta:hover {
    color: #FFFFFF;
  }

  @media (hover: hover) and (pointer: fine) {
    .v2-work-cta:hover .v2-cta-arrow {
      transform: translateX(4px);
    }
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .v2-nav {
      display: none;
    }

    .v2-menu-toggle {
      display: flex;
    }

    .v2-hero {
      padding: 120px 0 80px;
    }

    .v2-audience,
    .v2-process,
    .v2-work,
    .v2-projects,
    .v2-about {
      padding: 44px 0 56px;
    }

    .v2-audience-item {
      padding-left: 48px;
      font-size: var(--text-lg);
    }

    /* Stack on phones: badge rides above the headline as an eyebrow. */
    .v2-team-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .v2-team-badge {
      order: -1;
      margin-top: 0;
    }

    .v2-audience-item::before {
      top: 28px;
    }

    .v2-audience-item:first-child::before {
      top: 8px;
    }

    .v2-process-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .v2-work-layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .v2-work-text {
      max-width: none;
    }

    .v2-work-mosaic {
      padding: 18px;
      border-radius: var(--radius-lg);
    }

    /* Larger tiles on phones so they stay legible */
    .v2-work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .v2-headline {
      font-size: var(--text-3xl);
    }

    .v2-container {
      padding: 0 var(--site-container-padding-mobile);
    }

    .v2-header-inner {
      padding: 0 var(--site-container-padding-mobile);
    }

    .v2-trust-bar {
      font-size: var(--text-sm);
      gap: 8px;
    }
  }
</style>

<script>
  // Intersection Observer for scroll-triggered reveals + testimonial stack interaction
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.querySelector('[data-variation-content="v2"]');
    if (!root) return;

    // Gate the hidden reveal state on JS being present — without this class the
    // CSS leaves every .v2-reveal visible, so no-JS users still see content.
    root.classList.add('v2-js');

    const reveals = root.querySelectorAll('.v2-reveal');
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Hero two-act sequence: the craft layers assemble into the product center-
    // stage first (a deliberate loading beat), then the whole stack docks to the
    // right as the copy resolves in on the left. Reduced-motion users get the
    // finished, docked hero immediately.
    const heroAnim = root.querySelector('.v2-hero[data-hero-anim]');
    if (heroAnim) {
      const heroArt = heroAnim.querySelector('.v2-hero-art');
      const isWide = window.matchMedia('(min-width: 961px)').matches;

      // Hold the rest of the page back + lock scroll while the hero entrance
      // plays, so the hero owns the screen; releasing reveals the page (CSS
      // fades it in) and restores scrolling.
      const lockPage = () => {
        root.classList.add('is-hero-locked');
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
      };
      const releasePage = () => {
        root.classList.remove('is-hero-locked');
        // Reveal everything below the hero now that the entrance has settled —
        // CSS fades the sections (work first) in from their pre-paint hidden state.
        root.classList.add('is-hero-revealed');
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
      };

      // The full deck-load plays once per session; later visits get the lighter
      // spring settle. (No client router here — every visit is a full reload —
      // so the "have I shown it yet" flag lives in sessionStorage.)
      let heroSeen = false;
      try {
        heroSeen = sessionStorage.getItem('v2HeroSeen') === '1';
      } catch (e) {
        /* storage blocked (private mode) — treat as first visit */
      }

      if (prefersReduced) {
        // No motion: the finished hero appears at once, nothing held back —
        // reveal the rest of the page immediately too (no lock/release cycle).
        heroAnim.classList.add('is-art-instant', 'is-art-done');
        root.classList.add('is-hero-revealed');
      } else if (heroSeen) {
        // Return visit: the light spring settle — quick, in place, no overture.
        lockPage();
        heroAnim.classList.add('is-spring');
        window.setTimeout(() => {
          heroAnim.classList.add('is-art-done');
          releasePage();
        }, 700);
      } else {
        // First visit this session: the full deck-load overture.
        try {
          sessionStorage.setItem('v2HeroSeen', '1');
        } catch (e) {
          /* no-op */
        }
        lockPage();

        // Minimum on-screen time for the centered assembly so it reads as a
        // deliberate loading beat; tuned to sit just past the byline landing.
        const MIN_OVERTURE = 1750;

        // Center the deck for the overture, then it docks to its resting slot.
        // Desktop: center it in the hero's right cell. Mobile: center it in the
        // viewport so the empty, locked page's vertical space carries the
        // assembly before it squishes up into the band above the headline.
        if (heroArt) {
          // Measure the stack itself (not the padded art box) so the deck is
          // truly centered and the scaled overture never clips off-screen.
          const stack = heroArt.querySelector('.v2-stack');
          const a = (stack || heroArt).getBoundingClientRect();
          if (isWide) {
            const wrap = heroAnim.querySelector('.v2-hero-wrap');
            const w = wrap.getBoundingClientRect();
            const dx = w.left + w.width / 2 - (a.left + a.width / 2);
            heroArt.style.setProperty('--ov-dx', `${Math.round(dx)}px`);
            heroArt.style.setProperty('--ov-dy', '0px');
            heroArt.style.setProperty('--ov-scale', '1.18');
          } else {
            // Center in the viewport, using the empty page's vertical space.
            const dx = window.innerWidth / 2 - (a.left + a.width / 2);
            const dy = window.innerHeight / 2 - (a.top + a.height / 2);
            heroArt.style.setProperty('--ov-dx', `${Math.round(dx)}px`);
            heroArt.style.setProperty('--ov-dy', `${Math.round(dy)}px`);
            heroArt.style.setProperty('--ov-scale', '1.15');
          }
          heroAnim.classList.add('is-overture');
        }
        heroAnim.classList.add('is-loading');

        let docked = false;
        const dock = () => {
          if (docked) return;
          docked = true;
          if (heroArt) heroArt.classList.add('is-docking');
          heroAnim.classList.remove('is-overture'); // transforms back to its cell
          heroAnim.classList.add('is-art-done'); // copy resolves in
          releasePage();
        };
        window.setTimeout(dock, MIN_OVERTURE);
      }

      // Safety net: never leave the page locked if a step above misfires.
      window.setTimeout(releasePage, 4000);
    }

    if (prefersReduced) {
      // No motion: the CSS never hid them, but mark them in for consistency.
      reveals.forEach((el) => el.classList.add('is-in'));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement;
              // Cascade siblings within the same group (list, grid, container)
              // so a section resolves in reading order instead of all at once.
              const group = el.parentElement;
              if (group) {
                const sibs = Array.from(
                  group.querySelectorAll(':scope > .v2-reveal')
                );
                const idx = sibs.indexOf(el);
                if (idx > 0) {
                  el.style.setProperty('--reveal-delay', `${Math.min(idx, 6) * 70}ms`);
                }
              }
              el.classList.add('is-in');
              observer.unobserve(el);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
      );

      reveals.forEach((el) => observer.observe(el));
    }

    // Mobile menu toggle
    const toggle = root.querySelector('.v2-menu-toggle');
    const nav = root.querySelector('.v2-nav') as HTMLElement | null;
    if (toggle && nav) {
      const openMenu = () => {
        nav.style.display = 'flex';
        nav.style.flexDirection = 'column';
        nav.style.position = 'absolute';
        nav.style.top = '64px';
        nav.style.left = '0';
        nav.style.right = '0';
        nav.style.background = 'var(--v2-bg)';
        nav.style.padding = '24px';
        nav.style.borderBottom = '1px solid var(--v2-border)';
        nav.style.gap = '16px';
      };
      const closeMenu = () => {
        nav.style.display = '';
        nav.style.flexDirection = '';
        nav.style.position = '';
        nav.style.top = '';
        nav.style.left = '';
        nav.style.right = '';
        nav.style.background = '';
        nav.style.padding = '';
        nav.style.borderBottom = '';
        nav.style.gap = '';
      };
      toggle.addEventListener('click', () => {
        const isOpen = nav.style.display === 'flex';
        isOpen ? closeMenu() : openMenu();
      });
      nav.querySelectorAll('.v2-nav-link').forEach((link) => {
        link.addEventListener('click', closeMenu);
      });
    }

    // Testimonial stacked cards — click to expand
    const tcards = root.querySelectorAll('.v2-tcard');
    tcards.forEach((card) => {
      card.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) return;
        if (card.classList.contains('v2-tcard-active')) return;

        tcards.forEach((c) => c.classList.remove('v2-tcard-active'));
        card.classList.add('v2-tcard-active');
      });
    });
  });
</script>
