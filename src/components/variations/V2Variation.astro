<script>
  // Intersection Observer for scroll-triggered reveals + testimonial stack interaction
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.querySelector('[data-variation-content="v2"]');
    if (!root) return;

    // Gate the hidden reveal state on JS being present — without this class the
    // CSS leaves every .v2-reveal visible, so no-JS users still see content.
    root.classList.add('v2-js');

    const reveals = root.querySelectorAll('.v2-reveal');
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReduced) {
      // No motion: the CSS never hid them, but mark them in for consistency.
      reveals.forEach((el) => el.classList.add('is-in'));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement;
              // Cascade siblings within the same group (list, grid, container)
              // so a section resolves in reading order instead of all at once.
              const group = el.parentElement;
              if (group) {
                const sibs = Array.from(
                  group.querySelectorAll(':scope > .v2-reveal')
                );
                const idx = sibs.indexOf(el);
                if (idx > 0) {
                  el.style.setProperty('--reveal-delay', `${Math.min(idx, 6) * 70}ms`);
                }
              }
              el.classList.add('is-in');
              observer.unobserve(el);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
      );

      reveals.forEach((el) => observer.observe(el));
    }

    // Mobile menu toggle
    const toggle = root.querySelector('.v2-menu-toggle');
    const nav = root.querySelector('.v2-nav') as HTMLElement | null;
    if (toggle && nav) {
      const openMenu = () => {
        nav.style.display = 'flex';
        nav.style.flexDirection = 'column';
        nav.style.position = 'absolute';
        nav.style.top = '64px';
        nav.style.left = '0';
        nav.style.right = '0';
        nav.style.background = 'var(--v2-bg)';
        nav.style.padding = '24px';
        nav.style.borderBottom = '1px solid var(--v2-border)';
        nav.style.gap = '16px';
      };
      const closeMenu = () => {
        nav.style.display = '';
        nav.style.flexDirection = '';
        nav.style.position = '';
        nav.style.top = '';
        nav.style.left = '';
        nav.style.right = '';
        nav.style.background = '';
        nav.style.padding = '';
        nav.style.borderBottom = '';
        nav.style.gap = '';
      };
      toggle.addEventListener('click', () => {
        const isOpen = nav.style.display === 'flex';
        isOpen ? closeMenu() : openMenu();
      });
      nav.querySelectorAll('.v2-nav-link').forEach((link) => {
        link.addEventListener('click', closeMenu);
      });
    }

    // Testimonial stacked cards — click to expand
    const tcards = root.querySelectorAll('.v2-tcard');
    tcards.forEach((card) => {
      card.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) return;
        if (card.classList.contains('v2-tcard-active')) return;

        tcards.forEach((c) => c.classList.remove('v2-tcard-active'));
        card.classList.add('v2-tcard-active');
      });
    });
  });
</script>
