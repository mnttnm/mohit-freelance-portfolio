---
import { Image } from 'astro:assets';
import deanImage from '../../assets/dean-teffer.webp';
import austinImage from '../../assets/austin-mcdaniel.webp';
import alperImage from '../../assets/alper-ortac.webp';
import kyleImage from '../../assets/kyle-prinsloo.webp';
import fredImage from '../../assets/fred-wilmot.webp';
import opsWorkspace from '../../assets/work/ops-workspace.png';
import aiResizing from '../../assets/work/ai-resizing.png';
import dashboards from '../../assets/work/dashboards.png';
import slicely from '../../assets/work/slicely.png';
import aiToolkit from '../../assets/work/ai-toolkit.png';
import reviewhub from '../../assets/work/reviewhub.png';
import portraitHome from '../../assets/mohit-portrait-home.jpeg';
import StudioFooter from '../StudioFooter.astro';

// ===== Hero art =====
// Concept "Craft Layers": the disciplines are stacked sheets of one body of
// work — Design, Engineering, QA & Automation, AI Workflows — cascading into a
// finished product window that lands with a "Shipped" stamp. Built as layered
// cards in 3D (CSS), so the markup is just the discipline list + the product.
const craftLayers = [
  { key: 'design', label: 'Design' },
  { key: 'engineering', label: 'Engineering' },
  { key: 'qa', label: 'QA & Automation' },
  { key: 'ai', label: 'AI Workflows' },
];
---

<div data-variation-content="v2">

  <!-- Set the JS gate synchronously, before the hero paints. The deferred module
       below also adds this, but it runs after first paint — so without this inline
       pass the hero copy flashes visible for a frame before the .v2-js rules hide
       it (a blink alongside the artwork). is:inline keeps it a blocking script at
       this position; it targets the root (which carries the scoped-style class) so
       the .v2-js selectors match. No JS → class never set → copy stays visible. -->
  <script is:inline>
    document.currentScript.parentElement.classList.add('v2-js');
  </script>

  <!-- Header -->
  <header class="v2-header">
    <div class="v2-header-inner">
      <a href="/" class="v2-logo">Mohit Tater</a>
      <nav class="v2-nav">
        <a href="/" class="v2-nav-link v2-nav-link-active">Home</a>
        <a href="/projects" class="v2-nav-link">Work</a>
        <a href="/about" class="v2-nav-link">About</a>
        <a href="#studio-footer" class="v2-nav-link v2-nav-cta" data-ph-cta="lets_talk" data-ph-location="nav">Let's talk</a>
      </nav>
      <button class="v2-menu-toggle" aria-label="Toggle menu">
        <span class="v2-menu-bar"></span>
        <span class="v2-menu-bar"></span>
      </button>
    </div>
  </header>

  <!-- Hero -->
  <section class="v2-hero" data-ph-section="hero" data-hero-concept="layers" data-hero-anim>
    <div class="v2-container v2-hero-wrap">
      <!-- Eyebrow lives at wrap level (not inside .v2-hero-copy) so grid areas
           can slot the deck between it and the headline on mobile. --line drives
           the copy stagger, so order no longer depends on DOM nesting. -->
      <p class="v2-eyebrow v2-hero-line" style="--line: 0">Design Engineer &amp; Product Partner</p>

      <div class="v2-hero-copy">
        <h1 class="v2-headline v2-hero-line" style="--line: 1">I ship products, <em>end to end.</em></h1>
        <p class="v2-subtext v2-hero-line" style="--line: 2">
          One partner, from first sketch to shipped &mdash; for founders and teams building something new.
        </p>
        <div class="v2-hero-actions v2-hero-line" style="--line: 3">
          <a href="https://cal.com/tatermohit/call-with-mohit-tater" class="v2-btn-primary">Book a call &rarr;</a>
          <a href="/projects" class="v2-btn-text">See my work &rarr;</a>
        </div>
        <div class="v2-trust-bar v2-hero-line" style="--line: 4">
          <span class="v2-trust-item">10+ years shipping</span>
          <span class="v2-trust-sep">&middot;</span>
          <span class="v2-trust-item">10K+ users across my tools</span>
        </div>
      </div>

      <!-- Return-visit copy skeleton. On a same-session refresh the deck springs
           straight back onto the right while the copy resolves ~0.7s later — the
           left column would sit empty in the meantime. These placeholders fill
           that gap and crossfade out as the real copy lands. They occupy the same
           grid areas as the eyebrow/copy and are absolutely positioned within
           those cells, so they overlay without affecting layout. Shown only on
           the spring path (.is-spring); never on the first-visit overture (the
           deck is center-stage then) or for reduced-motion. aria-hidden — purely
           decorative. -->
      <span class="v2-hero-sk v2-hero-sk-eyebrow" aria-hidden="true">
        <span class="v2-sk v2-sk-eyebrow"></span>
      </span>
      <div class="v2-hero-sk v2-hero-sk-copy" aria-hidden="true">
        <span class="v2-sk v2-sk-head"></span>
        <span class="v2-sk v2-sk-head v2-sk-head-2"></span>
        <span class="v2-sk v2-sk-sub"></span>
        <span class="v2-sk v2-sk-sub v2-sk-sub-2"></span>
        <span class="v2-sk-actions">
          <span class="v2-sk v2-sk-btn"></span>
          <span class="v2-sk v2-sk-btn v2-sk-btn-2"></span>
        </span>
        <span class="v2-sk v2-sk-trust"></span>
      </div>

      <!-- Decorative hero artwork — purely visual, hidden from AT.
           Craft Layers: four discipline sheets cascade and a finished product
           window lands on top with a "Shipped" stamp. Layers are stacked in 3D
           (CSS); on load they converge into the cascade, then the stamp pops —
           which cues the copy to resolve in (Act 2). -->
      <div class="v2-hero-art" aria-hidden="true">
        <div class="v2-stack">
          {craftLayers.map((layer, j) => (
            <div class:list={['v2-layer', `v2-layer-${layer.key}`]} style={`--layer:${j}`}>
              <div class="v2-layer-tab">
                <span class="v2-layer-icon">
                  {layer.key === 'design' && (
                    <svg viewBox="0 0 20 20" fill="none">
                      <rect x="2.5" y="2.5" width="15" height="15" rx="2.5" stroke="currentColor" stroke-width="1.4" />
                      <circle cx="7.3" cy="7.3" r="1.7" fill="currentColor" />
                      <path d="M4 15l4-4 3.2 3.2L14 11.4 16 13.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                  {layer.key === 'engineering' && (
                    <svg viewBox="0 0 20 20" fill="none">
                      <path d="M7 5.5 3 10l4 4.5M13 5.5 17 10l-4 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                  {layer.key === 'qa' && (
                    <svg viewBox="0 0 20 20" fill="none">
                      <circle cx="10" cy="10" r="7.5" stroke="currentColor" stroke-width="1.4" />
                      <path d="M6.5 10.2l2.4 2.4L14 7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                  {layer.key === 'ai' && (
                    <svg viewBox="0 0 20 20" fill="none">
                      <path d="M10 2.5l1.7 5.8 5.8 1.7-5.8 1.7L10 17.5l-1.7-5.8L2.5 10l5.8-1.7L10 2.5z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                    </svg>
                  )}
                </span>
                <span class="v2-layer-label">{layer.label}</span>
              </div>
              <div class="v2-layer-face">
                <span class="v2-bar v2-bar-1"></span>
                <span class="v2-bar v2-bar-2"></span>
                <span class="v2-bar v2-bar-3"></span>
              </div>
            </div>
          ))}

          <!-- The product the layers add up to — lands last. A finished product:
               a mini screen of the build, its traction (10K+ users) and client
               rating, marked "Shipped" + live, with the maker's byline as the
               payoff. Every element maps to a real, defensible fact. -->
          <div class="v2-product" style="--layer:4">
            <div class="v2-product-bar">
              <span class="v2-dot"></span><span class="v2-dot"></span><span class="v2-dot"></span>
              <!-- Title denotes a finished product (not a URL): a "Shipped" mark. -->
              <span class="v2-shipped">
                <svg class="v2-shipped-tick" viewBox="0 0 12 12" fill="none">
                  <path d="M2.4 6.3l2.3 2.3L9.6 3.7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Shipped
              </span>
              <span class="v2-live-wrap">
                <span class="v2-live-label">Live</span>
                <span class="v2-live"></span>
              </span>
            </div>

            <div class="v2-product-body">
              <!-- Mini app screen standing in for the shipped product — a
                   recognizable finished UI (topbar · sidebar · KPIs · chart),
                   not a skeleton loader. -->
              <div class="v2-thumb-app">
                <span class="v2-app-topbar"><i></i><i></i><span class="v2-app-title"></span></span>
                <span class="v2-app-frame">
                  <span class="v2-app-side"><i class="on"></i><i></i><i></i><i></i></span>
                  <span class="v2-app-main">
                    <span class="v2-app-kpis"><i></i><i></i><i></i></span>
                    <span class="v2-app-row"></span>
                    <span class="v2-app-row short"></span>
                    <span class="v2-app-chartlet"><i style="--h: 40%"></i><i style="--h: 72%"></i><i style="--h: 56%"></i><i style="--h: 92%"></i></span>
                  </span>
                </span>
              </div>

              <div class="v2-product-meta">
                <div class="v2-meta-block">
                  <div class="v2-meta-head">
                    <span class="v2-meta-label">Users</span>
                    <span class="v2-meta-value">10K+</span>
                  </div>
                  <div class="v2-pv-chart">
                    <span style="--h: 40%"></span>
                    <span style="--h: 66%"></span>
                    <span style="--h: 52%"></span>
                    <span style="--h: 82%"></span>
                    <span style="--h: 96%"></span>
                  </div>
                </div>
                <span class="v2-meta-sep"></span>
                <div class="v2-meta-block">
                  <div class="v2-meta-head">
                    <span class="v2-meta-label">Clients</span>
                    <span class="v2-meta-value">5.0</span>
                  </div>
                  <div class="v2-rating">
                    <span class="v2-stars">★★★★★</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="v2-byline" data-art-resolve>
              <span class="v2-byline-text">Built by <strong>Mohit Tater</strong></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Work -->
  <section class="v2-projects" data-ph-section="projects_teaser">
    <div class="v2-container">
      <div class="v2-work-layout">
        <div class="v2-work-text">
          <p class="v2-section-label v2-reveal">Work</p>
          <h2 class="v2-work-headline v2-reveal">Things I've built, and <em>keep building.</em></h2>
          <p class="v2-work-body v2-reveal">A mix of curated projects, case studies, and AI toolkits &mdash; enterprise tools, SaaS products, and agent workflows I use daily. Some built for clients, some on my own time, most still evolving.</p>
        </div>

        <div class="v2-work-mosaic v2-reveal">
          <div class="v2-work-grid">
            <figure class="v2-thumb">
              <a class="v2-thumb-link" href="/projects#ops-workspace" data-ph-cta="open_project" data-ph-location="work_mosaic">
                <div class="v2-thumb-shot"><Image src={opsWorkspace} alt="Enterprise Ops Workspace" width={440} loading="lazy" class="v2-thumb-img" /></div>
                <figcaption class="v2-thumb-cap"><span class="v2-thumb-name">Ops Workspace</span><span class="v2-thumb-type">Enterprise App</span></figcaption>
              </a>
            </figure>
            <figure class="v2-thumb">
              <a class="v2-thumb-link" href="/projects#ai-resizing-studio" data-ph-cta="open_project" data-ph-location="work_mosaic">
                <div class="v2-thumb-shot"><Image src={aiResizing} alt="AI Resizing Studio" width={440} loading="lazy" class="v2-thumb-img" /></div>
                <figcaption class="v2-thumb-cap"><span class="v2-thumb-name">AI Resizing Studio</span><span class="v2-thumb-type">AI Pipeline</span></figcaption>
              </a>
            </figure>
            <figure class="v2-thumb">
              <a class="v2-thumb-link" href="/projects#dashboard-skill" data-ph-cta="open_project" data-ph-location="work_mosaic">
                <div class="v2-thumb-shot"><Image src={dashboards} alt="Designing Dashboards case study" width={440} loading="lazy" class="v2-thumb-img" /></div>
                <figcaption class="v2-thumb-cap"><span class="v2-thumb-name">Designing Dashboards</span><span class="v2-thumb-type">Case Study</span></figcaption>
              </a>
            </figure>
            <figure class="v2-thumb">
              <a class="v2-thumb-link" href="/projects#slicely" data-ph-cta="open_project" data-ph-location="work_mosaic">
                <div class="v2-thumb-shot"><Image src={slicely} alt="Slicely" width={440} loading="lazy" class="v2-thumb-img" /></div>
                <figcaption class="v2-thumb-cap"><span class="v2-thumb-name">Slicely</span><span class="v2-thumb-type">SaaS Product</span></figcaption>
              </a>
            </figure>
            <figure class="v2-thumb">
              <a class="v2-thumb-link" href="/projects#ai-toolkit" data-ph-cta="open_project" data-ph-location="work_mosaic">
                <div class="v2-thumb-shot"><Image src={aiToolkit} alt="AI Toolkit" width={440} loading="lazy" class="v2-thumb-img" /></div>
                <figcaption class="v2-thumb-cap"><span class="v2-thumb-name">AI Toolkit</span><span class="v2-thumb-type">Developer Tool</span></figcaption>
              </a>
            </figure>
            <figure class="v2-thumb">
              <a class="v2-thumb-link" href="/projects#reviewhub" data-ph-cta="open_project" data-ph-location="work_mosaic">
                <div class="v2-thumb-shot"><Image src={reviewhub} alt="ReviewHub" width={440} loading="lazy" class="v2-thumb-img" /></div>
                <figcaption class="v2-thumb-cap"><span class="v2-thumb-name">ReviewHub</span><span class="v2-thumb-type">Agentic Workflow</span></figcaption>
              </a>
            </figure>
          </div>
          <a href="/projects" class="v2-work-cta" data-ph-cta="see_all_projects" data-ph-location="work_mosaic">See all projects <span class="v2-cta-arrow">&rarr;</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- We'll make a good team (merged: who I work with + what I do) -->
  <section id="v2-fit" class="v2-audience" data-ph-section="fit">
    <div class="v2-container">
      <p class="v2-section-label v2-reveal">We&rsquo;ll make a good team</p>
      <h2 class="v2-audience-headline v2-reveal">You bring the <em>what</em>. I handle the <em>how</em>.</h2>

      <ul class="v2-audience-list">
        <li class="v2-audience-item v2-reveal">
          <div class="v2-team-head">
            <strong class="v2-audience-lead v2-team-lead">You've an idea, but aren't sure what to build.</strong>
            <span class="v2-team-badge">Product Shaping &amp; Strategy</span>
          </div>
          I review what you have, brainstorm with you, and hand back a clear plan for the UI, scope, and build order &mdash; so whoever writes the code isn't guessing.
        </li>
        <li class="v2-audience-item v2-reveal">
          <div class="v2-team-head">
            <strong class="v2-audience-lead v2-team-lead">You know what to build, not how.</strong>
            <span class="v2-team-badge">End-to-End Development</span>
          </div>
          Design, frontend, backend, QA &mdash; one person from a rough prototype (or blank page) to production. One partner instead of three freelancers, no hand-offs.
        </li>
        <li class="v2-audience-item v2-reveal">
          <div class="v2-team-head">
            <strong class="v2-audience-lead v2-team-lead">You want AI actually working for you.</strong>
            <span class="v2-team-badge">AI Workflows &amp; Automation</span>
          </div>
          Automating the day-to-day, a custom agent, or AI woven into how your team ships &mdash; without you becoming an AI expert.
        </li>
      </ul>
    </div>
  </section>

  <!-- Testimonials -->
  <section id="v2-testimonials" class="v2-work" data-ph-section="testimonials">
    <div class="v2-container">
      <div class="v2-testimonials-section">
        <p class="v2-section-label v2-reveal">What clients say</p>
        <h2 class="v2-testimonials-headline v2-reveal">Proof it works, <em>in their words.</em></h2>
        <div class="v2-testimonial-stack v2-reveal">

          <!-- Card 1: Fred Wilmot -->
          <div class="v2-tcard v2-tcard-active" data-testimonial="0">
            <div class="v2-tcard-header">
              <div class="v2-avatar">
                <Image src={fredImage} alt="Fred Wilmot" width={48} height={48} class="v2-avatar-img" />
              </div>
              <div class="v2-tcard-author">
                <span class="v2-author-name">
                  <a href="https://www.linkedin.com/in/fredwilmot/" target="_blank" rel="noopener noreferrer" class="v2-profile-link">Fred Wilmot <span class="v2-link-arrow">&nearr;</span></a>
                </span>
                <span class="v2-author-role">Founder &amp; 3x CISO</span>
              </div>
            </div>
            <div class="v2-tcard-body">
              <blockquote class="v2-quote">
                Mohit effectively translated complex product requirements into wireframes and effective UX designs. We brainstormed solutions given his experience and my requirements. I would work with Mohit again, especially in trying to translate a vision into design quickly and effectively.
              </blockquote>
            </div>
            <p class="v2-tcard-preview">&ldquo;Mohit effectively translated complex product requirements into&hellip;&rdquo;</p>
          </div>

          <!-- Card 2: Dean Teffer -->
          <div class="v2-tcard" data-testimonial="1">
            <div class="v2-tcard-header">
              <div class="v2-avatar">
                <Image src={deanImage} alt="Dean Teffer" width={48} height={48} class="v2-avatar-img" />
              </div>
              <div class="v2-tcard-author">
                <span class="v2-author-name">
                  <a href="https://www.linkedin.com/in/deanteffer" target="_blank" rel="noopener noreferrer" class="v2-profile-link">Dean Teffer <span class="v2-link-arrow">&nearr;</span></a>
                </span>
                <span class="v2-author-role">VP of AI, Arctic Wolf</span>
              </div>
            </div>
            <div class="v2-tcard-body">
              <blockquote class="v2-quote">
                Mohit is a highly talented product engineer and a pleasure to work with. There were many occasions where after analyzing our goals, he highlighted assumptions and gaps in our thinking, and then recommended paths forward. This really accelerated our work and led to a much better UI.
              </blockquote>
            </div>
            <p class="v2-tcard-preview">&ldquo;Mohit is a highly talented product engineer and a pleasure to work with&hellip;&rdquo;</p>
          </div>

          <!-- Card 3: Austin Mcdaniel -->
          <div class="v2-tcard" data-testimonial="2">
            <div class="v2-tcard-header">
              <div class="v2-avatar">
                <Image src={austinImage} alt="Austin Mcdaniel" width={48} height={48} class="v2-avatar-img" />
              </div>
              <div class="v2-tcard-author">
                <span class="v2-author-name">
                  <a href="https://www.linkedin.com/in/amcdnl" target="_blank" rel="noopener noreferrer" class="v2-profile-link">Austin Mcdaniel <span class="v2-link-arrow">&nearr;</span></a>
                </span>
                <span class="v2-author-role">CEO/Founder, GoodCode</span>
              </div>
            </div>
            <div class="v2-tcard-body">
              <blockquote class="v2-quote">
                Right off the bat, his fresh ideas and knack for nailing user needs made him stand out. Mohit isn't just talented; he's the kind of guy who's always eager to dig deeper and push the boundaries of design.
              </blockquote>
            </div>
            <p class="v2-tcard-preview">&ldquo;Right off the bat, his fresh ideas and knack for nailing user needs&hellip;&rdquo;</p>
          </div>

          <!-- Card 4: Alper Ortac -->
          <div class="v2-tcard" data-testimonial="3">
            <div class="v2-tcard-header">
              <div class="v2-avatar">
                <Image src={alperImage} alt="Alper Ortac" width={48} height={48} class="v2-avatar-img" />
              </div>
              <div class="v2-tcard-author">
                <span class="v2-author-name">
                  <a href="https://x.com/alperortac" target="_blank" rel="noopener noreferrer" class="v2-profile-link">Alper Ortac <span class="v2-link-arrow">&nearr;</span></a>
                </span>
                <span class="v2-author-role">Founder/CEO, GoodWatch</span>
              </div>
            </div>
            <div class="v2-tcard-body">
              <blockquote class="v2-quote">
                The UX audit was incredibly insightful and exceeded my expectations. Mohit not only provided detailed findings but also suggested alternative approaches to address issues. Half of the suggestions validated my own roadmap, while the other half introduced fresh, brilliant ideas, especially for improving user engagement.
              </blockquote>
            </div>
            <p class="v2-tcard-preview">&ldquo;The UX audit was incredibly insightful and exceeded my expectations&hellip;&rdquo;</p>
          </div>

          <!-- Card 5: Kyle Prinsloo -->
          <div class="v2-tcard" data-testimonial="4">
            <div class="v2-tcard-header">
              <div class="v2-avatar">
                <Image src={kyleImage} alt="Kyle Prinsloo" width={48} height={48} class="v2-avatar-img" />
              </div>
              <div class="v2-tcard-author">
                <span class="v2-author-name">
                  <a href="https://www.kyleprinsloo.com/" target="_blank" rel="noopener noreferrer" class="v2-profile-link">Kyle Prinsloo <span class="v2-link-arrow">&nearr;</span></a>
                </span>
                <span class="v2-author-role">Founder/CEO, ClientManager</span>
              </div>
            </div>
            <div class="v2-tcard-body">
              <blockquote class="v2-quote">
                Mohit gives exceptionally good UX advice and I love how he structures it based on importance. I highly recommend working with him.
              </blockquote>
            </div>
            <p class="v2-tcard-preview">&ldquo;Mohit gives exceptionally good UX advice and I love how he structures&hellip;&rdquo;</p>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- How I Work -->
  <section id="v2-process" class="v2-process" data-ph-section="process">
    <div class="v2-container">
      <p class="v2-section-label v2-reveal">How I work</p>
      <h2 class="v2-process-headline v2-reveal">Less overhead. <em>More shipping.</em></h2>

      <div class="v2-process-grid">
        <div class="v2-process-item v2-reveal">
          <h3 class="v2-process-title">End to end, one person</h3>
          <p class="v2-process-desc">Design, engineering, QA, automation &mdash; work that usually takes three specialists, done by one. No hand-offs.</p>
        </div>
        <div class="v2-process-item v2-reveal">
          <h3 class="v2-process-title">Weeks, not months</h3>
          <p class="v2-process-desc">Short engagements, a clear deliverable. Three useful things a quarter beats one bloated one.</p>
        </div>
        <div class="v2-process-item v2-reveal">
          <h3 class="v2-process-title">AI for speed, not autopilot</h3>
          <p class="v2-process-desc">Claude Code, Cursor, and custom agents to move fast &mdash; but I never ship code I wouldn't have written by hand.</p>
        </div>
        <div class="v2-process-item v2-reveal">
          <h3 class="v2-process-title">You talk to me</h3>
