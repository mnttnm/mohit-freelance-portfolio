  }

  .v2-tcard-active .v2-tcard-body {
    max-height: 300px;
    opacity: 1;
    margin-top: 20px;
  }

  .v2-tcard-active {
    background: rgba(255, 255, 255, 0.8);
    padding: 28px 28px;
    border-left: 3px solid var(--v2-accent);
