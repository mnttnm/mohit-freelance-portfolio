---
import { Image } from 'astro:assets';
import deanImage from '../../assets/dean-teffer.webp';
import austinImage from '../../assets/austin-mcdaniel.webp';
import alperImage from '../../assets/alper-ortac.webp';
import kyleImage from '../../assets/kyle-prinsloo.webp';
import fredImage from '../../assets/fred-wilmot.webp';
import StudioFooter from '../StudioFooter.astro';
---

<div data-variation-content="v2">

  <!-- Header -->
  <header class="v2-header">
    <div class="v2-header-inner">
      <a href="/" class="v2-logo">Mohit Tater</a>
      <nav class="v2-nav">
        <a href="/" class="v2-nav-link v2-nav-link-active">Home</a>
        <a href="/projects" class="v2-nav-link">Work</a>
        <a href="/about" class="v2-nav-link">About</a>
        <a href="#studio-footer" class="v2-nav-link v2-nav-cta">Let's talk</a>
      </nav>
      <button class="v2-menu-toggle" aria-label="Toggle menu">
        <span class="v2-menu-bar"></span>
        <span class="v2-menu-bar"></span>
      </button>
    </div>
  </header>

  <!-- Hero -->
  <section class="v2-hero">
    <div class="v2-container">
      <p class="v2-eyebrow v2-reveal">Product Engineer &amp; Consultant</p>
      <h1 class="v2-headline v2-reveal">I ship products, <em>end to end.</em></h1>
      <p class="v2-subtext v2-reveal">
        For founders, operators, and technical teams building something new. One person across design, engineering, and QA/automation. AI for speed, human judgment where it counts.
      </p>
      <div class="v2-hero-actions v2-reveal">
        <a href="https://cal.com/tatermohit/call-with-mohit-tater" class="v2-btn-primary">Book a call &rarr;</a>
        <a href="/projects" class="v2-btn-text">See my work &rarr;</a>
      </div>
      <div class="v2-trust-bar v2-reveal">
        <span class="v2-trust-item">10+ years shipping</span>
        <span class="v2-trust-sep">&middot;</span>
        <span class="v2-trust-item">10K+ users across my tools</span>
        <span class="v2-trust-sep">&middot;</span>
        <span class="v2-trust-item">Verizon, Arctic Wolf, funded startups</span>
      </div>
    </div>
  </section>

  <!-- Who I work with -->
  <section class="v2-audience">
    <div class="v2-container">
      <p class="v2-section-label v2-reveal">Who I work with</p>
      <h2 class="v2-audience-headline v2-reveal">You're probably a fit <em>if any of these sound like you.</em></h2>

      <ul class="v2-audience-list">
        <li class="v2-audience-item v2-reveal">You know what to build, but not how to build it &mdash; and you'd rather have one partner than three freelancers.</li>
        <li class="v2-audience-item v2-reveal">You have a rough prototype &mdash; Bolt, Lovable, v0, a weekend hack &mdash; and you want it turned into something professional, tested, and ready for real customers.</li>
        <li class="v2-audience-item v2-reveal">You're too early for specialists. You need one person to carry product, design, and code while you focus on the business.</li>
        <li class="v2-audience-item v2-reveal">You want AI actually working for you &mdash; automating your day-to-day, shipping an agent side-project, or bringing AI into your team's dev workflow.</li>
      </ul>
    </div>
  </section>

  <!-- Services -->
  <section id="v2-services" class="v2-services">
    <div class="v2-container">
      <p class="v2-section-label v2-reveal">What I do</p>

      <div class="v2-services-list">
        <div class="v2-service v2-reveal">
          <div class="v2-service-meta">
            <span class="v2-service-number">01</span>
            <span class="v2-service-duration">1&ndash;2 weeks</span>
          </div>
          <div class="v2-service-content">
            <h3 class="v2-service-title">Product Shaping &amp; Strategy</h3>
            <p class="v2-service-desc">For people with an idea who aren't sure what to build yet. We'll review what you have &mdash; sketches, notes, a rough prototype &mdash; brainstorm together, and hand back a clear plan for the UI, scope, and build sequence, so the next person who writes code (me, you, or someone else) isn't guessing.</p>
          </div>
        </div>

        <hr class="v2-divider" />

        <div class="v2-service v2-reveal">
          <div class="v2-service-meta">
            <span class="v2-service-number">02</span>
            <span class="v2-service-duration">2&ndash;8 weeks</span>
          </div>
          <div class="v2-service-content">
            <h3 class="v2-service-title">End-to-End Product Development</h3>
            <p class="v2-service-desc">From first prototype to a polished, production-ready product. Design, frontend, backend, infra, QA. One person, one engagement, whether you need a tight MVP to validate an idea, or a finished tool your customers can use today.</p>
          </div>
        </div>

        <hr class="v2-divider" />

        <div class="v2-service v2-reveal">
          <div class="v2-service-meta">
            <span class="v2-service-number">03</span>
            <span class="v2-service-duration">1&ndash;2 weeks</span>
          </div>
          <div class="v2-service-content">
            <h3 class="v2-service-title">AI Workflows &amp; Automation</h3>
            <p class="v2-service-desc">For founders, operators, and small teams who want AI actually working for them. Automate your day-to-day, build personalized agents, run an ambitious AI side-project while your team focuses on the core product, or bring AI into your team's dev workflow. You don't need to be an AI expert. I'll help you stay ahead of AI without drowning in it.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How I Work -->
  <section id="v2-process" class="v2-process">
    <div class="v2-container">
      <p class="v2-section-label v2-reveal">How I work</p>
      <h2 class="v2-process-headline v2-reveal">Less overhead. <em>More shipping.</em></h2>

      <div class="v2-process-grid">
        <div class="v2-process-item v2-reveal">
          <h3 class="v2-process-title">End to end, one person</h3>
          <p class="v2-process-desc">Design, engineering, QA, and automation. The work that usually takes three specialists, done by one. No vendor stack, no roster of juniors, no hand-offs between disciplines.</p>
        </div>
        <div class="v2-process-item v2-reveal">
          <h3 class="v2-process-title">Weeks, not months</h3>
          <p class="v2-process-desc">Short engagements with a clear deliverable. I'd rather ship three useful things in a quarter than one bloated one.</p>
        </div>
        <div class="v2-process-item v2-reveal">
          <h3 class="v2-process-title">AI where it helps, judgment where it matters</h3>
          <p class="v2-process-desc">I use Claude Code, Cursor, and custom agents to move fast. I don't ship code I wouldn't have written myself, and I'll tell you when AI is leading us somewhere we shouldn't go.</p>
        </div>
        <div class="v2-process-item v2-reveal">
          <h3 class="v2-process-title">You talk to me</h3>
          <p class="v2-process-desc">No account managers, no hand-offs, no "let me check with the team." If you have a question at 11pm, the person who can answer it is the one who wrote the code.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Work -->
  <section class="v2-projects">
    <div class="v2-container">
      <p class="v2-section-label v2-reveal">Work</p>
      <h2 class="v2-work-headline v2-reveal">I ship tools, products, and <em>explorations.</em></h2>
      <p class="v2-work-body v2-reveal">Production software at Verizon and Arctic Wolf, Figma plugins used by 8K+ designers, and AI-powered systems for founders and operators. Most client work is under NDA. The public side of my portfolio is side projects, open-source tools, and explorations I've shipped on my own time.</p>
      <div class="v2-work-actions v2-reveal">
        <a href="/projects" class="v2-btn-primary">See all projects &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section id="v2-testimonials" class="v2-work">
    <div class="v2-container">
      <div class="v2-testimonials-section">
        <p class="v2-section-label v2-reveal">What clients say</p>
        <div class="v2-testimonial-stack v2-reveal">

          <!-- Card 1: Fred Wilmot -->
          <div class="v2-tcard v2-tcard-active" data-testimonial="0">
            <div class="v2-tcard-header">
              <div class="v2-avatar">
                <Image src={fredImage} alt="Fred Wilmot" width={48} height={48} class="v2-avatar-img" />
              </div>
              <div class="v2-tcard-author">
                <span class="v2-author-name">
                  <a href="https://www.linkedin.com/in/fredwilmot/" target="_blank" rel="noopener noreferrer" class="v2-profile-link">Fred Wilmot <span class="v2-link-arrow">&nearr;</span></a>
                </span>
                <span class="v2-author-role">Founder &amp; 3x CISO</span>
              </div>
            </div>
            <div class="v2-tcard-body">
              <blockquote class="v2-quote">
                Mohit effectively translated complex product requirements into wireframes and effective UX designs. We brainstormed solutions given his experience and my requirements. I would work with Mohit again, especially in trying to translate a vision into design quickly and effectively.
              </blockquote>
            </div>
            <p class="v2-tcard-preview">&ldquo;Mohit effectively translated complex product requirements into&hellip;&rdquo;</p>
          </div>

          <!-- Card 2: Dean Teffer -->
          <div class="v2-tcard" data-testimonial="1">
            <div class="v2-tcard-header">
              <div class="v2-avatar">
                <Image src={deanImage} alt="Dean Teffer" width={48} height={48} class="v2-avatar-img" />
              </div>
              <div class="v2-tcard-author">
                <span class="v2-author-name">
                  <a href="https://www.linkedin.com/in/deanteffer" target="_blank" rel="noopener noreferrer" class="v2-profile-link">Dean Teffer <span class="v2-link-arrow">&nearr;</span></a>
                </span>
                <span class="v2-author-role">VP of AI, Arctic Wolf</span>
              </div>
            </div>
            <div class="v2-tcard-body">
              <blockquote class="v2-quote">
                Mohit is a highly talented product engineer and a pleasure to work with. There were many occasions where after analyzing our goals, he highlighted assumptions and gaps in our thinking, and then recommended paths forward. This really accelerated our work and led to a much better UI.
              </blockquote>
            </div>
            <p class="v2-tcard-preview">&ldquo;Mohit is a highly talented product engineer and a pleasure to work with&hellip;&rdquo;</p>
          </div>

          <!-- Card 3: Austin Mcdaniel -->
          <div class="v2-tcard" data-testimonial="2">
            <div class="v2-tcard-header">
              <div class="v2-avatar">
                <Image src={austinImage} alt="Austin Mcdaniel" width={48} height={48} class="v2-avatar-img" />
              </div>
              <div class="v2-tcard-author">
                <span class="v2-author-name">
                  <a href="https://www.linkedin.com/in/amcdnl" target="_blank" rel="noopener noreferrer" class="v2-profile-link">Austin Mcdaniel <span class="v2-link-arrow">&nearr;</span></a>
                </span>
                <span class="v2-author-role">CEO/Founder, GoodCode</span>
              </div>
            </div>
            <div class="v2-tcard-body">
              <blockquote class="v2-quote">
                Right off the bat, his fresh ideas and knack for nailing user needs made him stand out. Mohit isn't just talented; he's the kind of guy who's always eager to dig deeper and push the boundaries of design.
              </blockquote>
            </div>
            <p class="v2-tcard-preview">&ldquo;Right off the bat, his fresh ideas and knack for nailing user needs&hellip;&rdquo;</p>
          </div>

          <!-- Card 4: Alper Ortac -->
          <div class="v2-tcard" data-testimonial="3">
            <div class="v2-tcard-header">
              <div class="v2-avatar">
                <Image src={alperImage} alt="Alper Ortac" width={48} height={48} class="v2-avatar-img" />
              </div>
              <div class="v2-tcard-author">
                <span class="v2-author-name">
                  <a href="https://x.com/alperortac" target="_blank" rel="noopener noreferrer" class="v2-profile-link">Alper Ortac <span class="v2-link-arrow">&nearr;</span></a>
                </span>
                <span class="v2-author-role">Founder/CEO, GoodWatch</span>
              </div>
            </div>
            <div class="v2-tcard-body">
              <blockquote class="v2-quote">
                The UX audit was incredibly insightful and exceeded my expectations. Mohit not only provided detailed findings but also suggested alternative approaches to address issues. Half of the suggestions validated my own roadmap, while the other half introduced fresh, brilliant ideas, especially for improving user engagement.
              </blockquote>
            </div>
            <p class="v2-tcard-preview">&ldquo;The UX audit was incredibly insightful and exceeded my expectations&hellip;&rdquo;</p>
          </div>

          <!-- Card 5: Kyle Prinsloo -->
          <div class="v2-tcard" data-testimonial="4">
            <div class="v2-tcard-header">
              <div class="v2-avatar">
                <Image src={kyleImage} alt="Kyle Prinsloo" width={48} height={48} class="v2-avatar-img" />
              </div>
              <div class="v2-tcard-author">
                <span class="v2-author-name">
                  <a href="https://www.kyleprinsloo.com/" target="_blank" rel="noopener noreferrer" class="v2-profile-link">Kyle Prinsloo <span class="v2-link-arrow">&nearr;</span></a>
                </span>
                <span class="v2-author-role">Founder/CEO, ClientManager</span>
              </div>
            </div>
            <div class="v2-tcard-body">
              <blockquote class="v2-quote">
                Mohit gives exceptionally good UX advice and I love how he structures it based on importance. I highly recommend working with him.
              </blockquote>
            </div>
            <p class="v2-tcard-preview">&ldquo;Mohit gives exceptionally good UX advice and I love how he structures&hellip;&rdquo;</p>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="v2-about" class="v2-about">
    <div class="v2-container">
      <p class="v2-section-label v2-reveal">About</p>
      <h2 class="v2-about-headline v2-reveal">A decade of shipping products, <em>and counting.</em></h2>
      <p class="v2-about-body v2-reveal">10+ years working across design, engineering, and QA/automation, the three disciplines that usually take three different hires. Shipped at Verizon and Arctic Wolf, built tools used by 8K+ designers, and helped founders take their first product from sketch to production. Currently freelancing from Bengaluru, focused on AI-native product work.</p>
      <div class="v2-about-actions v2-reveal">
        <a href="/about" class="v2-btn-primary">More about me &rarr;</a>
      </div>
    </div>
  </section>

  <StudioFooter />

</div>

<style>
  /* ===== V2 Palette (shares Studio tokens so StudioFooter reuses cleanly) ===== */
  [data-variation-content="v2"] {
    --studio-bg: #FAF8F5;
    --studio-bg-header: rgba(250, 248, 245, 0.95);
    --studio-text: #1A1A1A;
    --studio-text-body: #4A4A4A;
    --studio-text-muted: #8A8A8A;
    --studio-accent: #2D5A3D;
    --studio-accent-light: rgba(45, 90, 61, 0.08);
    --studio-border: #E5E0DA;
    --studio-serif: 'DM Serif Display', Georgia, serif;
    --studio-sans: 'Instrument Sans', -apple-system, BlinkMacSystemFont, sans-serif;

    /* V2-scoped aliases (so rules below stay readable) */
    --v2-bg: var(--studio-bg);
    --v2-bg-header: var(--studio-bg-header);
    --v2-text: var(--studio-text);
    --v2-text-body: var(--studio-text-body);
    --v2-text-muted: var(--studio-text-muted);
    --v2-accent: var(--studio-accent);
    --v2-accent-light: var(--studio-accent-light);
    --v2-border: var(--studio-border);
    --v2-serif: var(--studio-serif);
    --v2-sans: var(--studio-sans);

    background: var(--v2-bg);
    color: var(--v2-text);
    font-family: var(--v2-sans);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  /* ===== Container ===== */
  .v2-container {
    max-width: var(--site-container-max);
    margin: 0 auto;
    padding: 0 var(--site-container-padding);
  }

  /* ===== Reveal Animation ===== */
  .v2-reveal {
    opacity: 0;
    transform: translateY(16px);
    animation: v2Reveal 0.7s cubic-bezier(0.23, 1, 0.32, 1) forwards;
  }

  .v2-reveal:nth-child(1) { animation-delay: 0.05s; }
  .v2-reveal:nth-child(2) { animation-delay: 0.12s; }
  .v2-reveal:nth-child(3) { animation-delay: 0.19s; }
  .v2-reveal:nth-child(4) { animation-delay: 0.26s; }

  @keyframes v2Reveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ===== Section Label ===== */
  .v2-section-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--v2-text-muted);
    margin-bottom: 48px;
  }

  /* ===== Header ===== */
  .v2-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--v2-bg-header);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--v2-border);
  }

  .v2-header-inner {
    max-width: var(--site-container-max);
    margin: 0 auto;
    padding: 0 var(--site-container-padding);
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .v2-logo {
    font-family: var(--v2-serif);
    font-size: 1.15rem;
    color: var(--v2-text);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .v2-nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .v2-nav-link {
    font-size: 0.85rem;
    color: var(--v2-text-body);
    text-decoration: none;
    transition: color 0.2s;
  }

  .v2-nav-link:hover {
    color: var(--v2-text);
  }

  .v2-nav-link-active {
    color: var(--v2-text);
    font-weight: 600;
  }

  .v2-nav-cta {
    color: var(--v2-accent);
    font-weight: 600;
  }

  .v2-menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .v2-menu-bar {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--v2-text);
    transition: transform 0.3s;
  }

  /* ===== Hero ===== */
  .v2-hero {
    padding: 160px 0 120px;
  }

  .v2-eyebrow {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--v2-accent);
    margin-bottom: 28px;
  }

  .v2-headline {
    font-family: var(--v2-serif);
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--v2-text);
    margin-bottom: 28px;
    max-width: 720px;
  }

  .v2-headline em {
    font-style: italic;
    color: var(--v2-accent);
  }

  .v2-subtext {
    font-size: 1.15rem;
    color: var(--v2-text-body);
    line-height: 1.7;
    max-width: 600px;
    margin-bottom: 40px;
  }

  .v2-hero-actions {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .v2-trust-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    font-size: 0.82rem;
    color: var(--v2-text-muted);
  }

  .v2-trust-item {
    letter-spacing: 0.01em;
  }

  .v2-trust-sep {
    color: var(--v2-border);
  }

  /* ===== Buttons ===== */
  .v2-btn-primary {
    display: inline-block;
    padding: 14px 32px;
    background: var(--v2-accent);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 6px;
    transition: background 0.25s, transform 0.2s;
  }

  .v2-btn-primary:hover {
    background: #234a31;
    transform: translateY(-1px);
  }

  .v2-btn-text {
    font-size: 0.9rem;
    color: var(--v2-text-body);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .v2-btn-text:hover {
    color: var(--v2-accent);
  }

  /* ===== Audience ===== */
  .v2-audience {
    padding: 40px 0 120px;
  }

  .v2-audience-headline {
    font-family: var(--v2-serif);
    font-size: clamp(1.4rem, 2.8vw, 1.9rem);
    color: var(--v2-text);
    margin-bottom: 48px;
    letter-spacing: -0.02em;
    line-height: 1.25;
    max-width: 640px;
  }

  .v2-audience-headline em {
    font-style: italic;
    color: var(--v2-accent);
  }

  .v2-audience-list {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 920px;
    counter-reset: audience;
  }

  .v2-audience-item {
    counter-increment: audience;
    position: relative;
    padding: 28px 0 28px 64px;
    font-family: var(--v2-sans);
    font-size: clamp(1rem, 1.35vw, 1.08rem);
    color: var(--v2-text);
    line-height: 1.65;
    letter-spacing: 0;
    border-bottom: 1px solid var(--v2-border);
  }

  .v2-audience-item:first-child {
    padding-top: 8px;
  }

  .v2-audience-item:last-child {
    border-bottom: none;
    padding-bottom: 8px;
  }

  .v2-audience-item::before {
    content: counter(audience, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 32px;
    font-family: var(--v2-sans);
    font-size: 0.75rem;
    color: var(--v2-accent);
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums;
  }

  .v2-audience-item:first-child::before {
    top: 12px;
  }

  /* ===== Services ===== */
  .v2-services {
    padding: 40px 0 120px;
  }

  .v2-services-list {
    max-width: 100%;
    background: var(--v2-accent-light);
    border: 1px solid var(--v2-border);
    border-radius: 12px;
    padding: 0 36px;
  }

  .v2-service {
    display: flex;
    gap: 32px;
    padding: 40px 0;
  }

  .v2-service-meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 92px;
    padding-top: 2px;
  }

  .v2-service-number {
    font-family: var(--v2-serif);
    font-size: 1rem;
    color: var(--v2-text-muted);
  }

