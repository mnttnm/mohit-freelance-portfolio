<style>
  /* ===== V2 Palette (shares Studio tokens so StudioFooter reuses cleanly) ===== */
  [data-variation-content="v2"] {
    /* Studio palette tokens come from src/styles/tokens.css. */
    /* V2-scoped aliases (so rules below stay readable) */
    --v2-bg: var(--studio-bg);
    --v2-bg-header: var(--studio-bg-header);
    --v2-text: var(--studio-text);
    --v2-text-body: var(--studio-text-body);
    --v2-text-muted: var(--studio-text-muted);
    --v2-accent: var(--studio-accent);
    --v2-accent-light: var(--studio-accent-light);
    --v2-border: var(--studio-border);
    --v2-serif: var(--studio-serif);
    --v2-sans: var(--studio-sans);

    background: var(--v2-bg);
    color: var(--v2-text);
    font-family: var(--v2-sans);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  /* ===== Container ===== */
  .v2-container {
    max-width: var(--site-container-max);
    margin: 0 auto;
    padding: 0 var(--site-container-padding);
  }

  /* ===== Reveal ===== */
  /* Content is present by default — motion is an enhancement, never a gate.
     Only users who haven't asked to reduce motion get the entrance, and the
     stagger delay is set per-group in JS so items cascade in reading order. */
  /* Hidden state is gated on `.v2-js` (added by script) so that with JS
     disabled or failed, every .v2-reveal stays fully visible. */
  @media (prefers-reduced-motion: no-preference) {
    .v2-js .v2-reveal {
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.55s var(--ease-out),
        transform 0.55s var(--ease-out);
      transition-delay: var(--reveal-delay, 0ms);
      will-change: opacity, transform;
    }

    /* Eyebrow labels settle in place rather than rising — a quieter entrance
       that reads differently from the content blocks it introduces. */
    .v2-js .v2-section-label.v2-reveal {
      transform: translateY(6px);
    }

    .v2-js .v2-reveal.is-in {
      opacity: 1;
      transform: none;
    }
  }

  /* ===== Section Label ===== */
  .v2-section-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--v2-text-muted);
    margin-bottom: 16px;
  }

  /* Keep titles and copy from leaving a single word orphaned on its own line.
     `balance` evens out short headings; `pretty` guards longer body text from
     widows/orphans without reflowing every line. */
  .v2-eyebrow,
  .v2-headline,
  .v2-work-headline,
  .v2-audience-headline,
  .v2-process-headline,
  .v2-about-headline,
  .v2-process-title {
    text-wrap: balance;
  }

  .v2-subtext,
  .v2-work-body,
  .v2-about-body,
  .v2-process-desc,
  .v2-audience-item {
    text-wrap: pretty;
  }

  /* ===== Header ===== */
  .v2-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--v2-bg-header);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--v2-border);
  }

  .v2-header-inner {
    max-width: var(--site-container-max);
    margin: 0 auto;
    padding: 0 var(--site-container-padding);
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .v2-logo {
    font-family: var(--v2-serif);
    font-size: var(--text-xl);
    color: var(--v2-text);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .v2-nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .v2-nav-link {
    font-size: var(--text-sm);
    color: var(--v2-text-body);
    text-decoration: none;
    transition: color 0.2s;
  }

  .v2-nav-link:hover {
    color: var(--v2-text);
  }

  .v2-nav-link-active {
    color: var(--v2-text);
    font-weight: 600;
  }

  .v2-nav-cta {
    color: var(--v2-accent);
    font-weight: 600;
  }

  .v2-menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .v2-menu-bar {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--v2-text);
    transition: transform 0.3s;
  }

  /* ===== Hero ===== */
  .v2-hero {
    padding: 150px 0 64px;
  }

  /* While the hero entrance plays, the rest of the page is held back (and scroll
     is locked by JS) so the hero owns the screen — everything after the hero
     fades in once the entrance finishes and the lock releases. Gated on .v2-js
     so no-JS users always get the full page. */
  /* Hidden from the very first paint (gated on .v2-js, which the inline script
     above sets pre-paint) so nothing below the hero — the work section first —
     ever flashes while the entrance plays. They fade in together the moment JS
     marks the hero settled (.is-hero-revealed). The failsafe animation reveals
     them on its own after 5s in case the entrance JS never completes, so content
     can't get stranded hidden. */
  .v2-js .v2-hero ~ * {
    opacity: 0;
    pointer-events: none;
    animation: v2-hero-failsafe 0.01s linear 5s forwards;
  }
  .v2-js.is-hero-revealed .v2-hero ~ * {
    opacity: 1;
    pointer-events: auto;
    animation: none;
    transition: opacity 0.6s ease;
  }
  @keyframes v2-hero-failsafe {
    to {
      opacity: 1;
      pointer-events: auto;
    }
  }

  /* The artwork lives behind the copy in the same canvas, not beside it —
     the hero is one composition, type and ink together. */
  .v2-hero-wrap {
    position: relative;
  }

  .v2-hero-copy {
    position: relative;
    z-index: 1;
    max-width: 720px;
  }

  /* Layers concept: copy sits left, the artifact stack sits right (desktop) —
     two halves of one frame. Copy keeps the page's default left alignment. */

  /* Act 2 — once the art resolves (JS adds .is-art-done), the copy lines rise
     in, staggered top-to-bottom. Gated on .v2-js so no-JS users see copy at once,
     and on no-preference so reduced-motion users get the finished hero instantly. */
  @media (prefers-reduced-motion: no-preference) {
    .v2-js .v2-hero[data-hero-anim] .v2-hero-line {
      opacity: 0;
      transform: translateY(12px);
      transition:
        opacity 0.6s var(--ease-out),
        transform 0.6s var(--ease-out);
    }

    /* The eyebrow settles in from a shorter rise than the content it introduces —
       a quieter entrance, matching the page's section labels. */
    .v2-js .v2-hero[data-hero-anim] .v2-eyebrow.v2-hero-line {
      transform: translateY(6px);
    }

    /* Copy resolves in reading order via --line (set inline per line), so the
       stagger no longer depends on DOM nesting — the eyebrow sits outside the
       copy block (for the mobile deck-between-eyebrow-and-headline layout) yet
       still leads the cascade. */
    .v2-js .v2-hero[data-hero-anim].is-art-done .v2-hero-line {
      opacity: 1;
      transform: none;
      transition-delay: calc(var(--line, 0) * 90ms);
    }

    /* Reduced motion: the art shows already-resolved, so the copy is too —
       no fade-up, the finished hero appears at once. */
    .v2-js .v2-hero[data-hero-anim].is-art-instant .v2-hero-line {
      transition: none;
    }
  }

  /* ===== Return-visit copy skeleton ===== */
  /* Live in the eyebrow/copy grid areas and fill those cells absolutely, so they
     overlay the (still-transparent) real copy without nudging layout. Hidden by
     default; the spring path reveals them, and they crossfade out the instant the
     copy resolves (.is-art-done). */
  .v2-hero-sk {
    display: none;
  }
  .v2-hero-wrap > .v2-hero-sk-eyebrow {
    grid-area: eyebrow;
  }
  .v2-hero-wrap > .v2-hero-sk-copy {
    grid-area: copy;
  }

  @media (prefers-reduced-motion: no-preference) {
    .v2-js .v2-hero.is-spring .v2-hero-sk {
      display: flex;
      position: absolute;
      inset: 0;
      z-index: 1;
      flex-direction: column;
      align-items: flex-start;
      opacity: 1;
      transition: opacity 0.4s ease;
    }
    /* Copy has landed — fade the placeholder out from under it. */
    .v2-js .v2-hero.is-spring.is-art-done .v2-hero-sk {
      opacity: 0;
      pointer-events: none;
    }
  }

  /* Individual placeholder bars: a soft warm-gray with a slow shimmer sweep,
     drawn from the studio border tone so they sit quietly on the page. */
  .v2-sk {
    display: block;
    border-radius: var(--radius-sm);
    background: linear-gradient(
      100deg,
      var(--v2-border) 18%,
      color-mix(in srgb, var(--v2-border) 45%, #fff) 38%,
      var(--v2-border) 58%
    );
    background-size: 220% 100%;
    animation: v2-sk-shimmer 1.6s ease-in-out infinite;
  }
  @keyframes v2-sk-shimmer {
    0% {
      background-position: 185% 0;
    }
    100% {
      background-position: -45% 0;
    }
  }

  .v2-sk-eyebrow {
    width: 220px;
    height: 11px;
    border-radius: var(--radius-xs);
  }
  .v2-sk-head {
    width: 80%;
    height: 38px;
  }
  .v2-sk-head-2 {
    width: 54%;
    margin-top: 14px;
  }
  .v2-sk-sub {
    width: 72%;
    height: 14px;
    border-radius: var(--radius-xs);
    margin-top: 30px;
  }
  .v2-sk-sub-2 {
    width: 60%;
    height: 14px;
    border-radius: var(--radius-xs);
    margin-top: 11px;
  }
  .v2-sk-actions {
    display: flex;
    gap: 16px;
    margin-top: 34px;
  }
  .v2-sk-btn {
    width: 138px;
    height: 48px;
    border-radius: var(--radius-pill);
  }
  .v2-sk-btn-2 {
    width: 112px;
  }
  .v2-sk-trust {
    width: 264px;
    height: 12px;
    border-radius: var(--radius-xs);
    margin-top: 34px;
  }

  /* ===== Hero artwork (decorative) — Craft Layers stack ===== */
  .v2-hero-art {
    position: relative;
    z-index: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Overture (both breakpoints): on the empty, scroll-locked page the deck
     assembles center-stage at a larger scale before docking to its resting slot.
     Desktop centers it in the hero's right cell; mobile centers it in the
     viewport to use the vertical space. JS measures the offset + scale into the
     --ov-* vars and applies this instantly (no transition). */
  .v2-hero.is-overture .v2-hero-art {
    transform: translate(var(--ov-dx, 0), var(--ov-dy, 0)) scale(var(--ov-scale, 1.18));
  }

  /* Dock: when the overture ends the deck slides + scales into its resting slot
     (the right cell on desktop, the squished band above the headline on mobile)
     as the copy resolves in. The transition is armed only for this leg (added by
     JS), so the overture itself snaps in without sliding. */
  .v2-hero-art.is-docking {
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* The stack is sized from its own knobs so the layout box always fits the
     cascade exactly — no magic numbers downstream, and mobile just retunes. */
  .v2-stack {
    --card-w: 256px;
    --card-h: 158px;
    --step-x: 24px;
    --step-y: 34px;
    position: relative;
    width: calc(var(--card-w) + 4 * var(--step-x));
    height: calc(var(--card-h) + 4 * var(--step-y));
    perspective: 1400px;
  }

  .v2-layer,
  .v2-product {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--card-w);
    min-height: var(--card-h);
    border-radius: var(--radius-lg);
    background: var(--v2-bg);
    border: 1px solid var(--v2-border);
    box-shadow:
      0 22px 48px -26px var(--ink-a40),
      0 3px 10px -4px var(--ink-a08);
    /* Each card sits a step down-right and a touch forward from the one behind,
       so the four disciplines cascade into the product window at the front. */
    transform: translate3d(
      calc(var(--layer) * var(--step-x)),
      calc(var(--layer) * var(--step-y)),
      calc(var(--layer) * 16px)
    );
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  /* ----- Discipline sheets ----- */
  .v2-layer-tab {
    display: flex;
    align-items: center;
    gap: 9px;
    height: calc(var(--step-y) + 6px);
    padding: 0 16px;
    border-bottom: 1px solid var(--v2-border);
  }

  .v2-layer-icon {
    display: inline-flex;
    width: 18px;
    height: 18px;
    color: var(--v2-accent);
  }

  .v2-layer-icon svg {
    width: 100%;
    height: 100%;
  }

  .v2-layer-label {
    font-family: var(--v2-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--v2-text);
    white-space: nowrap;
  }

  .v2-layer-face {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 18px 16px;
  }

  .v2-bar {
    height: 7px;
    border-radius: var(--radius-xs);
    background: var(--v2-accent-light);
  }
  .v2-bar-1 { width: 80%; }
  .v2-bar-2 { width: 62%; }
  .v2-bar-3 { width: 70%; }

  /* ----- Product window (front) — a finished, shipped product ----- */
  .v2-product {
    position: relative;
    overflow: hidden;
  }

  /* Browser chrome: traffic lights, a real URL pill (the name lives here,
     subtly), and a live status dot. Shared across all front-window treatments. */
  .v2-product-bar {
    display: flex;
    align-items: center;
    gap: 5px;
    height: 32px;
    padding: 0 12px;
    background: var(--v2-accent-light);
    border-bottom: 1px solid var(--v2-border);
  }

  .v2-dot {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-circle);
    background: var(--v2-border);
  }

  /* Window title: a "Shipped" mark — denotes a finished product, in place of a
     URL pill. A quiet, muted tag with a check — present, not shouting. */
  .v2-shipped {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-left: 8px;
    padding: 3px 8px 3px 7px;
    border-radius: var(--radius-sm);
    background: var(--v2-bg);
    border: 1px solid var(--v2-border);
    font-family: var(--v2-sans);
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--v2-text-muted);
  }

  .v2-shipped-tick {
    width: 10px;
    height: 10px;
    color: var(--v2-text-muted);
  }

  /* Live status — finished AND running. A small label beside a breathing dot. */
  .v2-live-wrap {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }

  .v2-live-label {
    font-family: var(--v2-sans);
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #3f9b54;
  }

  .v2-live {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-circle);
    background: #3f9b54;
    box-shadow: 0 0 0 3px rgba(63, 155, 84, 0.18);
  }

  /* Body: a mini screen of the build on the left, traction + rating on the right. */
  .v2-product-body {
    display: flex;
    gap: 13px;
    padding: 11px 14px 10px;
  }

  /* Mini app screen standing in for the shipped product — a recognizable
     finished UI (topbar, sidebar nav, KPI cards, a chart), not a skeleton. */
  .v2-thumb-app {
    flex: none;
    width: 86px;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-md);
    border: 1px solid var(--v2-border);
    overflow: hidden;
    background: #fff;
  }
  .v2-app-topbar {
    display: flex;
    align-items: center;
    gap: 3px;
    height: 13px;
    padding: 0 5px;
    background: var(--v2-accent);
  }
  .v2-app-topbar > i {
    width: 3px;
    height: 3px;
    border-radius: var(--radius-circle);
    background: var(--white-a40);
  }
  .v2-app-title {
    margin-left: 3px;
    width: 20px;
    height: 3px;
    border-radius: var(--radius-2xs);
    background: var(--white-a60);
  }
  .v2-app-frame {
    flex: 1;
    display: flex;
  }
  .v2-app-side {
    width: 19px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 7px 4px;
    background: var(--v2-accent-light);
    border-right: 1px solid var(--v2-border);
  }
  .v2-app-side > i {
    height: 3px;
    border-radius: var(--radius-2xs);
    background: var(--v2-accent);
