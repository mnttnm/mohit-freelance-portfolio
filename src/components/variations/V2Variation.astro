---
import { Image } from 'astro:assets';
import deanImage from '../../assets/dean-teffer.webp';
import austinImage from '../../assets/austin-mcdaniel.webp';
import alperImage from '../../assets/alper-ortac.webp';
import kyleImage from '../../assets/kyle-prinsloo.webp';
import fredImage from '../../assets/fred-wilmot.webp';
import opsWorkspace from '../../assets/work/ops-workspace.png';
import aiResizing from '../../assets/work/ai-resizing.png';
import dashboards from '../../assets/work/dashboards.png';
import slicely from '../../assets/work/slicely.png';
import aiToolkit from '../../assets/work/ai-toolkit.png';
import reviewhub from '../../assets/work/reviewhub.png';
import StudioFooter from '../StudioFooter.astro';

// ===== Hero art (generated at build time, deterministic) =====
// Concept A "Threads": strands of the practice converging into one shipped line.
function mulberry32(seed: number) {
  let s = seed | 0;
  return () => {
    s = (s + 0x6d2b79f5) | 0;
    let t = Math.imul(s ^ (s >>> 15), 1 | s);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const smoothstep = (t: number) => t * t * (3 - 2 * t);

// Horizontal thread: eases from (x0, y0) toward the focus with decaying wobble.
function threadPathH(x0: number, y0: number, fx: number, fy: number, wobble: number, rand: () => number) {
  const segs = 6;
  let d = `M ${x0} ${y0.toFixed(1)}`;
  let prev = { x: x0, y: y0 };
  for (let s = 1; s <= segs; s++) {
    const t = s / segs;
    const x = x0 + (fx - x0) * t;
    const w = (rand() - 0.5) * wobble * (1 - t);
    const y = s === segs ? fy : y0 + (fy - y0) * smoothstep(t) + w;
    const c1x = prev.x + (x - prev.x) * 0.45;
    const c2x = prev.x + (x - prev.x) * 0.62;
    d +=
      s === 1
        ? ` C ${c1x.toFixed(1)} ${prev.y.toFixed(1)}, ${c2x.toFixed(1)} ${y.toFixed(1)}, ${x.toFixed(1)} ${y.toFixed(1)}`
        : ` S ${c2x.toFixed(1)} ${y.toFixed(1)}, ${x.toFixed(1)} ${y.toFixed(1)}`;
    prev = { x, y };
  }
  return d;
}

// Vertical thread for the mobile weave — same idea, axes swapped.
function threadPathV(x0: number, y0: number, fx: number, fy: number, wobble: number, rand: () => number) {
  const segs = 6;
  let d = `M ${x0.toFixed(1)} ${y0}`;
  let prev = { x: x0, y: y0 };
  for (let s = 1; s <= segs; s++) {
    const t = s / segs;
    const y = y0 + (fy - y0) * t;
    const w = (rand() - 0.5) * wobble * (1 - t);
    const x = s === segs ? fx : x0 + (fx - x0) * smoothstep(t) + w;
    const c1y = prev.y + (y - prev.y) * 0.45;
    const c2y = prev.y + (y - prev.y) * 0.62;
    d +=
      s === 1
        ? ` C ${prev.x.toFixed(1)} ${c1y.toFixed(1)}, ${x.toFixed(1)} ${c2y.toFixed(1)}, ${x.toFixed(1)} ${y.toFixed(1)}`
        : ` S ${x.toFixed(1)} ${c2y.toFixed(1)}, ${x.toFixed(1)} ${y.toFixed(1)}`;
    prev = { x, y };
  }
  return d;
}

// Desktop weave: faint strands sweep IN from BOTH side edges and converge on a
// single center knot — mirror-symmetric across the vertical axis. The four
// labeled discipline threads mirror left/right and resolve into that same knot,
// which sits just above the copy: "everything → one shipped line", symmetric.
const AD = { w: 1200, h: 470, cx: 600, cy: 235 };
const rngD = mulberry32(7);
const weaveRowsD = Array.from({ length: 7 }, (_, i) => 40 + (i * (AD.h - 110)) / 6);
const weaveThreads = [
  ...weaveRowsD.map((y0, i) => ({
    d: threadPathH(8, y0, AD.cx, AD.cy, 118, rngD),
    opacity: +(0.24 + rngD() * 0.2).toFixed(2),
    i,
  })),
  ...weaveRowsD.map((y0, i) => ({
    d: threadPathH(AD.w - 8, y0, AD.cx, AD.cy, 118, rngD),
    opacity: +(0.24 + rngD() * 0.2).toFixed(2),
    i: 7 + i,
  })),
];
// Tags pin at the outer edges; the line eases from the tag toward the knot.
const labeledThreads = [
  { label: 'Design', x0: 78, y0: 96, anchor: 'start', tx: 78, ty: 80 },
  { label: 'Engineering', x0: 78, y0: 374, anchor: 'start', tx: 78, ty: 398 },
  { label: 'QA & Automation', x0: 1122, y0: 96, anchor: 'end', tx: 1122, ty: 80 },
  { label: 'AI Workflows', x0: 1122, y0: 374, anchor: 'end', tx: 1122, ty: 398 },
].map((t, j) => ({ ...t, j, d: threadPathH(t.x0, t.y0, AD.cx, AD.cy, 24, rngD), i: 14 + j }));

// Mobile weave: strands fall from the top edge and converge on a center knot —
// mirror-symmetric across the vertical axis. The four labeled threads fan from
// the top into the same knot; copy loads beneath once the weave resolves.
const AM = { w: 440, h: 360, cx: 220, cy: 300 };
const rngM = mulberry32(5);
const weaveColsM = Array.from({ length: 9 }, (_, i) => 26 + (i * (AM.w - 52)) / 8);
const weaveThreadsM = weaveColsM.map((x0, i) => ({
  d: threadPathV(x0, 4, AM.cx, AM.cy, 64, rngM),
  opacity: +(0.26 + rngM() * 0.22).toFixed(2),
  i,
}));
const labeledThreadsM = [
  { label: 'Design', x0: 58 },
  { label: 'Engineering', x0: 166 },
  { label: 'QA & Auto', x0: 274 },
  { label: 'AI Workflows', x0: 382 },
].map((t, j) => ({ ...t, j, d: threadPathV(t.x0, 46, AM.cx, AM.cy, 20, rngM), i: 9 + j }));
---

<div data-variation-content="v2">

  <!-- Header -->
  <header class="v2-header">
    <div class="v2-header-inner">
      <a href="/" class="v2-logo">Mohit Tater</a>
      <nav class="v2-nav">
        <a href="/" class="v2-nav-link v2-nav-link-active">Home</a>
        <a href="/projects" class="v2-nav-link">Work</a>
        <a href="/about" class="v2-nav-link">About</a>
        <a href="#studio-footer" class="v2-nav-link v2-nav-cta" data-ph-cta="lets_talk" data-ph-location="nav">Let's talk</a>
      </nav>
      <button class="v2-menu-toggle" aria-label="Toggle menu">
        <span class="v2-menu-bar"></span>
        <span class="v2-menu-bar"></span>
      </button>
    </div>
  </header>

  <!-- Hero -->
  <section class="v2-hero" data-ph-section="hero" data-hero-concept="threads" data-hero-anim>
    <div class="v2-container v2-hero-wrap">
      <div class="v2-hero-copy">
        <p class="v2-eyebrow v2-hero-line">Product Engineer &amp; Consultant</p>
        <h1 class="v2-headline v2-hero-line">I ship products, <em>end to end.</em></h1>
        <p class="v2-subtext v2-hero-line">
          One partner, from first sketch to shipped &mdash; for founders and teams building something new.
        </p>
        <div class="v2-hero-actions v2-hero-line">
          <a href="https://cal.com/tatermohit/call-with-mohit-tater" class="v2-btn-primary">Book a call &rarr;</a>
          <a href="/projects" class="v2-btn-text">See my work &rarr;</a>
        </div>
        <div class="v2-trust-bar v2-hero-line">
          <span class="v2-trust-item">10+ years shipping</span>
          <span class="v2-trust-sep">&middot;</span>
          <span class="v2-trust-item">10K+ users across my tools</span>
          <span class="v2-trust-sep">&middot;</span>
          <span class="v2-trust-item">Verizon, Arctic Wolf, funded startups</span>
        </div>
      </div>

      <!-- Decorative hero artwork — purely visual, hidden from AT -->
      <div class="v2-hero-art" aria-hidden="true">

        <!-- Concept A: "Threads" — the disciplines converge into one knot.
             Desktop: strands sweep in from both edges, mirror-symmetric, and
             resolve on a center knot that sits just above the copy. A radial
             mask keeps the strands faint where the copy reads, full at the frame. -->
        <svg data-concept="threads" class="v2-art-threads" viewBox={`0 0 ${AD.w} ${AD.h}`} fill="none" focusable="false">
          <defs>
            <radialGradient id="v2-weave-fade" cx="0.5" cy="0.34" r="0.64">
              <stop offset="0" stop-color="#fff" stop-opacity="0.1" />
              <stop offset="0.42" stop-color="#fff" stop-opacity="0.48" />
              <stop offset="1" stop-color="#fff" stop-opacity="1" />
            </radialGradient>
            <mask id="v2-weave-mask">
              <rect width={AD.w} height={AD.h} fill="url(#v2-weave-fade)" />
            </mask>
          </defs>
          <g mask="url(#v2-weave-mask)">
            {weaveThreads.map((t) => (
              <path
                class="v2-art-thread"
                d={t.d}
                pathLength="1"
                stroke="var(--v2-accent)"
                stroke-width="1.3"
                stroke-opacity={t.opacity}
                stroke-linecap="round"
                style={`--i:${t.i}`}
              />
            ))}
          </g>
          <g mask="url(#v2-weave-mask)">
            {labeledThreads.map((t) => (
              <path
                class:list={['v2-art-thread', 'v2-art-thread-key', { 'v2-art-thread-last': t.j === 3 }]}
                d={t.d}
                pathLength="1"
                stroke="var(--v2-accent)"
                stroke-width="1.7"
                stroke-opacity="0.75"
                stroke-linecap="round"
                style={`--j:${t.j}`}
              />
            ))}
          </g>
          {labeledThreads.map((t) => (
            <text class="v2-art-tag" x={t.tx} y={t.ty} text-anchor={t.anchor} style={`--j:${t.j}`}>{t.label}</text>
          ))}
          <circle class="v2-art-pop" cx={AD.cx} cy={AD.cy} r="6.5" fill="var(--v2-accent)" />
          <circle class="v2-art-ring" cx={AD.cx} cy={AD.cy} r="15" stroke="var(--v2-accent)" stroke-opacity="0.5" stroke-width="1.5" />
        </svg>

        <!-- Mobile: strands fall from the top, mirror-symmetric, converging on a
             center knot; the copy loads beneath once the weave resolves. -->
        <svg data-concept="threads" class="v2-art-threads-m" viewBox={`0 0 ${AM.w} ${AM.h}`} fill="none" focusable="false">
          <defs>
            <radialGradient id="v2-weave-fade-m" cx="0.5" cy={AM.cy / AM.h} r="0.7">
              <stop offset="0" stop-color="#fff" stop-opacity="0.08" />
              <stop offset="0.45" stop-color="#fff" stop-opacity="0.36" />
              <stop offset="1" stop-color="#fff" stop-opacity="1" />
            </radialGradient>
            <mask id="v2-weave-mask-m">
              <rect width={AM.w} height={AM.h} fill="url(#v2-weave-fade-m)" />
            </mask>
          </defs>
          <g mask="url(#v2-weave-mask-m)">
            {weaveThreadsM.map((t) => (
              <path
                class="v2-art-thread"
                d={t.d}
                pathLength="1"
                stroke="var(--v2-accent)"
                stroke-width="1.4"
                stroke-opacity={t.opacity}
                stroke-linecap="round"
                style={`--i:${t.i}`}
              />
            ))}
          </g>
          <g mask="url(#v2-weave-mask-m)">
            {labeledThreadsM.map((t) => (
              <path
                class:list={['v2-art-thread', 'v2-art-thread-key', { 'v2-art-thread-last': t.j === 3 }]}
                d={t.d}
                pathLength="1"
                stroke="var(--v2-accent)"
                stroke-width="1.6"
                stroke-opacity="0.75"
                stroke-linecap="round"
                style={`--j:${t.j}`}
              />
            ))}
          </g>
          {labeledThreadsM.map((t) => (
            <text class="v2-art-tag v2-art-tag-m" x={t.x0} y="22" text-anchor="middle" style={`--j:${t.j}`}>{t.label}</text>
          ))}
          <circle class="v2-art-pop" cx={AM.cx} cy={AM.cy} r="5" fill="var(--v2-accent)" />
          <circle class="v2-art-ring" cx={AM.cx} cy={AM.cy} r="11.5" stroke="var(--v2-accent)" stroke-opacity="0.45" stroke-width="1.4" />
        </svg>
      </div>
    </div>
  </section>

  <!-- Work -->
  <section class="v2-projects" data-ph-section="projects_teaser">
    <div class="v2-container">
      <div class="v2-work-layout">
        <div class="v2-work-text">
          <p class="v2-section-label v2-reveal">Work</p>
          <h2 class="v2-work-headline v2-reveal">Things I've built, and <em>keep building.</em></h2>
          <p class="v2-work-body v2-reveal">A mix of curated projects, case studies, and AI toolkits &mdash; enterprise tools, SaaS products, and agent workflows I use daily. Some built for clients, some on my own time, most still evolving.</p>
        </div>

        <div class="v2-work-mosaic v2-reveal">
          <div class="v2-work-grid">
            <figure class="v2-thumb">
              <div class="v2-thumb-shot"><Image src={opsWorkspace} alt="Enterprise Ops Workspace" width={440} loading="lazy" class="v2-thumb-img" /></div>
              <figcaption class="v2-thumb-cap"><span class="v2-thumb-name">Ops Workspace</span><span class="v2-thumb-type">Enterprise App</span></figcaption>
            </figure>
            <figure class="v2-thumb">
              <div class="v2-thumb-shot"><Image src={aiResizing} alt="AI Resizing Studio" width={440} loading="lazy" class="v2-thumb-img" /></div>
              <figcaption class="v2-thumb-cap"><span class="v2-thumb-name">AI Resizing Studio</span><span class="v2-thumb-type">AI Pipeline</span></figcaption>
            </figure>
            <figure class="v2-thumb">
              <div class="v2-thumb-shot"><Image src={dashboards} alt="Designing Dashboards case study" width={440} loading="lazy" class="v2-thumb-img" /></div>
              <figcaption class="v2-thumb-cap"><span class="v2-thumb-name">Designing Dashboards</span><span class="v2-thumb-type">Case Study</span></figcaption>
            </figure>
            <figure class="v2-thumb">
              <div class="v2-thumb-shot"><Image src={slicely} alt="Slicely" width={440} loading="lazy" class="v2-thumb-img" /></div>
              <figcaption class="v2-thumb-cap"><span class="v2-thumb-name">Slicely</span><span class="v2-thumb-type">SaaS Product</span></figcaption>
            </figure>
            <figure class="v2-thumb">
              <div class="v2-thumb-shot"><Image src={aiToolkit} alt="AI Toolkit" width={440} loading="lazy" class="v2-thumb-img" /></div>
              <figcaption class="v2-thumb-cap"><span class="v2-thumb-name">AI Toolkit</span><span class="v2-thumb-type">Developer Tool</span></figcaption>
            </figure>
            <figure class="v2-thumb">
              <div class="v2-thumb-shot"><Image src={reviewhub} alt="ReviewHub" width={440} loading="lazy" class="v2-thumb-img" /></div>
              <figcaption class="v2-thumb-cap"><span class="v2-thumb-name">ReviewHub</span><span class="v2-thumb-type">Agentic Workflow</span></figcaption>
            </figure>
          </div>
          <a href="/projects" class="v2-work-cta" data-ph-cta="see_all_projects" data-ph-location="work_mosaic">See all projects &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="v2-services" class="v2-services" data-ph-section="services">
    <div class="v2-container">
      <p class="v2-section-label v2-reveal">What I do</p>

      <div class="v2-services-list">
        <div class="v2-service v2-reveal">
          <div class="v2-service-meta">
            <span class="v2-service-number">01</span>
            <span class="v2-service-duration">1&ndash;2 weeks</span>
          </div>
          <div class="v2-service-content">
            <h3 class="v2-service-title">Product Shaping &amp; Strategy</h3>
            <p class="v2-service-desc">For people with an idea who aren't sure what to build yet. We'll review what you have &mdash; sketches, notes, a rough prototype &mdash; brainstorm together, and hand back a clear plan for the UI, scope, and build sequence, so the next person who writes code (me, you, or someone else) isn't guessing.</p>
          </div>
        </div>

        <hr class="v2-divider" />

        <div class="v2-service v2-reveal">
          <div class="v2-service-meta">
            <span class="v2-service-number">02</span>
            <span class="v2-service-duration">2&ndash;8 weeks</span>
          </div>
          <div class="v2-service-content">
            <h3 class="v2-service-title">End-to-End Product Development</h3>
            <p class="v2-service-desc">From first prototype to a polished, production-ready product. Design, frontend, backend, infra, QA. One person, one engagement, whether you need a tight MVP to validate an idea, or a finished tool your customers can use today.</p>
          </div>
        </div>

        <hr class="v2-divider" />

        <div class="v2-service v2-reveal">
          <div class="v2-service-meta">
            <span class="v2-service-number">03</span>
            <span class="v2-service-duration">1&ndash;2 weeks</span>
          </div>
          <div class="v2-service-content">
            <h3 class="v2-service-title">AI Workflows &amp; Automation</h3>
            <p class="v2-service-desc">For founders, operators, and small teams who want AI actually working for them. Automate your day-to-day, build personalized agents, run an ambitious AI side-project while your team focuses on the core product, or bring AI into your team's dev workflow. You don't need to be an AI expert. I'll help you stay ahead of AI without drowning in it.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section id="v2-testimonials" class="v2-work" data-ph-section="testimonials">
    <div class="v2-container">
      <div class="v2-testimonials-section">
        <p class="v2-section-label v2-reveal">What clients say</p>
        <div class="v2-testimonial-stack v2-reveal">

          <!-- Card 1: Fred Wilmot -->
          <div class="v2-tcard v2-tcard-active" data-testimonial="0">
            <div class="v2-tcard-header">
              <div class="v2-avatar">
