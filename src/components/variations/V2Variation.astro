<script>
  // Intersection Observer for scroll-triggered reveals + testimonial stack interaction
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.querySelector('[data-variation-content="v2"]');
    if (!root) return;

    const reveals = root.querySelectorAll('.v2-reveal');

    reveals.forEach((el) => {
      (el as HTMLElement).style.animationPlayState = 'paused';
      (el as HTMLElement).style.opacity = '0';
      (el as HTMLElement).style.transform = 'translateY(16px)';
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            el.style.animationPlayState = 'running';
            el.style.opacity = '';
            el.style.transform = '';
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
    );

    reveals.forEach((el) => observer.observe(el));

    // Mobile menu toggle
    const toggle = root.querySelector('.v2-menu-toggle');
    const nav = root.querySelector('.v2-nav') as HTMLElement | null;
    if (toggle && nav) {
      const openMenu = () => {
        nav.style.display = 'flex';
        nav.style.flexDirection = 'column';
        nav.style.position = 'absolute';
        nav.style.top = '64px';
        nav.style.left = '0';
        nav.style.right = '0';
        nav.style.background = 'var(--v2-bg)';
        nav.style.padding = '24px';
        nav.style.borderBottom = '1px solid var(--v2-border)';
        nav.style.gap = '16px';
      };
      const closeMenu = () => {
        nav.style.display = '';
        nav.style.flexDirection = '';
        nav.style.position = '';
        nav.style.top = '';
        nav.style.left = '';
        nav.style.right = '';
        nav.style.background = '';
        nav.style.padding = '';
        nav.style.borderBottom = '';
        nav.style.gap = '';
      };
      toggle.addEventListener('click', () => {
        const isOpen = nav.style.display === 'flex';
        isOpen ? closeMenu() : openMenu();
      });
      nav.querySelectorAll('.v2-nav-link').forEach((link) => {
        link.addEventListener('click', closeMenu);
      });
    }

    // Testimonial stacked cards — click to expand
    const tcards = root.querySelectorAll('.v2-tcard');
    tcards.forEach((card) => {
      card.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) return;
        if (card.classList.contains('v2-tcard-active')) return;

        tcards.forEach((c) => c.classList.remove('v2-tcard-active'));
        card.classList.add('v2-tcard-active');
      });
    });
  });
</script>
