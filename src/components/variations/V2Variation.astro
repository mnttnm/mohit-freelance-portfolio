  }
  .v2-app-side > i.on { opacity: 0.85; }
  .v2-app-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 7px 6px;
  }
  .v2-app-kpis {
    display: flex;
    gap: 4px;
  }
  .v2-app-kpis > i {
    flex: 1;
    height: 13px;
    border-radius: var(--radius-2xs);
    background: var(--v2-accent);
    opacity: 0.14;
  }
  .v2-app-kpis > i:first-child { opacity: 0.28; }
  .v2-app-row {
    height: 4px;
    border-radius: var(--radius-2xs);
    background: var(--v2-accent);
    opacity: 0.16;
  }
  .v2-app-row.short { width: 60%; }
  .v2-app-chartlet {
    margin-top: auto;
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 15px;
  }
  .v2-app-chartlet > i {
    flex: 1;
    height: var(--h);
    border-radius: var(--radius-2xs) var(--radius-2xs) 0 0;
    background: var(--v2-accent);
    opacity: 0.5;
  }

  .v2-product-meta {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 7px;
    min-width: 0;
    flex: 1;
  }

  .v2-meta-block {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* Metric header: the name on the left, its real value on the right —
     "Users 10K+", "Clients 5.0" — so every figure is anchored, not floating.
     This also keeps the rating clear of the stars (no inline crowding). */
  .v2-meta-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }

  /* Small caption that names the metric — the chart is user growth. */
  .v2-meta-label {
    font-family: var(--v2-sans);
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--v2-text-muted);
  }

  /* The metric's real value, sitting opposite its label. */
  .v2-meta-value {
    font-family: var(--v2-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--v2-text);
  }

  /* Hairline that decouples the usage chart from the rating below it. */
  .v2-meta-sep {
    height: 1px;
    background: var(--v2-border);
  }

  .v2-pv-chart {
    display: flex;
    align-items: flex-end;
    gap: 5px;
    height: 22px;
  }
  .v2-pv-chart span {
    width: 9px;
    height: var(--h);
    border-radius: var(--radius-2xs) var(--radius-2xs) 0 0;
    background: var(--v2-accent);
    opacity: 0.42;
