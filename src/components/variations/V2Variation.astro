  /* ===== Testimonials (stacked cards — same pattern as Studio) ===== */
  .v2-work {
    padding: 120px 0;
  }

  .v2-testimonials-section {
    position: relative;
    overflow: clip;
  }

  .v2-testimonials-section::before {
    content: '';
    position: absolute;
    top: -40px;
    left: -200px;
    right: -200px;
    bottom: -40px;
    background: radial-gradient(ellipse at center, var(--v2-accent-light) 0%, transparent 70%);
    pointer-events: none;
    z-index: -1;
  }

  .v2-testimonial-stack {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .v2-tcard {
    background: rgba(255, 255, 255, 0.5);
    border: 1px solid var(--v2-border);
    border-bottom: none;
    padding: 20px 28px;
    cursor: pointer;
    transition: background 0.25s, padding 0.35s ease;
    position: relative;
    overflow: hidden;
  }

  .v2-tcard:first-child {
    border-radius: 12px 12px 0 0;
  }

  .v2-tcard:last-child {
    border-bottom: 1px solid var(--v2-border);
    border-radius: 0 0 12px 12px;
  }

  .v2-tcard:only-child {
    border-radius: 12px;
    border-bottom: 1px solid var(--v2-border);
  }

  .v2-tcard-header {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .v2-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    border: 2px solid var(--v2-border);
    transition: width 0.3s, height 0.3s;
  }

  .v2-tcard-active .v2-avatar {
    width: 48px;
    height: 48px;
  }

  .v2-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .v2-tcard-author {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .v2-author-name {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--v2-text);
  }

  .v2-author-role {
    font-size: 0.78rem;
    color: var(--v2-text-muted);
  }

  .v2-profile-link {
    color: var(--v2-text);
    text-decoration: none;
    transition: color 0.2s;
  }

  .v2-profile-link:hover {
    color: var(--v2-accent);
  }

  .v2-link-arrow {
    font-size: 0.75rem;
    opacity: 0.5;
    transition: opacity 0.2s;
  }

  .v2-profile-link:hover .v2-link-arrow {
    opacity: 1;
  }

  .v2-tcard-body {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, opacity 0.3s ease, margin 0.3s ease;
