---
import { Image } from 'astro:assets';
import WorkbenchHeader from '../WorkbenchHeader.astro';
import WorkbenchFooter from '../WorkbenchFooter.astro';
import deanImage from '../../assets/dean-teffer.webp';
import austinImage from '../../assets/austin-mcdaniel.webp';
import alperImage from '../../assets/alper-ortac.webp';
import kyleImage from '../../assets/kyle-prinsloo.webp';
import fredImage from '../../assets/fred-wilmot.webp';

const audience = [
  "You know what to build, but not how to build it, and you'd rather have one partner than three freelancers.",
  "You have a rough prototype, Bolt, Lovable, v0, or a weekend hack, and want it turned into something professional.",
  "You're too early for specialists. You need one person to carry product, design, and code while you focus on the business.",
  "You want AI actually working for you, automating the day-to-day, shipping an agent side-project, or improving your team's dev workflow.",
];

const services = [
  {
    number: '01',
    duration: '1-2 weeks',
    title: 'Product Shaping & Strategy',
    body: "For people with an idea who aren't sure what to build yet. We review sketches, notes, rough prototypes, and turn them into a clear UI, scope, and build sequence.",
    tags: ['Product audit', 'UX review', 'Build plan'],
  },
  {
    number: '02',
    duration: '2-8 weeks',
    title: 'End-to-End Product Development',
    body: 'From first prototype to a polished, production-ready product. Design, frontend, backend, infra, and QA in one engagement.',
    tags: ['Design', 'React', 'Next.js', 'Full-stack'],
  },
  {
    number: '03',
    duration: '1-2 weeks',
    title: 'AI Workflows & Automation',
    body: "For founders, operators, and small teams who want AI actually working for them. I build practical automations and agents without forcing AI where it doesn't help.",
    tags: ['Automation', 'Agents', 'AI workflows'],
  },
];

const process = [
  {
    title: 'End to end, one person',
    body: 'Design, engineering, QA, and automation without hand-offs between disciplines.',
  },
  {
    title: 'Weeks, not months',
    body: "Short engagements with a clear deliverable. I'd rather ship three useful things in a quarter than one bloated one.",
  },
  {
    title: 'AI where it helps',
    body: "I use Claude Code, Cursor, Codex, and custom agents to move fast, then apply human judgment before anything ships.",
  },
  {
    title: 'You talk to me',
    body: 'No account managers and no vendor stack. The person answering questions is the person designing and writing the code.',
  },
];

const artifacts = [
  {
    title: 'Figma Variable Explorer',
    type: 'Figma Plugin',
    metric: '8,000+ users',
    image: '/projects/figma-variable-explorer.png',
    href: 'https://www.figma.com/community/plugin/1310888112326715990/figma-variable-explorer',
  },
  {
    title: 'Business Co-Pilot with Claude Code',
    type: 'Article',
    metric: 'AI ops system',
    image: '/projects/business-copilot.png',
    href: 'https://medium.com/@tatermohit/i-built-a-business-co-pilot-using-claude-code-heres-the-exact-system-cfe32ee59558',
  },
  {
    title: 'learning.log',
    type: 'Web App',
    metric: 'Capture pipeline',
    image: '/projects/learning-log.png',
    href: 'https://mohit.stream',
  },
  {
    title: 'Notes in Google Docs',
    type: 'Raycast Extension',
    metric: '1,000+ installs',
    image: '/projects/notes-in-gdocs.png',
    href: 'https://www.raycast.com/tatermohit/note-in-google-doc',
  },
];

const testimonials = [
  {
    name: 'Fred Wilmot',
    role: 'Founder & 3x CISO',
    image: fredImage,
    quote: 'Mohit effectively translated complex product requirements into wireframes and effective UX designs. I would work with Mohit again, especially in trying to translate a vision into design quickly and effectively.',
  },
  {
    name: 'Dean Teffer',
    role: 'VP of AI, Arctic Wolf',
    image: deanImage,
    quote: 'Mohit is a highly talented product engineer and a pleasure to work with. He highlighted assumptions and gaps in our thinking, then recommended paths forward.',
  },
  {
    name: 'Austin Mcdaniel',
    role: 'CEO/Founder, GoodCode',
    image: austinImage,
    quote: "Right off the bat, his fresh ideas and knack for nailing user needs made him stand out. He's always eager to dig deeper and push the boundaries of design.",
  },
  {
    name: 'Alper Ortac',
    role: 'Founder/CEO, GoodWatch',
    image: alperImage,
    quote: 'The UX audit was incredibly insightful and exceeded my expectations. Half of the suggestions validated my roadmap, while the other half introduced fresh, brilliant ideas.',
  },
  {
    name: 'Kyle Prinsloo',
    role: 'Founder/CEO, ClientManager',
    image: kyleImage,
    quote: 'Mohit gives exceptionally good UX advice and I love how he structures it based on importance. I highly recommend working with him.',
  },
];
---

<div data-variation-content="lab" class="lab-shell">
  <WorkbenchHeader active="home" />

  <div class="lab-side-rail" aria-hidden="true">
    <span></span>
    <strong>MOHIT + MODEL</strong>
  </div>

  <main>
    <section class="lab-hero">
      <div class="lab-container lab-hero-grid">
        <div class="lab-hero-copy lab-reveal">
          <p class="lab-hero-name">Mohit Tater</p>
          <h1>I ship products, end to end.</h1>
          <p class="lab-hero-text">
            One person across design, engineering, QA, and AI automation for founders,
            operators, and technical teams building something new.
          </p>

          <div class="lab-hero-actions">
            <a href="https://cal.com/tatermohit/call-with-mohit-tater" class="lab-btn lab-btn-primary">Book a call</a>
            <a href="/projects" class="lab-btn lab-btn-secondary">See the work</a>
          </div>

          <dl class="lab-stat-row" aria-label="Proof points">
            <div>
              <dt>10+</dt>
              <dd>years shipping</dd>
            </div>
            <div>
              <dt>10K+</dt>
              <dd>users across tools</dd>
            </div>
            <div>
              <dt>Verizon</dt>
              <dd>Arctic Wolf, startups</dd>
            </div>
          </dl>
        </div>

        <div class="lab-workbench lab-reveal" aria-label="Selected project artifacts">
          <div class="lab-workbench-topline">
            <span>Active work surface</span>
            <span>2026</span>
          </div>
          <div class="lab-artifact-stack">
            {artifacts.slice(0, 3).map((artifact, index) => (
              <a href={artifact.href} target="_blank" rel="noopener noreferrer" class={`lab-hero-artifact lab-hero-artifact-${index + 1}`}>
                <img src={artifact.image} alt={`Screenshot of ${artifact.title}`} loading={index === 0 ? 'eager' : 'lazy'} />
                <span>
                  <strong>{artifact.title}</strong>
                  <em>{artifact.metric}</em>
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="lab-section lab-section-tight" aria-labelledby="audience-title">
      <div class="lab-container lab-split">
        <div class="lab-section-copy lab-reveal">
          <p class="lab-section-kicker">Fit check</p>
          <h2 id="audience-title">You're probably a fit if any of these sound like you.</h2>
        </div>
        <ol class="lab-dossier-list">
          {audience.map((item) => (
            <li class="lab-reveal">
              <p>{item}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="services" class="lab-section" aria-labelledby="services-title">
      <div class="lab-container">
        <div class="lab-section-heading lab-reveal">
          <p class="lab-section-kicker">Services</p>
          <h2 id="services-title">Three ways I usually enter a project.</h2>
        </div>

        <div class="lab-protocols">
          {services.map((service) => (
            <article class="lab-protocol lab-reveal">
              <div class="lab-protocol-meta">
                <span>{service.number}</span>
                <em>{service.duration}</em>
              </div>
              <div class="lab-protocol-body">
                <h3>{service.title}</h3>
                <p>{service.body}</p>
              </div>
              <div class="lab-tag-list">
                {service.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="process" class="lab-section" aria-labelledby="process-title">
      <div class="lab-container lab-split">
        <div class="lab-section-copy lab-reveal">
          <p class="lab-section-kicker">Process</p>
          <h2 id="process-title">Less overhead. More shipping.</h2>
          <p>
            The operating model is deliberately simple: tight scope, direct feedback,
            working software, and clear calls on what should be automated.
          </p>
        </div>
        <div class="lab-process-grid">
          {process.map((item) => (
            <article class="lab-process-card lab-reveal">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="lab-section lab-work-section" aria-labelledby="work-title">
      <div class="lab-container">
        <div class="lab-section-heading lab-reveal">
          <p class="lab-section-kicker">Work</p>
          <h2 id="work-title">Public artifacts from a much larger private body of work.</h2>
          <p>
            Production software at Verizon and Arctic Wolf, Figma plugins used by
            thousands of designers, and AI-powered systems for founders and operators.
          </p>
        </div>

        <div class="lab-artifact-grid">
          {artifacts.map((artifact) => (
            <a href={artifact.href} target="_blank" rel="noopener noreferrer" class="lab-artifact-card lab-reveal">
              <img src={artifact.image} alt={`Screenshot of ${artifact.title}`} loading="lazy" />
              <span class="lab-artifact-meta">{artifact.type}</span>
              <strong>{artifact.title}</strong>
              <em>{artifact.metric}</em>
            </a>
          ))}
        </div>

        <div class="lab-section-action lab-reveal">
          <a href="/projects" class="lab-btn lab-btn-primary">See all projects</a>
        </div>
      </div>
    </section>

    <section class="lab-section" aria-labelledby="testimonials-title">
      <div class="lab-container">
        <div class="lab-section-heading lab-reveal">
          <p class="lab-section-kicker">Client notes</p>
          <h2 id="testimonials-title">What clients notice is the judgment, not just the output.</h2>
        </div>

        <div class="lab-quote-wall">
          {testimonials.map((testimonial) => (
            <figure class="lab-quote-card lab-reveal">
              <blockquote>{testimonial.quote}</blockquote>
              <figcaption>
                <Image src={testimonial.image} alt={testimonial.name} width={48} height={48} class="lab-avatar" />
                <span>
                  <strong>{testimonial.name}</strong>
                  <em>{testimonial.role}</em>
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="lab-section lab-about-band" aria-labelledby="about-title">
      <div class="lab-container lab-split">
        <div class="lab-section-copy lab-reveal">
          <p class="lab-section-kicker">About</p>
          <h2 id="about-title">A decade of shipping products, and counting.</h2>
        </div>
        <div class="lab-about-copy lab-reveal">
          <p>
            10+ years working across design, engineering, and QA/automation, the three
            disciplines that usually take three different hires. Shipped at Verizon and
            Arctic Wolf, built tools used by designers, and helped founders take products
            from sketch to production. Currently freelancing from Bengaluru, focused on
            AI-native product work.
          </p>
          <a href="/about" class="lab-btn lab-btn-secondary">More about me</a>
        </div>
      </div>
    </section>
  </main>

  <WorkbenchFooter />
</div>
