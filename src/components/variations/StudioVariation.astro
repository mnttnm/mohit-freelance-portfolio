<script>
  // Intersection Observer for scroll-triggered reveals
  document.addEventListener('DOMContentLoaded', () => {
    const studioRoot = document.querySelector('[data-variation-content="studio"]');
    if (!studioRoot) return;

    const reveals = studioRoot.querySelectorAll('.studio-reveal');

    // Reset initial state — animation is set in CSS but we re-trigger on scroll
    reveals.forEach((el) => {
      el.style.animationPlayState = 'paused';
      el.style.opacity = '0';
      el.style.transform = 'translateY(16px)';
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target;
            el.style.animationPlayState = 'running';
            el.style.opacity = '';
            el.style.transform = '';
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
    );

    reveals.forEach((el) => observer.observe(el));

    // Tooltip touch support for mobile
    const tooltipWrap = studioRoot.querySelector('.studio-tooltip-wrap');
    if (tooltipWrap) {
      tooltipWrap.addEventListener('click', (e) => {
        tooltipWrap.classList.toggle('studio-tooltip-active');
        e.stopPropagation();
      });
      document.addEventListener('click', () => {
        tooltipWrap.classList.remove('studio-tooltip-active');
      });
    }

    // Mobile menu toggle
    const toggle = studioRoot.querySelector('.studio-menu-toggle');
    const nav = studioRoot.querySelector('.studio-nav');
    if (toggle && nav) {
      const openMenu = () => {
        nav.style.display = 'flex';
        nav.style.flexDirection = 'column';
        nav.style.position = 'absolute';
        nav.style.top = '64px';
        nav.style.left = '0';
        nav.style.right = '0';
        nav.style.background = 'var(--studio-bg)';
        nav.style.padding = '24px';
        nav.style.borderBottom = '1px solid var(--studio-border)';
        nav.style.gap = '16px';
      };
      const closeMenu = () => {
        nav.style.display = '';
        nav.style.flexDirection = '';
        nav.style.position = '';
        nav.style.top = '';
        nav.style.left = '';
        nav.style.right = '';
        nav.style.background = '';
        nav.style.padding = '';
        nav.style.borderBottom = '';
        nav.style.gap = '';
      };
      toggle.addEventListener('click', () => {
        const isOpen = nav.style.display === 'flex';
        isOpen ? closeMenu() : openMenu();
      });
      nav.querySelectorAll('.studio-nav-link').forEach((link) => {
        link.addEventListener('click', closeMenu);
      });
    }
  });
</script>
