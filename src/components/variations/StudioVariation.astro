---
import { Image } from 'astro:assets';
import deanImage from '../../assets/dean-teffer.webp';
import austinImage from '../../assets/austin-mcdaniel.webp';
import alperImage from '../../assets/alper-ortac.webp';
import kyleImage from '../../assets/kyle-prinsloo.webp';
import fredImage from '../../assets/fred-wilmot.webp';
import StudioFooter from '../StudioFooter.astro';
---

<div data-variation-content="studio">

  <!-- Header -->
  <header class="studio-header">
    <div class="studio-header-inner">
      <a href="/" class="studio-logo">Mohit Tater</a>
      <nav class="studio-nav">
        <a href="/" class="studio-nav-link studio-nav-link-active">Home</a>
        <a href="/projects" class="studio-nav-link">Work</a>
        <a href="/about" class="studio-nav-link">About</a>
        <a href="#studio-footer" class="studio-nav-link studio-nav-cta">Let's talk</a>
      </nav>
      <button class="studio-menu-toggle" aria-label="Toggle menu">
        <span class="studio-menu-bar"></span>
        <span class="studio-menu-bar"></span>
      </button>
    </div>
  </header>

  <!-- Hero -->
  <section class="studio-hero">
    <div class="studio-container">
      <p class="studio-eyebrow studio-reveal"><span class="studio-tooltip-wrap"><span class="studio-tooltip-target">Product Engineer</span><span class="studio-tooltip">Equal parts engineer and product thinker. I don't just build. I make sure we're building the right thing.</span></span> & Consultant</p>
      <h1 class="studio-headline studio-reveal">I turn messy ideas into <em>useful products.</em></h1>
      <p class="studio-subtext studio-reveal">10+ years building at the intersection of design, engineering, and product strategy. I work with founders and operators, figuring out what to build, building it, and making sure AI is working for you, not against you.</p>
      <div class="studio-hero-actions studio-reveal">
        <a href="https://cal.com/tatermohit/call-with-mohit-tater" class="studio-btn-primary">Book a call &rarr;</a>
        <a href="/projects" class="studio-btn-text">See my work &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="studio-services" class="studio-services">
    <div class="studio-container">
      <p class="studio-section-label studio-reveal">What I do</p>

      <div class="studio-services-list">
        <div class="studio-service studio-reveal">
          <div class="studio-service-number">01</div>
          <div class="studio-service-content">
            <h3 class="studio-service-title">Product Consultation</h3>
            <p class="studio-service-desc">You have a vague idea and you've figured out the business logic and engineering behind it, but you're not sure what the best interface looks like to hand it over to users. I'll brainstorm with you, audit what exists, and shape a product that makes sense.</p>
          </div>
        </div>

        <hr class="studio-divider" />

        <div class="studio-service studio-reveal">
          <div class="studio-service-number">02</div>
          <div class="studio-service-content">
            <h3 class="studio-service-title">Full-Stack Product Development</h3>
            <p class="studio-service-desc">From first prototype to a polished, production-ready product. I design and build the whole thing, whether you need a quick MVP to validate an idea or a finished tool your customers can use today.</p>
          </div>
        </div>

        <hr class="studio-divider" />

        <div class="studio-service studio-reveal">
          <div class="studio-service-number">03</div>
          <div class="studio-service-content">
            <h3 class="studio-service-title">AI Workflows & Automation</h3>
            <p class="studio-service-desc">Be it optimising your existing AI workflows, creating custom skills and agents, figuring out the best tool for a given job, or enabling your own personal AI assistant, I help you get the most out of what's possible today.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

    <!-- Work -->
  <section class="studio-projects">
    <div class="studio-container">
      <p class="studio-section-label studio-reveal">Work</p>
      <h2 class="studio-work-headline studio-reveal">I build tools, ship products, and <em>explore ideas.</em></h2>
      <p class="studio-work-body studio-reveal">From Figma plugins used by 8K+ designers to AI-powered business systems, I'm always building something. Most of my client work is under NDA, but here's what I can show you: side projects, explorations, and open-source tools I've shipped on my own time.</p>
      <div class="studio-work-actions studio-reveal">
        <a href="/projects" class="studio-btn-primary">See all projects &rarr;</a>
      </div>
    </div>
  </section>
  
  <!-- Testimonials -->
  <section id="studio-work" class="studio-work">
    <div class="studio-container">
      <div class="studio-testimonials-section">
        <p class="studio-section-label studio-reveal">What clients say</p>
        <div class="studio-testimonial-stack studio-reveal">

          <!-- Card 1: Fred Wilmot (active by default) -->
          <div class="studio-tcard studio-tcard-active" data-testimonial="0">
            <div class="studio-tcard-header">
              <div class="studio-avatar">
                <Image src={fredImage} alt="Fred Wilmot" width={48} height={48} class="studio-avatar-img" />
              </div>
              <div class="studio-tcard-author">
                <span class="studio-author-name">
                  <a href="https://www.linkedin.com/in/fredwilmot/" target="_blank" rel="noopener noreferrer" class="studio-profile-link">Fred Wilmot <span class="studio-link-arrow">&nearr;</span></a>
                </span>
                <span class="studio-author-role">Founder & 3x CISO</span>
              </div>
            </div>
            <div class="studio-tcard-body">
              <blockquote class="studio-quote">
                Mohit effectively translated complex product requirements into wireframes and effective UX designs. We brainstormed solutions given his experience and my requirements. I would work with Mohit again, especially in trying to translate a vision into design quickly and effectively.
              </blockquote>
            </div>
            <p class="studio-tcard-preview">&ldquo;Mohit effectively translated complex product requirements into&hellip;&rdquo;</p>
          </div>

          <!-- Card 2: Dean Teffer -->
          <div class="studio-tcard" data-testimonial="1">
            <div class="studio-tcard-header">
              <div class="studio-avatar">
                <Image src={deanImage} alt="Dean Teffer" width={48} height={48} class="studio-avatar-img" />
              </div>
              <div class="studio-tcard-author">
                <span class="studio-author-name">
                  <a href="https://www.linkedin.com/in/deanteffer" target="_blank" rel="noopener noreferrer" class="studio-profile-link">Dean Teffer <span class="studio-link-arrow">&nearr;</span></a>
                </span>
                <span class="studio-author-role">VP of AI, Arctic Wolf</span>
              </div>
            </div>
            <div class="studio-tcard-body">
              <blockquote class="studio-quote">
                Mohit is a highly talented product engineer and a pleasure to work with. There were many occasions where after analyzing our goals, he highlighted assumptions and gaps in our thinking, and then recommended paths forward. This really accelerated our work and led to a much better UI.
              </blockquote>
            </div>
            <p class="studio-tcard-preview">&ldquo;Mohit is a highly talented product engineer and a pleasure to work with&hellip;&rdquo;</p>
          </div>

          <!-- Card 3: Austin Mcdaniel -->
          <div class="studio-tcard" data-testimonial="2">
            <div class="studio-tcard-header">
              <div class="studio-avatar">
                <Image src={austinImage} alt="Austin Mcdaniel" width={48} height={48} class="studio-avatar-img" />
              </div>
              <div class="studio-tcard-author">
                <span class="studio-author-name">
                  <a href="https://www.linkedin.com/in/amcdnl" target="_blank" rel="noopener noreferrer" class="studio-profile-link">Austin Mcdaniel <span class="studio-link-arrow">&nearr;</span></a>
                </span>
                <span class="studio-author-role">CEO/Founder, GoodCode</span>
              </div>
            </div>
            <div class="studio-tcard-body">
              <blockquote class="studio-quote">
                Right off the bat, his fresh ideas and knack for nailing user needs made him stand out. Mohit isn't just talented; he's the kind of guy who's always eager to dig deeper and push the boundaries of design.
              </blockquote>
            </div>
            <p class="studio-tcard-preview">&ldquo;Right off the bat, his fresh ideas and knack for nailing user needs&hellip;&rdquo;</p>
          </div>

          <!-- Card 4: Alper Ortac -->
          <div class="studio-tcard" data-testimonial="3">
            <div class="studio-tcard-header">
              <div class="studio-avatar">
                <Image src={alperImage} alt="Alper Ortac" width={48} height={48} class="studio-avatar-img" />
              </div>
              <div class="studio-tcard-author">
                <span class="studio-author-name">
                  <a href="https://x.com/alperortac" target="_blank" rel="noopener noreferrer" class="studio-profile-link">Alper Ortac <span class="studio-link-arrow">&nearr;</span></a>
                </span>
                <span class="studio-author-role">Founder/CEO, GoodWatch</span>
              </div>
            </div>
            <div class="studio-tcard-body">
              <blockquote class="studio-quote">
                The UX audit was incredibly insightful and exceeded my expectations. Mohit not only provided detailed findings but also suggested alternative approaches to address issues. Half of the suggestions validated my own roadmap, while the other half introduced fresh, brilliant ideas, especially for improving user engagement.
              </blockquote>
            </div>
            <p class="studio-tcard-preview">&ldquo;The UX audit was incredibly insightful and exceeded my expectations&hellip;&rdquo;</p>
          </div>

          <!-- Card 5: Kyle Prinsloo -->
          <div class="studio-tcard" data-testimonial="4">
            <div class="studio-tcard-header">
              <div class="studio-avatar">
                <Image src={kyleImage} alt="Kyle Prinsloo" width={48} height={48} class="studio-avatar-img" />
              </div>
              <div class="studio-tcard-author">
                <span class="studio-author-name">
                  <a href="https://www.kyleprinsloo.com/" target="_blank" rel="noopener noreferrer" class="studio-profile-link">Kyle Prinsloo <span class="studio-link-arrow">&nearr;</span></a>
                </span>
                <span class="studio-author-role">Founder/CEO, ClientManager</span>
              </div>
            </div>
            <div class="studio-tcard-body">
              <blockquote class="studio-quote">
                Mohit gives exceptionally good UX advice and I love how he structures it based on importance. I highly recommend working with him.
              </blockquote>
            </div>
            <p class="studio-tcard-preview">&ldquo;Mohit gives exceptionally good UX advice and I love how he structures&hellip;&rdquo;</p>
          </div>

        </div>
      </div>
    </div>
  </section>



  <!-- About -->
  <section id="studio-about" class="studio-about">
    <div class="studio-container">
      <p class="studio-section-label studio-reveal">About</p>
      <h2 class="studio-about-headline studio-reveal">A decade of shipping products, <em>and counting.</em></h2>
      <p class="studio-about-body studio-reveal">10+ years across design, engineering, and product strategy, from enterprise platforms at Verizon and Arctic Wolf to helping founders ship their first product. Currently freelancing from Bengaluru, deep in the AI tooling world.</p>
      <div class="studio-about-actions studio-reveal">
        <a href="/about" class="studio-btn-primary">More about me &rarr;</a>
      </div>
    </div>
  </section>

  <StudioFooter />

</div>

<style>
  /* ===== Studio Variation Palette ===== */
  [data-variation-content="studio"] {
    --studio-bg: #FAF8F5;
    --studio-bg-header: rgba(250, 248, 245, 0.95);
    --studio-text: #1A1A1A;
    --studio-text-body: #4A4A4A;
    --studio-text-muted: #8A8A8A;
    --studio-accent: #2D5A3D;
    --studio-accent-light: rgba(45, 90, 61, 0.08);
    --studio-border: #E5E0DA;
    --studio-serif: 'DM Serif Display', Georgia, serif;
    --studio-sans: 'Instrument Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  [data-variation-content="studio"] {
    background: var(--studio-bg);
    color: var(--studio-text);
    font-family: var(--studio-sans);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  /* ===== Container ===== */
  .studio-container {
    max-width: var(--site-container-max);
    margin: 0 auto;
    padding: 0 var(--site-container-padding);
  }

  /* ===== Reveal Animation ===== */
  .studio-reveal {
    opacity: 0;
    transform: translateY(16px);
    animation: studioReveal 0.7s cubic-bezier(0.23, 1, 0.32, 1) forwards;
  }

  .studio-reveal:nth-child(1) { animation-delay: 0.05s; }
  .studio-reveal:nth-child(2) { animation-delay: 0.12s; }
  .studio-reveal:nth-child(3) { animation-delay: 0.19s; }
  .studio-reveal:nth-child(4) { animation-delay: 0.26s; }

  @keyframes studioReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ===== Section Label ===== */
  .studio-section-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--studio-text-muted);
    margin-bottom: 48px;
  }

  /* ===== Header ===== */
  .studio-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--studio-bg-header);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--studio-border);
  }

  .studio-header-inner {
    max-width: var(--site-container-max);
    margin: 0 auto;
    padding: 0 var(--site-container-padding);
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .studio-logo {
    font-family: var(--studio-serif);
    font-size: 1.15rem;
    color: var(--studio-text);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .studio-nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .studio-nav-link {
    font-size: 0.85rem;
    color: var(--studio-text-body);
    text-decoration: none;
    transition: color 0.2s;
  }

  .studio-nav-link:hover {
    color: var(--studio-text);
  }

  .studio-nav-cta {
    color: var(--studio-accent);
    font-weight: 600;
  }

  .studio-menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .studio-menu-bar {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--studio-text);
    transition: transform 0.3s;
  }

  /* ===== Hero ===== */
  .studio-hero {
    padding: 160px 0 120px;
  }

  .studio-eyebrow {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--studio-accent);
    margin-bottom: 28px;
  }

  .studio-tooltip-wrap {
    position: relative;
    z-index: 100;
    display: inline;
  }

  .studio-tooltip-target {
    border-bottom: 1px dashed var(--studio-accent);
    padding-bottom: 2px;
    cursor: pointer;
  }

  .studio-tooltip {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 0;
    background: #fff;
    color: var(--studio-muted);
    font-family: var(--studio-sans);
    font-size: 0.82rem;
    font-weight: 400;
    font-style: italic;
    letter-spacing: 0;
    text-transform: none;
    line-height: 1.55;
    padding: 12px 16px;
    border-radius: 8px;
    width: max-content;
    max-width: 300px;
    border: 1px solid var(--studio-border);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
    pointer-events: none;
    z-index: 100;
  }

  .studio-tooltip-wrap:hover .studio-tooltip,
  .studio-tooltip-wrap.studio-tooltip-active .studio-tooltip {
    opacity: 1;
    visibility: visible;
  }

  .studio-headline {
    font-family: var(--studio-serif);
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--studio-text);
    margin-bottom: 28px;
    max-width: 720px;
  }

  .studio-headline em {
    font-style: italic;
    color: var(--studio-accent);
  }

  .studio-subtext {
    font-size: 1.15rem;
    color: var(--studio-text-body);
    line-height: 1.7;
    max-width: 540px;
    margin-bottom: 48px;
  }

  .studio-hero-actions {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  /* ===== Buttons ===== */
  .studio-btn-primary {
    display: inline-block;
    padding: 14px 32px;
    background: var(--studio-accent);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 6px;
    transition: background 0.25s, transform 0.2s;
  }

  .studio-btn-primary:hover {
    background: #234a31;
    transform: translateY(-1px);
  }

  .studio-btn-text {
    font-size: 0.9rem;
    color: var(--studio-text-body);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .studio-btn-text:hover {
    color: var(--studio-accent);
  }

  /* ===== Services ===== */
  .studio-services {
    padding: 120px 0;
  }

  .studio-services-list {
    max-width: 720px;
  }

  .studio-service {
    display: flex;
    gap: 32px;
    padding: 40px 0;
  }

  .studio-service-number {
    font-family: var(--studio-serif);
    font-size: 1rem;
    color: var(--studio-text-muted);
    min-width: 32px;
    padding-top: 2px;
  }

  .studio-service-content {
    flex: 1;
  }

  .studio-service-title {
    font-family: var(--studio-serif);
    font-size: 1.35rem;
    color: var(--studio-text);
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }

  .studio-service-desc {
    font-size: 1rem;
    color: var(--studio-text-body);
    line-height: 1.7;
  }

  .studio-divider {
    border: none;
    border-top: 1px solid var(--studio-border);
    margin: 0;
  }

  /* ===== Testimonials — Stacked Cards ===== */
  .studio-work {
    padding: 120px 0;
  }

  .studio-testimonials-section {
    position: relative;
  }

  .studio-testimonials-section::before {
    content: '';
    position: absolute;
    top: -40px;
    left: -200px;
    right: -200px;
    bottom: -40px;
    background: radial-gradient(ellipse at center, var(--studio-accent-light) 0%, transparent 70%);
    pointer-events: none;
    z-index: -1;
  }

  .studio-testimonial-stack {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* --- Card base --- */
  .studio-tcard {
    background: rgba(255, 255, 255, 0.5);
    border: 1px solid var(--studio-border);
    border-bottom: none;
    padding: 20px 28px;
    cursor: pointer;
    transition: background 0.25s, padding 0.35s ease;
    position: relative;
    overflow: hidden;
  }

  .studio-tcard:first-child {
    border-radius: 12px 12px 0 0;
  }

  .studio-tcard:last-child {
    border-bottom: 1px solid var(--studio-border);
    border-radius: 0 0 12px 12px;
  }

  .studio-tcard:only-child {
    border-radius: 12px;
    border-bottom: 1px solid var(--studio-border);
  }

  /* --- Card header (always visible) --- */
  .studio-tcard-header {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .studio-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    border: 2px solid var(--studio-border);
    transition: width 0.3s, height 0.3s;
  }

  .studio-tcard-active .studio-avatar {
    width: 48px;
    height: 48px;
  }

  .studio-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .studio-avatar-initials {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--studio-accent-light);
    border-color: var(--studio-accent);
  }

  .studio-avatar-initials::after {
    content: attr(data-initials);
    font-family: var(--studio-sans);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--studio-accent);
    letter-spacing: 0.02em;
  }

  .studio-tcard-author {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .studio-author-name {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--studio-text);
  }

  .studio-author-role {
    font-size: 0.78rem;
    color: var(--studio-text-muted);
  }

  .studio-profile-link {
    color: var(--studio-text);
    text-decoration: none;
    transition: color 0.2s;
  }

  .studio-profile-link:hover {
    color: var(--studio-accent);
  }

  .studio-link-arrow {
    font-size: 0.75rem;
    opacity: 0.5;
    transition: opacity 0.2s;
  }

  .studio-profile-link:hover .studio-link-arrow {
    opacity: 1;
  }

  /* --- Active card body (full quote) --- */
  .studio-tcard-body {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, opacity 0.3s ease, margin 0.3s ease;
    margin-top: 0;
  }

  .studio-tcard-active .studio-tcard-body {
    max-height: 300px;
    opacity: 1;
    margin-top: 20px;
  }

  .studio-tcard-active {
    background: rgba(255, 255, 255, 0.8);
    padding: 28px 28px;
    border-left: 3px solid var(--studio-accent);
    cursor: default;
  }

  .studio-quote {
    font-family: var(--studio-serif);
    font-size: 1.02rem;
    font-weight: 200;
    color: var(--studio-text-body);
    line-height: 1.8;
    font-style: italic;
    opacity: 0.85;
  }

  /* --- Collapsed card preview (truncated first line) --- */
  .studio-tcard-preview {
    display: none;
    font-family: var(--studio-serif);
    font-size: 0.85rem;
    font-weight: 300;
    color: var(--studio-text-muted);
    font-style: italic;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0;
    flex: 1;
    min-width: 0;
  }

  /* Show preview only on collapsed cards */
  .studio-tcard:not(.studio-tcard-active) {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto;
    align-items: center;
    gap: 0 16px;
  }

