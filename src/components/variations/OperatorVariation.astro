---
// Variation 2: "Operator" — dark, dense, proof-heavy, shows shipping velocity.
---

<div data-variation-content="operator">

  <!-- HEADER -->
  <header class="op-header">
    <div class="op-header-inner">
      <a href="#" class="op-monogram">MT</a>
      <nav class="op-nav">
        <a href="#op-services" class="op-nav-link">Services</a>
        <a href="#op-proof" class="op-nav-link">Proof</a>
        <a href="#op-stack" class="op-nav-link">Stack</a>
        <a href="#op-contact" class="op-nav-link">Contact</a>
      </nav>
      <a href="#op-contact" class="op-btn-outline">Book a call</a>
    </div>
  </header>

  <!-- HERO -->
  <section class="op-hero">
    <div class="op-container">
      <div class="op-status">
        <span class="op-status-dot"></span>
        Available for Q2 2026
      </div>
      <h1 class="op-hero-headline">Product Engineer.<br/>Design Thinker.<br/>Builder.</h1>
      <div class="op-stats-grid">
        <div class="op-stat-box">
          <span class="op-stat-number">10+</span>
          <span class="op-stat-label">Years in tech</span>
        </div>
        <div class="op-stat-box">
          <span class="op-stat-number">50+</span>
          <span class="op-stat-label">Projects shipped</span>
        </div>
        <div class="op-stat-box">
          <span class="op-stat-number">5K+</span>
          <span class="op-stat-label">Plugin users</span>
        </div>
        <div class="op-stat-box">
          <span class="op-stat-number">3</span>
          <span class="op-stat-label">Disciplines</span>
        </div>
      </div>
      <p class="op-hero-body">I design it, build it, and ship it. Full-stack product work for startups and teams that need to move fast.</p>
      <div class="op-hero-ctas">
        <a href="#op-contact" class="op-btn-primary">Book a call &rarr;</a>
        <a href="#op-proof" class="op-btn-ghost">View proof &darr;</a>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="op-services" class="op-section">
    <div class="op-container">
      <span class="op-section-label">// CAPABILITIES</span>
      <div class="op-services-grid">
        <div class="op-service-block">
          <span class="op-service-num">[01]</span>
          <h3 class="op-service-title">Product Strategy</h3>
          <ul class="op-service-list">
            <li>Audit what's broken</li>
            <li>Talk to your users</li>
            <li>Prioritize what to fix</li>
            <li>Clear roadmap out</li>
          </ul>
          <span class="op-service-timeline">Timeline: 1-2 weeks</span>
        </div>
        <div class="op-service-block">
          <span class="op-service-num">[02]</span>
          <h3 class="op-service-title">Build & Ship</h3>
          <ul class="op-service-list">
            <li>Design + full-stack dev</li>
            <li>React, Next.js, TypeScript</li>
            <li>Working product, not wireframes</li>
            <li>Deployed and ready</li>
          </ul>
          <span class="op-service-timeline">Timeline: 2-4 weeks</span>
        </div>
        <div class="op-service-block">
          <span class="op-service-num">[03]</span>
          <h3 class="op-service-title">Automate & Scale</h3>
          <ul class="op-service-list">
            <li>Find the repetitive work</li>
            <li>Build AI-powered workflows</li>
            <li>Connect your tools</li>
            <li>Free up your team</li>
          </ul>
          <span class="op-service-timeline">Timeline: 1-2 weeks per workflow</span>
        </div>
      </div>
    </div>
  </section>

  <!-- PROOF -->
  <section id="op-proof" class="op-section">
    <div class="op-container">
      <span class="op-section-label">// PROOF</span>
      <div class="op-proof-grid">
        <div class="op-project-card">
          <h4 class="op-project-name">Figma Variable Explorer</h4>
          <p class="op-project-desc">Design token browser used by 5K+ designers</p>
          <div class="op-project-tags">
            <span class="op-tag">Figma</span>
            <span class="op-tag">Plugin</span>
            <span class="op-tag">TypeScript</span>
          </div>
        </div>
        <div class="op-project-card">
          <h4 class="op-project-name">Raycast Notes</h4>
          <p class="op-project-desc">Quick capture extension, 250+ active users</p>
          <div class="op-project-tags">
            <span class="op-tag">Raycast</span>
            <span class="op-tag">Swift</span>
            <span class="op-tag">Productivity</span>
          </div>
        </div>
        <div class="op-project-card">
          <h4 class="op-project-name">Client Work</h4>
          <p class="op-project-desc">E-commerce migrations, DAM tools, SDR automation, content platforms</p>
          <div class="op-project-tags">
            <span class="op-tag">React</span>
            <span class="op-tag">Next.js</span>
            <span class="op-tag">Supabase</span>
            <span class="op-tag">AI</span>
          </div>
        </div>
      </div>

      <div class="op-testimonials-grid">
        <blockquote class="op-testimonial">
          <p class="op-testimonial-text">"Mohit is a rare find -- someone who can think through product strategy and then actually build it. He shipped a complete AI workflow tool for our team in under two weeks."</p>
          <footer class="op-testimonial-author">
            <strong>Dean Teffer</strong>
            <span>VP of AI, Arctic Wolf</span>
          </footer>
        </blockquote>
        <blockquote class="op-testimonial">
          <p class="op-testimonial-text">"One of the most versatile engineers I've worked with. Mohit bridges design and engineering in a way that most people just talk about. He actually does it."</p>
          <footer class="op-testimonial-author">
            <strong>Austin Mcdaniel</strong>
            <span>CEO, GoodCode</span>
          </footer>
        </blockquote>
        <blockquote class="op-testimonial">
          <p class="op-testimonial-text">"Mohit took our rough concept and turned it into a polished product. His ability to move fast without cutting corners is exactly what early-stage teams need."</p>
          <footer class="op-testimonial-author">
            <strong>Fred Wilmot</strong>
            <span>Founder & 3x CISO</span>
          </footer>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- STACK -->
  <section id="op-stack" class="op-section">
    <div class="op-container">
      <span class="op-section-label">// STACK</span>
      <div class="op-stack-groups">
        <div class="op-stack-group">
          <span class="op-stack-category">Design</span>
          <div class="op-chips">
            <span class="op-chip">Figma</span>
            <span class="op-chip">Prototyping</span>
            <span class="op-chip">Design Systems</span>
            <span class="op-chip">User Research</span>
          </div>
        </div>
        <div class="op-stack-group">
          <span class="op-stack-category">Engineering</span>
          <div class="op-chips">
            <span class="op-chip">React</span>
            <span class="op-chip">Next.js</span>
            <span class="op-chip">TypeScript</span>
            <span class="op-chip">Tailwind</span>
            <span class="op-chip">Vercel</span>
            <span class="op-chip">Supabase</span>
            <span class="op-chip">Node.js</span>
          </div>
        </div>
        <div class="op-stack-group">
          <span class="op-stack-category">AI & Automation</span>
          <div class="op-chips">
            <span class="op-chip">Claude</span>
            <span class="op-chip">Vercel AI SDK</span>
            <span class="op-chip">Agentic Workflows</span>
            <span class="op-chip">n8n</span>
            <span class="op-chip">Prompt Engineering</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="op-section">
    <div class="op-container">
      <span class="op-section-label">// ABOUT</span>
      <div class="op-about-grid">
        <div class="op-about-bio">
          <p>Mohit Tater. Bengaluru, India. 10+ years building products at the intersection of design and engineering. Previously: BlueJeans/Verizon, Query.ai, GoodCode. Now: independent, working with startups and growing teams.</p>
        </div>
        <div class="op-about-timeline">
          <div class="op-timeline-item">
            <span class="op-timeline-date">2024 --</span>
            <span class="op-timeline-role">Independent / Freelance</span>
          </div>
          <div class="op-timeline-item">
            <span class="op-timeline-date">2022 -- 24</span>
            <span class="op-timeline-role">Query.ai (acq. by Arctic Wolf)</span>
          </div>
          <div class="op-timeline-item">
            <span class="op-timeline-date">2019 -- 22</span>
            <span class="op-timeline-role">BlueJeans / Verizon</span>
          </div>
          <div class="op-timeline-item">
            <span class="op-timeline-date">2017 -- 19</span>
            <span class="op-timeline-role">GoodCode</span>
          </div>
          <div class="op-timeline-item">
            <span class="op-timeline-date">2015 -- 17</span>
            <span class="op-timeline-role">Early Career / Freelance</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="op-contact" class="op-section op-cta-section">
    <div class="op-container">
      <span class="op-section-label">// CONTACT</span>
      <h2 class="op-cta-headline">Ready to ship?</h2>
      <p class="op-cta-sub">Currently accepting 1-2 projects for Q2 2026.</p>
      <div class="op-cta-actions">
        <a href="https://cal.com/mohittater" target="_blank" rel="noopener noreferrer" class="op-btn-primary">Book a call &rarr;</a>
        <a href="mailto:mohittater.iiita@gmail.com" class="op-cta-email">mohittater.iiita@gmail.com</a>
      </div>
      <div class="op-social-links">
        <a href="https://twitter.com/mlooper1" target="_blank" rel="noopener noreferrer" class="op-social-link">Twitter</a>
        <a href="https://linkedin.com/in/mohittater" target="_blank" rel="noopener noreferrer" class="op-social-link">LinkedIn</a>
        <a href="https://github.com/mohittater" target="_blank" rel="noopener noreferrer" class="op-social-link">GitHub</a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="op-footer">
    <div class="op-container op-footer-inner">
      <span>&copy; 2026 Mohit Tater</span>
      <span>Built with Astro</span>
    </div>
  </footer>

</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@400;500;600;700;800&display=swap');

  /* ===== BASE ===== */
  [data-variation-content="operator"] {
    --op-bg: #09090B;
    --op-bg-elevated: #18181B;
    --op-bg-subtle: #111113;
    --op-border: #27272A;
    --op-border-subtle: #1E1E22;
    --op-text: #E4E4E7;
    --op-text-muted: #A1A1AA;
    --op-text-dim: #71717A;
    --op-accent: #F59E0B;
    --op-accent-hover: #FBBF24;
    --op-accent-dim: rgba(245, 158, 11, 0.15);
    --op-blue: #3B82F6;
    --op-mono: 'JetBrains Mono', ui-monospace, 'SF Mono', 'Cascadia Code', monospace;
    --op-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --op-space-1: 4px;
    --op-space-2: 8px;
    --op-space-3: 16px;
    --op-space-4: 24px;
    --op-space-5: 32px;
    --op-space-6: 48px;
    --op-space-7: 64px;
    --op-space-8: 96px;
    --op-radius: 6px;

    font-family: var(--op-sans);
    background: var(--op-bg);
    color: var(--op-text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  /* ===== ANIMATIONS ===== */
  @keyframes op-fade-up {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes op-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  @keyframes op-glow {
    0%, 100% { text-shadow: 0 0 8px rgba(245, 158, 11, 0.3); }
    50% { text-shadow: 0 0 16px rgba(245, 158, 11, 0.5); }
  }

  /* ===== LAYOUT ===== */
  .op-container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 var(--op-space-4);
  }

  .op-section {
    padding: var(--op-space-8) 0;
    animation: op-fade-up 0.6s ease-out both;
  }

  .op-section-label {
    display: block;
    font-family: var(--op-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--op-text-dim);
    margin-bottom: var(--op-space-5);
    text-transform: uppercase;
  }

  /* ===== HEADER ===== */
  .op-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(9, 9, 11, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--op-border-subtle);
  }

  .op-header-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 var(--op-space-4);
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--op-space-4);
  }

  .op-monogram {
    font-family: var(--op-mono);
    font-weight: 700;
    font-size: 18px;
    color: var(--op-accent);
    text-decoration: none;
    letter-spacing: 0.05em;
  }

  .op-nav {
    display: flex;
    gap: var(--op-space-4);
  }

  .op-nav-link {
    font-family: var(--op-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--op-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .op-nav-link:hover {
    color: var(--op-text);
  }

  .op-btn-outline {
    font-family: var(--op-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--op-accent);
    border: 1px solid var(--op-accent);
    padding: 6px 16px;
    border-radius: var(--op-radius);
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }

  .op-btn-outline:hover {
    background: var(--op-accent);
    color: var(--op-bg);
  }

  /* ===== HERO ===== */
  .op-hero {
    padding-top: calc(56px + var(--op-space-8));
    padding-bottom: var(--op-space-7);
    animation: op-fade-up 0.6s ease-out both;
  }

  .op-status {
    display: inline-flex;
    align-items: center;
    gap: var(--op-space-2);
    font-family: var(--op-mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--op-accent);
    margin-bottom: var(--op-space-5);
    padding: 6px 14px;
    background: var(--op-accent-dim);
    border-radius: 100px;
    border: 1px solid rgba(245, 158, 11, 0.2);
  }

  .op-status-dot {
    width: 8px;
    height: 8px;
    background: var(--op-accent);
    border-radius: 50%;
    animation: op-pulse 2s ease-in-out infinite;
  }

  .op-hero-headline {
    font-family: var(--op-sans);
    font-size: clamp(36px, 5.5vw, 64px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--op-text);
    margin: 0 0 var(--op-space-5) 0;
  }

  .op-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--op-space-3);
    margin-bottom: var(--op-space-5);
  }

  .op-stat-box {
    background: var(--op-bg-elevated);
    border: 1px solid var(--op-border);
    border-radius: var(--op-radius);
    padding: var(--op-space-3) var(--op-space-3);
    display: flex;
    flex-direction: column;
    gap: var(--op-space-1);
  }

  .op-stat-number {
    font-family: var(--op-mono);
    font-size: 28px;
    font-weight: 700;
    color: var(--op-accent);
    line-height: 1;
    animation: op-glow 3s ease-in-out infinite;
  }

  .op-stat-label {
    font-family: var(--op-mono);
    font-size: 11px;
    color: var(--op-text-dim);
    letter-spacing: 0.02em;
  }

  .op-hero-body {
    font-size: 16px;
    color: var(--op-text-muted);
    max-width: 640px;
    margin: 0 0 var(--op-space-5) 0;
    line-height: 1.6;
  }

  .op-hero-ctas {
    display: flex;
    gap: var(--op-space-3);
    align-items: center;
  }

  .op-btn-primary {
    font-family: var(--op-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--op-bg);
    background: var(--op-accent);
    padding: 10px 24px;
    border-radius: var(--op-radius);
    text-decoration: none;
    transition: background 0.2s;
    display: inline-block;
  }

  .op-btn-primary:hover {
    background: var(--op-accent-hover);
  }

  .op-btn-ghost {
    font-family: var(--op-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--op-text-muted);
    background: transparent;
    padding: 10px 24px;
    border-radius: var(--op-radius);
    border: 1px solid var(--op-border);
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
    display: inline-block;
  }

  .op-btn-ghost:hover {
    border-color: var(--op-text-muted);
    color: var(--op-text);
  }

  /* ===== SERVICES ===== */
  .op-services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--op-space-3);
  }

  .op-service-block {
    background: var(--op-bg-elevated);
    border: 1px solid var(--op-border);
    border-radius: var(--op-radius);
    padding: var(--op-space-4);
    display: flex;
    flex-direction: column;
    gap: var(--op-space-3);
  }

  .op-service-num {
    font-family: var(--op-mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--op-accent);
  }

  .op-service-title {
    font-family: var(--op-sans);
    font-size: 18px;
    font-weight: 700;
    color: var(--op-text);
    margin: 0;
    line-height: 1.2;
  }

  .op-service-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--op-space-2);
    flex: 1;
  }

  .op-service-list li {
    font-size: 14px;
    color: var(--op-text-muted);
    padding-left: 16px;
    position: relative;
    line-height: 1.5;
  }

  .op-service-list li::before {
    content: '-';
    position: absolute;
    left: 0;
    color: var(--op-text-dim);
    font-family: var(--op-mono);
  }

  .op-service-timeline {
    font-family: var(--op-mono);
    font-size: 11px;
    color: var(--op-text-dim);
    padding-top: var(--op-space-2);
    border-top: 1px solid var(--op-border-subtle);
  }

  /* ===== PROOF ===== */
  .op-proof-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--op-space-3);
    margin-bottom: var(--op-space-5);
  }

  .op-project-card {
    background: var(--op-bg-elevated);
    border: 1px solid var(--op-border);
    border-radius: var(--op-radius);
    padding: var(--op-space-4);
    display: flex;
    flex-direction: column;
    gap: var(--op-space-2);
  }

  .op-project-name {
    font-family: var(--op-sans);
    font-size: 16px;
    font-weight: 700;
    color: var(--op-text);
    margin: 0;
  }

  .op-project-desc {
    font-size: 14px;
    color: var(--op-text-muted);
    margin: 0;
    line-height: 1.5;
    flex: 1;
  }

  .op-project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--op-space-1);
    margin-top: var(--op-space-2);
  }

  .op-tag {
    font-family: var(--op-mono);
    font-size: 11px;
    color: var(--op-text-dim);
    background: var(--op-bg);
    border: 1px solid var(--op-border);
    border-radius: 4px;
    padding: 2px 8px;
  }

  .op-testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--op-space-3);
  }

  .op-testimonial {
    margin: 0;
    padding: var(--op-space-4);
    padding-left: calc(var(--op-space-4) + 3px);
    background: var(--op-bg-elevated);
    border: 1px solid var(--op-border);
    border-left: 3px solid var(--op-accent);
    border-radius: var(--op-radius);
    display: flex;
    flex-direction: column;
    gap: var(--op-space-3);
  }

  .op-testimonial-text {
    font-size: 14px;
    color: var(--op-text-muted);
    margin: 0;
    line-height: 1.6;
    font-style: normal;
    flex: 1;
  }

  .op-testimonial-author {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .op-testimonial-author strong {
    font-size: 13px;
    color: var(--op-text);
    font-weight: 600;
  }

  .op-testimonial-author span {
    font-family: var(--op-mono);
    font-size: 11px;
    color: var(--op-text-dim);
  }

  /* ===== STACK ===== */
  .op-stack-groups {
    display: flex;
    flex-direction: column;
    gap: var(--op-space-5);
  }

  .op-stack-group {
    display: flex;
    flex-direction: column;
    gap: var(--op-space-3);
  }

  .op-stack-category {
    font-family: var(--op-mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--op-text-dim);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .op-chips {
