<!-- Unified Footer: "Got a project in mind?" + Contact Form + CTA + Copyright -->
<footer id="studio-footer" class="studio-footer-unified">
  <div class="studio-container">
    <p class="studio-section-label studio-reveal">Got a project in mind?</p>
    <h2 class="studio-footer-headline studio-reveal">I'm taking on new projects. <em>Let's talk.</em></h2>
    <div class="studio-footer-grid studio-reveal">

      <!-- Card 1: Send a message -->
      <div class="studio-footer-card">
        <h3 class="studio-footer-card-heading">Send me a message</h3>
        <p class="studio-footer-card-subtext">Drop a message and I'll get back to you to schedule a free consultation call.</p>
        <form id="studio-contact-form" class="studio-contact-form">
          <div id="studio-form-success" class="studio-form-success" role="alert">
            <p>Thank you! Your message has been sent successfully.</p>
            <button type="button" class="studio-form-success-close" aria-label="Close message">&times;</button>
          </div>

          <!-- Honeypot -->
          <div class="studio-honeypot" aria-hidden="true">
            <input type="text" name="website" id="studio-hp" tabindex="-1" autocomplete="off" />
          </div>

          <div class="studio-form-group">
            <label for="studio-name">Name</label>
            <input type="text" id="studio-name" name="name" required placeholder="Your name" minlength="2" maxlength="50" />
          </div>

          <div class="studio-form-group">
            <label for="studio-email">Email</label>
            <input type="email" id="studio-email" name="email" required placeholder="your@email.com" />
          </div>

          <div class="studio-form-group">
            <label for="studio-message">Message</label>
            <textarea id="studio-message" name="message" rows="4" required minlength="10" maxlength="1000" placeholder="What can I help you with..."></textarea>
          </div>

          <button type="submit" class="studio-btn-primary studio-form-submit">Send Message &rarr;</button>

          <div id="studio-form-error" class="studio-form-error" role="alert"></div>
        </form>
      </div>

      <!-- Card 2: Prefer a call -->
      <div class="studio-footer-card studio-footer-card-cta">
        <h3 class="studio-footer-card-heading">Prefer a call?</h3>
        <p class="studio-footer-card-subtext">No pitch decks needed — let's just talk about what you're building.</p>
        <a href="https://cal.com/tatermohit/call-with-mohit-tater" class="studio-btn-primary">Book a call &rarr;</a>
        <div class="studio-footer-alt">
          <span class="studio-footer-alt-label">Or reach out directly</span>
          <a href="mailto:mohittater.iiita@gmail.com" class="studio-btn-text">mohittater.iiita@gmail.com</a>
        </div>
        <div class="studio-social">
          <a href="https://twitter.com/tatermohit" class="studio-social-link" target="_blank" rel="noopener noreferrer">Twitter</a>
          <span class="studio-social-sep">/</span>
          <a href="https://www.linkedin.com/in/tatermohit/" class="studio-social-link" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <span class="studio-social-sep">/</span>
          <a href="https://github.com/mnttnm" class="studio-social-link" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>

    </div>

    <p class="studio-footer-copyright">&copy; 2026 Mohit Tater &middot; Bengaluru, India</p>
  </div>
</footer>

<style>
  .studio-footer-unified {
    padding: 100px 0 48px;
    border-top: 1px solid var(--studio-border);
  }

  .studio-footer-headline {
    font-family: var(--studio-serif);
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    color: var(--studio-text);
    margin-bottom: 48px;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .studio-footer-headline em {
    font-style: italic;
  }

  .studio-footer-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: stretch;
  }

  .studio-footer-card {
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid var(--studio-border);
    border-radius: 12px;
    padding: 36px;
    display: flex;
    flex-direction: column;
  }

  .studio-footer-card-cta {
    background: var(--studio-accent-light);
  }

  .studio-footer-card-heading {
    font-family: var(--studio-serif);
    font-size: 1.35rem;
    color: var(--studio-text);
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }

  .studio-footer-card-subtext {
    font-size: 0.92rem;
    color: var(--studio-text-body);
    line-height: 1.65;
    margin-bottom: 28px;
  }

  /* Form styles */
  .studio-contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    flex: 1;
  }

  .studio-form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .studio-form-group label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--studio-text);
    letter-spacing: 0.02em;
  }

  .studio-form-group input,
  .studio-form-group textarea {
    padding: 12px 14px;
    border: 1px solid var(--studio-border);
    border-radius: 6px;
    background: var(--studio-bg);
    color: var(--studio-text);
    font-family: var(--studio-sans);
    font-size: 0.92rem;
    transition: border-color 0.2s;
  }

  .studio-form-group input:focus,
  .studio-form-group textarea:focus {
    outline: none;
    border-color: var(--studio-accent);
  }

  .studio-form-group input::placeholder,
  .studio-form-group textarea::placeholder {
    color: var(--studio-text-muted);
  }

  .studio-form-submit {
    align-self: flex-start;
    border: none;
    cursor: pointer;
    font-family: var(--studio-sans);
  }

  .studio-honeypot {
    display: none;
    visibility: hidden;
    position: absolute;
    left: -9999px;
  }

  .studio-form-success {
    display: none;
    padding: 14px 16px;
    background: #2D5A3D;
    color: #fff;
    border-radius: 6px;
    margin-bottom: 8px;
  }

  .studio-form-success.show {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .studio-form-success p {
    margin: 0;
    font-size: 0.88rem;
  }

  .studio-form-success-close {
    background: none;
    border: none;
    color: #fff;
    font-size: 1.4rem;
    cursor: pointer;
    padding: 0;
    line-height: 1;
  }

  .studio-form-success-close:hover {
    opacity: 0.7;
  }

  .studio-form-error {
    color: #c0392b;
    font-size: 0.85rem;
    display: none;
  }

  .studio-form-error.show {
    display: block;
  }

  /* CTA card */
  .studio-footer-card-cta .studio-btn-primary {
    align-self: flex-start;
  }

  .studio-footer-card-cta .studio-social {
    justify-content: flex-start;
  }

  .studio-footer-alt {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 8px;
  }

  .studio-footer-alt-label {
    font-size: 0.78rem;
    color: var(--studio-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  /* Social */
  .studio-social {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
  }

  .studio-social-link {
    font-size: 0.85rem;
    color: var(--studio-text-body);
    text-decoration: none;
    transition: color 0.2s;
  }

  .studio-social-link:hover {
    color: var(--studio-accent);
  }

  .studio-social-sep {
    color: var(--studio-border);
    font-size: 0.85rem;
  }

  /* Copyright */
  .studio-footer-copyright {
    font-size: 0.8rem;
    color: var(--studio-text-muted);
    letter-spacing: 0.02em;
    text-align: center;
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--studio-border);
  }

  /* Button styles (shared) */
  .studio-btn-primary {
    display: inline-block;
    padding: 14px 32px;
    background: var(--studio-accent);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 6px;
    transition: background 0.25s, transform 0.2s;
  }

  .studio-btn-primary:hover {
    background: #234a31;
    transform: translateY(-1px);
  }

  .studio-btn-text {
    font-size: 0.9rem;
    color: var(--studio-text-body);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .studio-btn-text:hover {
    color: var(--studio-accent);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .studio-footer-unified {
      padding: 80px 0 40px;
    }

    .studio-footer-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>

<script>
  // Contact form handling
  document.addEventListener('DOMContentLoaded', () => {
    const contactForm = document.getElementById('studio-contact-form') as HTMLFormElement | null;
    const formError = document.getElementById('studio-form-error');
    const formSuccess = document.getElementById('studio-form-success');

    function showFormError(msg: string) {
      if (formError) {
        formError.textContent = msg;
        formError.classList.add('show');
      }
    }

    function hideFormError() {
      if (formError) {
        formError.textContent = '';
        formError.classList.remove('show');
      }
    }

    function showFormSuccess() {
      if (formSuccess) {
        formSuccess.classList.add('show');
      }
    }

    function hideFormSuccess() {
      if (formSuccess) {
        formSuccess.classList.remove('show');
      }
    }

    // Close success message
    const footerEl = document.getElementById('studio-footer');
    const successClose = footerEl?.querySelector('.studio-form-success-close');
    if (successClose) {
      successClose.addEventListener('click', hideFormSuccess);
    }

    if (contactForm) {
      contactForm.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        hideFormError();
        hideFormSuccess();

        const form = e.target as HTMLFormElement;
        const honeypot = form.querySelector('#studio-hp') as HTMLInputElement;
        if (honeypot && honeypot.value) {
          showFormError('Form submission failed.');
          return;
        }

        const submitBtn = form.querySelector('.studio-form-submit') as HTMLButtonElement;
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = 'Sending\u2026';

        const formData = new FormData(form);
        // Remove honeypot from submission
        formData.delete('website');

        try {
          const response = await fetch('https://formsubmit.co/ajax/mohittater.iiita@gmail.com', {
            method: 'POST',
            body: formData,
          });

          if (response.ok) {
            showFormSuccess();
            form.reset();
          } else {
            showFormError('Something went wrong. Please try again or email me directly.');
          }
        } catch {
          showFormError('Network error. Please try again or email me directly.');
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalText;
        }
      });
    }
  });
</script>
