---
import { actions } from 'astro:actions';
---

<!-- Unified footer: "Got a project in mind?" + send-message form + 3 stacked action cards -->
<footer id="studio-footer" class="studio-footer-unified" data-ph-section="contact">
  <div class="studio-container">
    <p class="studio-footer-label studio-reveal">Got a project in mind?</p>
    <p class="studio-footer-subtitle studio-reveal">
      I'm always happy to chat, even if you're just exploring ideas and not sure what you need yet. No pitch, just a conversation.
    </p>

    <div class="studio-footer-grid studio-reveal">

      <!-- Left: send-message form -->
      <div class="studio-footer-card studio-footer-card--form">
        <h3 class="studio-footer-card-heading">Send me a message</h3>
        <p class="studio-footer-card-subtext">Drop a quick note and I'll get back within a day.</p>

        <form id="studio-contact-form" class="studio-contact-form" method="POST" action={actions.contact}>
          <div id="studio-form-success" class="studio-form-success" role="alert">
            <p>Thanks! I got your message and I'll reply within a day.</p>
            <button type="button" class="studio-form-success-close" aria-label="Close message">&times;</button>
          </div>

          <div class="studio-honeypot" aria-hidden="true">
            <input type="text" name="website" id="studio-hp" tabindex="-1" autocomplete="off" />
          </div>

          <div class="studio-form-group">
            <label for="studio-name">Name</label>
            <input type="text" id="studio-name" name="name" required placeholder="Your name" minlength="2" maxlength="50" />
          </div>

          <div class="studio-form-group">
            <label for="studio-email">Email</label>
            <input type="email" id="studio-email" name="email" required placeholder="your@email.com" />
          </div>

          <div class="studio-form-group studio-form-group--grow">
            <label for="studio-message">Message</label>
            <textarea id="studio-message" name="message" required minlength="10" maxlength="1000" placeholder="Tell me what you're working on."></textarea>
          </div>

          <button type="submit" class="studio-btn-primary studio-form-submit">Send message &rarr;</button>

          <div id="studio-form-error" class="studio-form-error" role="alert"></div>
        </form>
      </div>

      <!-- Right: three stacked action boxes -->
      <div class="studio-footer-actions">

        <div class="studio-footer-card studio-footer-card--action">
          <div class="studio-footer-card-head">
            <h3 class="studio-footer-card-heading">Prefer a call?</h3>
            <p class="studio-footer-card-subtext">No slides, no pitch. Just 30 minutes to talk through what you're building.</p>
          </div>
          <a href="https://cal.com/tatermohit/call-with-mohit-tater" class="studio-btn-primary studio-footer-card-cta">Book a call &rarr;</a>
        </div>

        <div class="studio-footer-card studio-footer-card--action">
          <div class="studio-footer-card-head">
            <h3 class="studio-footer-card-heading">Drop a line</h3>
            <p class="studio-footer-card-subtext">Quick question or an intro. Email works too.</p>
          </div>
          <a href="mailto:mohittater.iiita@gmail.com" class="studio-footer-card-cta studio-footer-email">mohittater.iiita@gmail.com &rarr;</a>
        </div>

        <div class="studio-footer-card studio-footer-card--action">
          <div class="studio-footer-card-head">
            <h3 class="studio-footer-card-heading">Let's connect</h3>
            <p class="studio-footer-card-subtext">Say hi, follow along, or read what I'm thinking about.</p>
          </div>
          <div class="studio-footer-socials">
            <a href="https://twitter.com/tatermohit" target="_blank" rel="noopener noreferrer">Twitter</a>
            <span class="studio-footer-socials-sep">/</span>
            <a href="https://www.linkedin.com/in/tatermohit/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <span class="studio-footer-socials-sep">/</span>
            <a href="https://github.com/mnttnm" target="_blank" rel="noopener noreferrer">GitHub</a>
            <span class="studio-footer-socials-sep">/</span>
            <a href="https://mohit.stream" target="_blank" rel="noopener noreferrer">Blog</a>
          </div>
        </div>

      </div>

    </div>

    <p class="studio-footer-copyright">&copy; 2026 Mohit Tater &middot; Bengaluru, India</p>
  </div>
</footer>

<style>
  /* ----- Shared primitives (scoped copies for StudioFooter) ----- */
  .studio-footer-unified .studio-container {
    max-width: var(--site-container-max);
    margin: 0 auto;
    padding: 0 var(--site-container-padding);
  }

  .studio-footer-unified .studio-reveal {
    opacity: 0;
    transform: translateY(16px);
    animation: studioFooterReveal 0.7s cubic-bezier(0.23, 1, 0.32, 1) forwards;
  }

  @keyframes studioFooterReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .studio-footer-unified .studio-btn-primary {
    display: inline-block;
    padding: 14px 32px;
    background: var(--studio-accent);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 6px;
    transition: background 0.25s, transform 0.2s;
  }

  .studio-footer-unified .studio-btn-primary:hover {
    background: #234a31;
    transform: translateY(-1px);
  }

  /* ----- Footer shell ----- */
  .studio-footer-unified {
    padding: 100px 0 48px;
    border-top: 1px solid var(--studio-border);
    scroll-margin-top: 80px;
  }

  .studio-footer-label {
    font-family: var(--studio-serif);
    font-size: clamp(1.8rem, 3.8vw, 2.6rem);
    color: var(--studio-text);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 16px;
  }

  .studio-footer-subtitle {
    font-size: 1rem;
    color: var(--studio-text-body);
    line-height: 1.7;
    max-width: 560px;
    margin-bottom: 48px;
  }

  .studio-footer-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: stretch;
  }

  .studio-footer-card {
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid var(--studio-border);
    border-radius: 12px;
    padding: 32px;
    display: flex;
    flex-direction: column;
  }

  .studio-footer-card-heading {
    font-family: var(--studio-serif);
    font-size: 1.25rem;
    color: var(--studio-text);
    margin: 0 0 8px;
    letter-spacing: -0.01em;
  }

  .studio-footer-card-subtext {
    font-size: 0.9rem;
    color: var(--studio-text-body);
    line-height: 1.6;
    margin: 0 0 20px;
  }

  /* ----- Left: form card ----- */
  .studio-footer-card--form {
    height: 100%;
  }

  .studio-contact-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex: 1;
  }

  .studio-form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .studio-form-group--grow {
    flex: 1;
    min-height: 120px;
  }

  .studio-form-group--grow textarea {
    flex: 1;
    min-height: 120px;
    resize: vertical;
  }

  .studio-form-group label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--studio-text);
    letter-spacing: 0.02em;
  }

  .studio-form-group input,
  .studio-form-group textarea {
    padding: 11px 13px;
    border: 1px solid var(--studio-border);
    border-radius: 6px;
    background: var(--studio-bg);
    color: var(--studio-text);
    font-family: var(--studio-sans);
    font-size: 0.92rem;
    transition: border-color 0.2s;
  }

  .studio-form-group input:focus,
  .studio-form-group textarea:focus {
    outline: none;
    border-color: var(--studio-accent);
  }

  .studio-form-group input::placeholder,
  .studio-form-group textarea::placeholder {
    color: var(--studio-text-muted);
  }

  .studio-form-submit {
    align-self: flex-start;
    border: none;
    cursor: pointer;
    font-family: var(--studio-sans);
  }

  .studio-honeypot {
    display: none;
    visibility: hidden;
    position: absolute;
    left: -9999px;
  }

  .studio-form-success {
    display: none;
    padding: 14px 16px;
    background: var(--studio-accent);
    color: #fff;
    border-radius: 6px;
    margin-bottom: 4px;
  }

  .studio-form-success.show {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .studio-form-success p {
    margin: 0;
    font-size: 0.88rem;
  }

  .studio-form-success-close {
    background: none;
    border: none;
    color: #fff;
    font-size: 1.4rem;
    cursor: pointer;
    padding: 0;
    line-height: 1;
  }

  .studio-form-success-close:hover {
    opacity: 0.7;
  }

  .studio-form-error {
    color: #c0392b;
    font-size: 0.85rem;
    display: none;
  }

  .studio-form-error.show {
    display: block;
  }

  /* ----- Right: three stretch boxes ----- */
  .studio-footer-actions {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .studio-footer-card--action {
    flex: 1;
    padding: 24px 28px;
    gap: 16px;
    justify-content: space-between;
    background: var(--studio-accent-light);
  }

  .studio-footer-card-head {
    display: flex;
    flex-direction: column;
  }

  .studio-footer-card--action .studio-footer-card-subtext {
    margin-bottom: 0;
  }

  .studio-footer-card-cta {
    align-self: flex-start;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
  }

  .studio-footer-card--action .studio-btn-primary {
    padding: 11px 22px;
    font-size: 0.85rem;
  }

  .studio-footer-email {
    color: var(--studio-accent);
    transition: opacity 0.2s;
    word-break: break-all;
  }

  .studio-footer-email:hover {
    opacity: 0.75;
  }

  .studio-footer-socials {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .studio-footer-socials a {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--studio-accent);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .studio-footer-socials a:hover {
    opacity: 0.7;
  }

  .studio-footer-socials-sep {
    color: var(--studio-text-muted);
    font-size: 0.85rem;
  }

  /* ----- Copyright ----- */
  .studio-footer-copyright {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--studio-border);
    text-align: center;
    font-size: 0.8rem;
    color: var(--studio-text-muted);
    letter-spacing: 0.02em;
  }

  /* ----- Responsive ----- */
  @media (max-width: 820px) {
    .studio-footer-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  @media (max-width: 480px) {
    .studio-footer-unified .studio-container {
      padding: 0 var(--site-container-padding-mobile);
    }

    .studio-footer-unified {
      padding: 72px 0 32px;
    }

    .studio-footer-card {
      padding: 24px;
    }

    .studio-footer-card--action {
      padding: 20px 24px;
    }
  }
</style>

<script>
  import { actions, isInputError } from 'astro:actions';

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('studio-contact-form') as HTMLFormElement | null;
    if (!form) return;

    const formError = document.getElementById('studio-form-error');
    const formSuccess = document.getElementById('studio-form-success');
    const successClose = document.querySelector('.studio-form-success-close');

    const setError = (msg: string) => {
      if (!formError) return;
      formError.textContent = msg;
      formError.classList.add('show');
    };
    const clearError = () => {
      if (!formError) return;
      formError.textContent = '';
      formError.classList.remove('show');
    };
    const showSuccess = () => formSuccess?.classList.add('show');
    const hideSuccess = () => formSuccess?.classList.remove('show');

    successClose?.addEventListener('click', hideSuccess);

    // Analytics: contact_form_started — first interaction with any field.
    const track = (event: string, props: Record<string, unknown> = {}) =>
      (window as any).posthog?.capture?.(event, { page: location.pathname, ...props });
    let formStarted = false;
    form.addEventListener('focusin', () => {
      if (formStarted) return;
      formStarted = true;
      track('contact_form_started');
    });

    form.addEventListener('submit', async (e: Event) => {
      e.preventDefault();
      clearError();
      hideSuccess();

      const submitBtn = form.querySelector('.studio-form-submit') as HTMLButtonElement;
      const originalText = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.innerHTML = 'Sending\u2026';

      const { error } = await actions.contact(new FormData(form));

      if (!error) {
        track('contact_form_submitted', { success: true });
        showSuccess();
        form.reset();
        formStarted = false;
      } else if (isInputError(error)) {
        track('contact_form_submitted', { success: false, reason: 'validation' });
        const firstField = Object.keys(error.fields)[0];
        setError(error.fields[firstField]?.[0] ?? 'Please check the form and try again.');
      } else {
        track('contact_form_submitted', { success: false, reason: 'server' });
        setError(error.message || 'Something went wrong. Please email me directly.');
      }

      submitBtn.disabled = false;
      submitBtn.innerHTML = originalText;
    });
  });
</script>
